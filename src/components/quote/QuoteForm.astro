---
import Card from '../ui/Card.astro'
import Button from '../ui/Button.astro'
import { services } from '../../data/services'
import { site } from '../../data/site'

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY?.trim()
const hasTurnstile = Boolean(turnstileSiteKey)
const quoteEmailSubject = 'Quote request for driveway or concrete cleaning'
const quoteEmailBody = [
  'Name:',
  'City:',
  'Service needed:',
  'Surface or area to clean:',
  'HOA notice or curb appeal goal (if relevant):',
].join('\n')
const quoteEmailHref = `mailto:${site.email}?subject=${encodeURIComponent(quoteEmailSubject)}&body=${encodeURIComponent(quoteEmailBody)}`
const turnstileClientScript = String.raw`
const form = document.querySelector('[data-quote-form]');

if (form instanceof HTMLFormElement) {
  const statusElement = form.querySelector('[data-form-status]');
  const submitButton = form.querySelector('[data-submit-button]');
  const turnstileContainer = form.querySelector('[data-turnstile-container]');
  const turnstileError = form.querySelector('[data-turnstile-error]');
  const fallbackCard = document.querySelector('[data-delivery-fallback]');
  const turnstileTokenInput = form.querySelector('#quote-turnstile-token');
  const apiScript = document.querySelector('#quote-turnstile-api');
  const siteEmail = form.dataset.siteEmail || 'hello@cflwash.com';
  const turnstileSiteKey = form.dataset.turnstileSiteKey || '';
  const serviceSelect = form.elements.namedItem('service');
  const allowedServiceSlugs = new Set(
    serviceSelect instanceof HTMLSelectElement
      ? Array.from(serviceSelect.options)
          .map((option) => option.value)
          .filter(Boolean)
      : []
  );
  const fieldNames = ['name', 'email', 'phone', 'city', 'service', 'details', 'consent'];
  const initialButtonText =
    submitButton instanceof HTMLElement
      ? submitButton.textContent || 'Request a quote'
      : 'Request a quote';
  const state = {
    pending: false,
    widgetId: null,
    successHandled: false,
    turnstileToken: '',
    formAvailable: true,
  };

  const fieldMap = Object.fromEntries(
    fieldNames.map((fieldName) => [fieldName, form.elements.namedItem(fieldName)])
  );

  const getErrorElement = (fieldName) => form.querySelector('#quote-' + fieldName + '-error');

  const focusStatus = () => {
    if (statusElement instanceof HTMLElement) {
      statusElement.focus();
    }
  };

  const showStatus = (message, tone = 'error') => {
    if (!(statusElement instanceof HTMLElement)) {
      return;
    }

    const toneClasses = {
      error: 'status-message--error',
      success: 'status-message--success',
      info: 'status-message--info',
    };

    statusElement.hidden = false;
    statusElement.className = [
      'status-message',
      toneClasses[tone] || toneClasses.info,
    ].join(' ');
    statusElement.textContent = message;
  };

  const hideStatus = () => {
    if (statusElement instanceof HTMLElement) {
      statusElement.hidden = true;
      statusElement.textContent = '';
    }
  };

  const setFieldInvalid = (field, fieldName, message) => {
    if (!(field instanceof HTMLElement)) {
      return;
    }

    const errorElement = getErrorElement(fieldName);

    field.setAttribute('aria-invalid', 'true');

    if (errorElement instanceof HTMLElement) {
      errorElement.hidden = false;
      errorElement.textContent = 'Error: ' + message;
    }

    if (
      field instanceof HTMLInputElement ||
      field instanceof HTMLTextAreaElement ||
      field instanceof HTMLSelectElement
    ) {
      field.classList.add('quote-field-invalid');
    }
  };

  const clearFieldInvalid = (fieldName) => {
    const field = fieldMap[fieldName];

    if (
      !(
        field instanceof HTMLInputElement ||
        field instanceof HTMLTextAreaElement ||
        field instanceof HTMLSelectElement
      )
    ) {
      return;
    }

    field.removeAttribute('aria-invalid');
    field.classList.remove('quote-field-invalid');

    const errorElement = getErrorElement(fieldName);

    if (errorElement instanceof HTMLElement) {
      errorElement.hidden = true;
      errorElement.textContent = '';
    }
  };

  const clearAllFieldErrors = () => {
    fieldNames.forEach((fieldName) => clearFieldInvalid(fieldName));
  };

  const getClientMessage = (fieldName, field) => {
    if (
      !(
        field instanceof HTMLInputElement ||
        field instanceof HTMLTextAreaElement ||
        field instanceof HTMLSelectElement
      )
    ) {
      return 'Please review this field.';
    }

    if (field.validity.valueMissing) {
      switch (fieldName) {
        case 'name':
          return 'Enter the name to use for quote follow-up.';
        case 'email':
          return 'Enter the email address for quote follow-up.';
        case 'city':
          return 'Enter the city where the cleaning is needed.';
        case 'service':
          return 'Select the service that best matches your project.';
        case 'details':
          return 'Share the surfaces, access notes, and project details.';
        case 'consent':
          return 'Confirm that CFL Wash Co. may use these details to reply.';
        default:
          return 'This field is required.';
      }
    }

    if (field.validity.typeMismatch && fieldName === 'email') {
      return 'Enter a valid email address.';
    }

    if (field.validity.tooShort) {
      if (fieldName === 'name') {
        return 'Enter at least 2 characters for the contact name.';
      }

      if (fieldName === 'city') {
        return 'Enter at least 2 characters for the city.';
      }

      if (fieldName === 'details') {
        return 'Enter at least 10 characters about the project.';
      }
    }

    if (field.validity.tooLong) {
      if (fieldName === 'name') {
        return 'Keep the name to 100 characters or fewer.';
      }

      if (fieldName === 'email') {
        return 'Keep the email address to 254 characters or fewer.';
      }

      if (fieldName === 'phone') {
        return 'Keep the phone number to 30 characters or fewer.';
      }

      if (fieldName === 'city') {
        return 'Keep the city to 100 characters or fewer.';
      }

      if (fieldName === 'details') {
        return 'Keep the project details to 2000 characters or fewer.';
      }
    }

    return 'Please review this field.';
  };

  const showInvalidFields = () => {
    let firstInvalidField = null;

    fieldNames.forEach((fieldName) => {
      const field = fieldMap[fieldName];

      if (
        field instanceof HTMLInputElement ||
        field instanceof HTMLTextAreaElement ||
        field instanceof HTMLSelectElement
      ) {
        if (!field.checkValidity()) {
          setFieldInvalid(field, fieldName, getClientMessage(fieldName, field));

          if (!firstInvalidField) {
            firstInvalidField = field;
          }
        }
      }
    });

    if (firstInvalidField instanceof HTMLElement) {
      firstInvalidField.focus();
    } else {
      focusStatus();
    }
  };

  const setTurnstileMessage = (message) => {
    if (turnstileError instanceof HTMLElement) {
      turnstileError.hidden = false;
      turnstileError.textContent = 'Error: ' + message;
    }
  };

  const clearTurnstileMessage = () => {
    if (turnstileError instanceof HTMLElement) {
      turnstileError.hidden = true;
      turnstileError.textContent = '';
    }
  };

  const clearTurnstileToken = () => {
    state.turnstileToken = '';

    if (turnstileTokenInput instanceof HTMLInputElement) {
      turnstileTokenInput.value = '';
    }
  };

  const resetTurnstile = () => {
    clearTurnstileToken();

    if (typeof window.turnstile !== 'undefined' && state.widgetId !== null) {
      window.turnstile.reset(state.widgetId);
    }
  };

  const showFallbackDeliveryNotice = () => {
    if (fallbackCard instanceof HTMLElement) {
      fallbackCard.hidden = false;
      fallbackCard.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    }
  };

  const hideFallbackDeliveryNotice = () => {
    if (fallbackCard instanceof HTMLElement) {
      fallbackCard.hidden = true;
    }
  };

  const setPending = (pending) => {
    state.pending = pending;

    if (submitButton instanceof HTMLButtonElement) {
      submitButton.disabled = pending;
      submitButton.textContent = pending ? 'Sending request...' : initialButtonText;
    }
  };

  const parseResponseJson = async (response) => {
    try {
      return await response.json();
    } catch {
      return null;
    }
  };

  const handleSuccessRedirect = (serviceSlug) => {
    if (state.successHandled) {
      return;
    }

    state.successHandled = true;

    const redirect = () => {
      if (state.formAvailable) {
        state.formAvailable = false;
        window.location.assign('/thank-you');
      }
    };

    if (typeof window.gtag !== 'function') {
      redirect();
      return;
    }

    let completed = false;
    const finish = () => {
      if (completed) {
        return;
      }

      completed = true;
      redirect();
    };

    window.gtag('event', 'quote_submit', {
      page_path: window.location.pathname,
      service_slug: serviceSlug,
      event_callback: finish,
    });

    window.setTimeout(finish, 500);
  };

  const applyServerFieldErrors = (fieldErrors) => {
    let firstErroredField = null;

    Object.entries(fieldErrors || {}).forEach(([fieldName, message]) => {
      const field = fieldMap[fieldName];

      if (
        typeof message === 'string' &&
        (
          field instanceof HTMLInputElement ||
          field instanceof HTMLTextAreaElement ||
          field instanceof HTMLSelectElement
        )
      ) {
        setFieldInvalid(field, fieldName, message);

        if (!firstErroredField) {
          firstErroredField = field;
        }
      }
    });

    if (firstErroredField instanceof HTMLElement) {
      firstErroredField.focus();
    } else {
      focusStatus();
    }
  };

  const initializeTurnstile = () => {
    if (
      typeof window.turnstile === 'undefined' ||
      state.widgetId !== null ||
      !(turnstileContainer instanceof HTMLElement)
    ) {
      return;
    }

    try {
      state.widgetId = window.turnstile.render(turnstileContainer, {
        sitekey: turnstileSiteKey,
        action: 'quote_submit',
        callback(token) {
          clearTurnstileMessage();
          clearTurnstileToken();

          if (turnstileTokenInput instanceof HTMLInputElement) {
            turnstileTokenInput.value = token;
          }

          state.turnstileToken = token;
        },
        'expired-callback'() {
          clearTurnstileToken();
          setTurnstileMessage('Verification expired. Please complete the security check again.');
        },
        'timeout-callback'() {
          clearTurnstileToken();
          setTurnstileMessage('Verification timed out. Please complete the security check again.');
        },
        'error-callback'() {
          clearTurnstileToken();
          setTurnstileMessage('We could not verify the security check. Please try again.');
        },
      });
    } catch {
      setTurnstileMessage('The security check could not be loaded. Please refresh the page or use email instead.');
    }
  };

  let turnstileLoadChecks = 0;
  const waitForTurnstile = () => {
    if (typeof window.turnstile !== 'undefined') {
      initializeTurnstile();
      return;
    }

    turnstileLoadChecks += 1;

    if (turnstileLoadChecks > 100) {
      setTurnstileMessage('The security check could not be loaded. Please refresh the page or use email instead.');
      return;
    }

    window.setTimeout(waitForTurnstile, 100);
  };

  if (apiScript instanceof HTMLScriptElement) {
    apiScript.addEventListener('error', () => {
      setTurnstileMessage('The security check could not be loaded. Please refresh the page or use email instead.');
    });
  }

  waitForTurnstile();

  fieldNames.forEach((fieldName) => {
    const field = fieldMap[fieldName];

    if (
      field instanceof HTMLInputElement ||
      field instanceof HTMLTextAreaElement ||
      field instanceof HTMLSelectElement
    ) {
      const clearError = () => {
        clearFieldInvalid(fieldName);
        hideStatus();
      };

      field.addEventListener('input', clearError);
      field.addEventListener('change', clearError);
    }
  });

  form.addEventListener(
    'invalid',
    (event) => {
      event.preventDefault();
    },
    true
  );

  form.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (state.pending || state.successHandled) {
      return;
    }

    hideStatus();
    hideFallbackDeliveryNotice();
    clearAllFieldErrors();
    clearTurnstileMessage();

    if (!form.checkValidity()) {
      showStatus('Please review the highlighted fields before sending your request.');
      showInvalidFields();
      return;
    }

    if (!state.turnstileToken) {
      showStatus('Complete the security check before sending your request.');
      setTurnstileMessage('Complete the security check before sending your request.');

      if (turnstileContainer instanceof HTMLElement) {
        turnstileContainer.scrollIntoView({ block: 'center', behavior: 'smooth' });
      }

      focusStatus();
      return;
    }

    const payload = {
      name: fieldMap.name instanceof HTMLInputElement ? fieldMap.name.value : '',
      email: fieldMap.email instanceof HTMLInputElement ? fieldMap.email.value : '',
      phone: fieldMap.phone instanceof HTMLInputElement ? fieldMap.phone.value : '',
      city: fieldMap.city instanceof HTMLInputElement ? fieldMap.city.value : '',
      service: fieldMap.service instanceof HTMLSelectElement ? fieldMap.service.value : '',
      details:
        fieldMap.details instanceof HTMLTextAreaElement ? fieldMap.details.value : '',
      consent:
        fieldMap.consent instanceof HTMLInputElement ? fieldMap.consent.checked : false,
      website:
        form.elements.namedItem('website') instanceof HTMLInputElement
          ? form.elements.namedItem('website').value
          : '',
      turnstileToken: state.turnstileToken,
    };

    if (!allowedServiceSlugs.has(payload.service)) {
      showStatus('Please select a valid service and try again.');
      setFieldInvalid(
        fieldMap.service,
        'service',
        'Select the service that best matches your project.'
      );

      if (fieldMap.service instanceof HTMLElement) {
        fieldMap.service.focus();
      }

      return;
    }

    setPending(true);
    showStatus('Sending your quote request...', 'info');

    try {
      const response = await fetch('/api/quote', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(payload),
      });

      const responseJson = await parseResponseJson(response);

      if (response.ok && responseJson?.ok === true) {
        showStatus('Thanks, your quote request is in. Redirecting to next steps...', 'success');
        handleSuccessRedirect(payload.service);
        return;
      }

      resetTurnstile();

      if (response.status === 400 && responseJson?.code === 'validation_error') {
        showStatus('A few details still need attention before the request can be sent.');
        applyServerFieldErrors(responseJson.fieldErrors);
        return;
      }

      if (response.status === 400 && responseJson?.code === 'verification_failed') {
        showStatus('The security check needs to be completed again before the request can be sent.');
        setTurnstileMessage('Verification failed. Please complete the security check again.');
        focusStatus();
        return;
      }

      if (response.status === 503 && responseJson?.code === 'delivery_unavailable') {
        showStatus(
          'The online form is not reaching CFL Wash Co. right now. Please use email instead at ' +
            siteEmail +
            '.'
        );
        showFallbackDeliveryNotice();
        focusStatus();
        return;
      }

      if (responseJson?.code === 'invalid_request') {
        showStatus('Please review the form details and try again, or use email if that is easier.');
        focusStatus();
        return;
      }

      showStatus(
        'The online form could not be sent right now. Please try again, or email ' +
          siteEmail +
          ' instead.'
      );
      showFallbackDeliveryNotice();
      focusStatus();
    } catch {
      resetTurnstile();
      showStatus(
        'The online form could not be sent right now. Please try again, or email ' +
          siteEmail +
          ' instead.'
      );
      showFallbackDeliveryNotice();
      focusStatus();
    } finally {
      if (!state.successHandled) {
        setPending(false);
      }
    }
  });
}
`
---

<div
  id="quote-form"
  class="grid gap-6 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)]"
>
  <Card tone="raised" padding="lg">
    {
      hasTurnstile ? (
        <>
          <div class="max-w-2xl">
            <h2 class="text-2xl font-semibold text-[var(--color-text)]">
              Quote request form
            </h2>
            <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)] sm:text-base">
              Share the contact details and concrete-surface context CFL Wash
              Co. needs to review the request before following up. Fields marked
              Required must be completed.
            </p>
          </div>

          <div class="mt-6 grid gap-3 sm:grid-cols-3">
            <div class="form-panel">
              <p class="text-sm font-semibold text-[var(--color-text)]">
                Contact details
              </p>
              <p class="mt-2 text-sm leading-6 text-[var(--color-text-muted)]">
                Use the best email for follow-up and add a phone number only if
                you want it used.
              </p>
            </div>
            <div class="form-panel">
              <p class="text-sm font-semibold text-[var(--color-text)]">
                Property context
              </p>
              <p class="mt-2 text-sm leading-6 text-[var(--color-text-muted)]">
                Name the city, the main concrete surfaces, and anything that may
                change the scope.
              </p>
            </div>
            <div class="form-panel">
              <p class="text-sm font-semibold text-[var(--color-text)]">
                Photo follow-up
              </p>
              <p class="mt-2 text-sm leading-6 text-[var(--color-text-muted)]">
                If photos will help, mention that in the request or send them by
                email after you submit.
              </p>
            </div>
          </div>

          <form
            data-quote-form
            data-site-email={site.email}
            data-turnstile-site-key={turnstileSiteKey}
            class="mt-8 space-y-5"
            novalidate
          >
            <div
              data-form-status
              tabindex="-1"
              aria-live="polite"
              aria-atomic="true"
              class="status-message hidden"
            />

            <div class="space-y-5">
              <div class="form-panel">
                <div class="max-w-2xl">
                  <h3 class="text-base font-semibold text-[var(--color-text)]">
                    1. Contact details
                  </h3>
                  <p class="mt-2 text-sm leading-6 text-[var(--color-text-muted)]">
                    Start with the person and inbox CFL Wash Co. should use for
                    the quote follow-up.
                  </p>
                </div>

                <div class="mt-5 grid gap-5 sm:grid-cols-2">
                  <div class="sm:col-span-2">
                    <label for="quote-name" class="form-label">
                      Name
                      <span class="form-label-meta">Required</span>
                    </label>
                    <p id="quote-name-hint" class="form-hint">
                      Use the best name for quote follow-up.
                    </p>
                    <input
                      id="quote-name"
                      name="name"
                      type="text"
                      required
                      autocomplete="name"
                      minlength="2"
                      maxlength="100"
                      aria-describedby="quote-name-hint quote-name-error"
                      class="form-control"
                    />
                    <p
                      id="quote-name-error"
                      data-field-error
                      class="form-error"
                      hidden
                    />
                  </div>

                  <div>
                    <label for="quote-email" class="form-label">
                      Email
                      <span class="form-label-meta">Required</span>
                    </label>
                    <p id="quote-email-hint" class="form-hint">
                      CFL Wash Co. uses this email to reply about your request.
                    </p>
                    <input
                      id="quote-email"
                      name="email"
                      type="email"
                      required
                      autocomplete="email"
                      maxlength="254"
                      aria-describedby="quote-email-hint quote-email-error"
                      class="form-control"
                    />
                    <p
                      id="quote-email-error"
                      data-field-error
                      class="form-error"
                      hidden
                    />
                  </div>

                  <div>
                    <label for="quote-phone" class="form-label">
                      Phone
                      <span class="form-label-meta">Optional</span>
                    </label>
                    <p id="quote-phone-hint" class="form-hint">
                      Add a phone number only if you want it used for follow-up.
                    </p>
                    <input
                      id="quote-phone"
                      name="phone"
                      type="tel"
                      autocomplete="tel"
                      maxlength="30"
                      aria-describedby="quote-phone-hint quote-phone-error"
                      class="form-control"
                    />
                    <p
                      id="quote-phone-error"
                      data-field-error
                      class="form-error"
                      hidden
                    />
                  </div>
                </div>
              </div>

              <div class="form-panel">
                <div class="max-w-2xl">
                  <h3 class="text-base font-semibold text-[var(--color-text)]">
                    2. Property and surface details
                  </h3>
                  <p class="mt-2 text-sm leading-6 text-[var(--color-text-muted)]">
                    Name the location, the concrete surfaces involved, and
                    anything that affects the review.
                  </p>
                </div>

                <div class="mt-5 grid gap-5 sm:grid-cols-2">
                  <div>
                    <label for="quote-city" class="form-label">
                      City
                      <span class="form-label-meta">Required</span>
                    </label>
                    <p id="quote-city-hint" class="form-hint">
                      Tell us the city where the cleaning is needed. If the full
                      address helps, add it in the project details field.
                    </p>
                    <input
                      id="quote-city"
                      name="city"
                      type="text"
                      required
                      autocomplete="address-level2"
                      minlength="2"
                      maxlength="100"
                      aria-describedby="quote-city-hint quote-city-error"
                      class="form-control"
                    />
                    <p
                      id="quote-city-error"
                      data-field-error
                      class="form-error"
                      hidden
                    />
                  </div>

                  <div>
                    <label for="quote-service" class="form-label">
                      Service
                      <span class="form-label-meta">Required</span>
                    </label>
                    <p id="quote-service-hint" class="form-hint">
                      Choose the closest match for the main surface you want
                      cleaned.
                    </p>
                    <select
                      id="quote-service"
                      name="service"
                      required
                      aria-describedby="quote-service-hint quote-service-error"
                      class="form-control"
                    >
                      <option value="">Select a service</option>
                      {services.map((service) => (
                        <option value={service.slug}>{service.name}</option>
                      ))}
                    </select>
                    <p
                      id="quote-service-error"
                      data-field-error
                      class="form-error"
                      hidden
                    />
                  </div>

                  <div class="sm:col-span-2">
                    <label for="quote-details" class="form-label">
                      Project details
                      <span class="form-label-meta">Required</span>
                    </label>
                    <p id="quote-details-hint" class="form-hint">
                      Include the concrete surfaces, access notes, HOA wording,
                      and any priority stains or concerns. If photos will help,
                      mention that here or send them by email after you submit.
                      Do not include payment or other sensitive information.
                    </p>
                    <textarea
                      id="quote-details"
                      name="details"
                      required
                      minlength="10"
                      maxlength="2000"
                      rows="7"
                      aria-describedby="quote-details-hint quote-details-error"
                      class="form-control"
                    />
                    <p
                      id="quote-details-error"
                      data-field-error
                      class="form-error"
                      hidden
                    />
                  </div>
                </div>
              </div>
            </div>

            <div class="hidden" aria-hidden="true">
              <label for="quote-website">Website</label>
              <input
                id="quote-website"
                name="website"
                type="text"
                tabindex="-1"
                autocomplete="off"
              />
            </div>

            <input
              type="hidden"
              id="quote-turnstile-token"
              name="turnstileToken"
              value=""
            />

            <div class="form-panel">
              <p class="text-sm font-semibold text-[var(--color-text)]">
                Verification
                <span class="form-label-meta">Required</span>
              </p>
              <p
                id="quote-turnstile-hint"
                class="mt-2 text-sm leading-6 text-[var(--color-text-muted)]"
              >
                Complete the security check before sending the request.
              </p>
              <div
                data-turnstile-container
                class="mt-4 min-h-[72px] rounded-[var(--radius-md)]"
              />
              <p
                id="quote-turnstile-error"
                data-turnstile-error
                class="form-error"
                hidden
              />
            </div>

            <div class="form-panel">
              <div class="flex items-start gap-3">
                <input
                  id="quote-consent"
                  name="consent"
                  type="checkbox"
                  value="true"
                  required
                  aria-describedby="quote-consent-hint quote-consent-error"
                  class="mt-1 h-4 w-4 rounded border-[var(--color-border)] text-[var(--color-action)] focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring)] focus-visible:ring-offset-2"
                />
                <div>
                  <label
                    for="quote-consent"
                    class="text-sm font-semibold text-[var(--color-text)]"
                  >
                    I agree that CFL Wash Co. may use these details to respond
                    to this quote request.
                    <span class="form-label-meta">Required</span>
                  </label>
                  <p
                    id="quote-consent-hint"
                    class="mt-2 text-sm leading-6 text-[var(--color-text-muted)]"
                  >
                    Review the{' '}
                    <a href="/privacy" class="text-link min-h-0">
                      Privacy Notice
                    </a>
                    .
                  </p>
                </div>
              </div>
              <p
                id="quote-consent-error"
                data-field-error
                class="form-error"
                hidden
              />
            </div>

            <div
              class="flex flex-col gap-3 border-t border-[var(--color-border)] pt-5 sm:flex-row sm:items-center sm:justify-between"
              data-sticky-cta-stop
            >
              <p class="text-sm leading-6 text-[var(--color-text-muted)]">
                CFL Wash Co. reviews each request before follow-up. Sending this
                form does not book service or confirm pricing on its own.
              </p>
              <Button
                type="submit"
                data-submit-button
                class="disabled:cursor-not-allowed disabled:opacity-60"
              >
                Request a quote
              </Button>
            </div>
          </form>
        </>
      ) : (
        <>
          <h2 class="text-2xl font-semibold text-[var(--color-text)]">
            Request a quote by email
          </h2>
          <p class="mt-3 max-w-2xl text-sm leading-7 text-[var(--color-text-muted)] sm:text-base">
            The online form is not available right now, but quote requests can
            still be sent by email. Include the city, surfaces, access notes,
            HOA wording, and any priority concerns.
          </p>
          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <Button
              href={quoteEmailHref}
              data-cta="email"
              data-cta-location="request-quote-form-unavailable"
            >
              Email CFL Wash Co.
            </Button>
            <Button href="/privacy" variant="secondary">
              Privacy Notice
            </Button>
          </div>
        </>
      )
    }
  </Card>

  <Card tone="soft" id="quote-fallback" padding="lg">
    <h2 class="text-xl font-semibold text-[var(--color-text)]">
      What to send and what happens next
    </h2>
    <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
      Use this page to send enough detail for a useful quote review without
      overcomplicating the request. A quote request starts the conversation; it
      does not confirm scheduling or pricing on its own.
    </p>

    <div
      data-delivery-fallback
      class="status-message status-message--error mt-5"
      hidden
    >
      Online form delivery is unavailable right now. Please use email so the
      project details still reach CFL Wash Co.
    </div>

    <div class="mt-6 space-y-5">
      <div class="form-panel">
        <h3 class="text-sm font-semibold text-[var(--color-text)]">
          Helpful details to include
        </h3>
        <ul class="mt-4 space-y-3 text-sm leading-6 text-[var(--color-text)]">
          <li class="flex gap-3">
            <span
              class="mt-2 h-2 w-2 shrink-0 rounded-full bg-[var(--color-action)]"
            ></span>
            <span
              >City and, if helpful, the service address in the details field</span
            >
          </li>
          <li class="flex gap-3">
            <span
              class="mt-2 h-2 w-2 shrink-0 rounded-full bg-[var(--color-action)]"
            ></span>
            <span
              >Driveway, sidewalk, walkway, patio, apron, curb, or other
              concrete surfaces</span
            >
          </li>
          <li class="flex gap-3">
            <span
              class="mt-2 h-2 w-2 shrink-0 rounded-full bg-[var(--color-action)]"
            ></span>
            <span
              >Access notes, gates, parked vehicles, and other site conditions</span
            >
          </li>
          <li class="flex gap-3">
            <span
              class="mt-2 h-2 w-2 shrink-0 rounded-full bg-[var(--color-action)]"
            ></span>
            <span
              >HOA notice wording, priority stains, or the parts of the surface
              that concern you most</span
            >
          </li>
          <li class="flex gap-3">
            <span
              class="mt-2 h-2 w-2 shrink-0 rounded-full bg-[var(--color-action)]"
            ></span>
            <span
              >If you have clear photos, mention them in the request or send
              them by email after submitting</span
            >
          </li>
        </ul>
      </div>

      <div class="form-panel">
        <h3 class="text-sm font-semibold text-[var(--color-text)]">
          What happens next
        </h3>
        <ol class="mt-4 space-y-4 text-sm leading-6 text-[var(--color-text)]">
          <li class="flex gap-3">
            <span
              class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-surface-raised)] text-xs font-semibold text-[var(--color-action)] ring-1 ring-[var(--color-border)]"
            >
              1
            </span>
            <span
              >CFL Wash Co. reviews the city, surfaces, and notes you send.</span
            >
          </li>
          <li class="flex gap-3">
            <span
              class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-surface-raised)] text-xs font-semibold text-[var(--color-action)] ring-1 ring-[var(--color-border)]"
            >
              2
            </span>
            <span
              >If anything is unclear, follow-up happens by email or phone using
              the contact details you provide.</span
            >
          </li>
          <li class="flex gap-3">
            <span
              class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-surface-raised)] text-xs font-semibold text-[var(--color-action)] ring-1 ring-[var(--color-border)]"
            >
              3
            </span>
            <span
              >Scheduling is discussed after the request is reviewed. Sending
              the request does not book a visit.</span
            >
          </li>
        </ol>
      </div>

      <div
        class="flex flex-col gap-3 border-t border-[var(--color-border)] pt-5 sm:flex-row sm:items-center sm:justify-between"
      >
        <div>
          <h3 class="text-sm font-semibold text-[var(--color-text)]">
            Prefer email?
          </h3>
          <p class="mt-2 text-sm leading-6 text-[var(--color-text-muted)]">
            Email is always available if you want to send the request or follow
            up with photos directly.
          </p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row">
          <Button
            href={quoteEmailHref}
            data-cta="email"
            data-cta-location="request-quote-fallback"
          >
            Start email
          </Button>
          <Button href="/privacy" variant="secondary"> Privacy Notice </Button>
        </div>
      </div>
    </div>
  </Card>
</div>

{
  hasTurnstile && (
    <>
      <script
        async
        defer
        id="quote-turnstile-api"
        src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
      />
      <script is:inline set:html={turnstileClientScript} />
    </>
  )
}
