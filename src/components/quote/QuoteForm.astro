---
import Card from '../ui/Card.astro'
import Button from '../ui/Button.astro'
import { services } from '../../data/services'
import { site } from '../../data/site'

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY?.trim()
const hasTurnstile = Boolean(turnstileSiteKey)
const quoteEmailSubject = 'Quote request for exterior cleaning'
const quoteEmailBody = [
  'Name:',
  'City:',
  'Service needed:',
  'Surface or area to clean:',
  'HOA notice or curb appeal goal (if relevant):',
].join('\n')
const quoteEmailHref = `mailto:${site.email}?subject=${encodeURIComponent(quoteEmailSubject)}&body=${encodeURIComponent(quoteEmailBody)}`
const turnstileClientScript = String.raw`
const form = document.querySelector('[data-quote-form]');

if (form instanceof HTMLFormElement) {
  const statusElement = form.querySelector('[data-form-status]');
  const submitButton = form.querySelector('[data-submit-button]');
  const turnstileContainer = form.querySelector('[data-turnstile-container]');
  const turnstileError = form.querySelector('[data-turnstile-error]');
  const fallbackCard = document.querySelector('[data-delivery-fallback]');
  const turnstileTokenInput = form.querySelector('#quote-turnstile-token');
  const apiScript = document.querySelector('#quote-turnstile-api');
  const siteEmail = form.dataset.siteEmail || 'hello@cflwash.com';
  const turnstileSiteKey = form.dataset.turnstileSiteKey || '';
  const serviceSelect = form.elements.namedItem('service');
  const allowedServiceSlugs = new Set(
    serviceSelect instanceof HTMLSelectElement
      ? Array.from(serviceSelect.options)
          .map((option) => option.value)
          .filter(Boolean)
      : []
  );
  const fieldNames = ['name', 'email', 'phone', 'city', 'service', 'details', 'consent'];
  const initialButtonText =
    submitButton instanceof HTMLElement
      ? submitButton.textContent || 'Request quote'
      : 'Request quote';
  const state = {
    pending: false,
    widgetId: null,
    successHandled: false,
    turnstileToken: '',
    formAvailable: true,
  };

  const fieldMap = Object.fromEntries(
    fieldNames.map((fieldName) => [fieldName, form.elements.namedItem(fieldName)])
  );

  const getErrorElement = (fieldName) => form.querySelector('#quote-' + fieldName + '-error');

  const focusStatus = () => {
    if (statusElement instanceof HTMLElement) {
      statusElement.focus();
    }
  };

  const showStatus = (message, tone = 'error') => {
    if (!(statusElement instanceof HTMLElement)) {
      return;
    }

    const toneClasses = {
      error: 'border-red-200 bg-red-50 text-red-800',
      success: 'border-green-200 bg-green-50 text-green-800',
      info: 'border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text)]',
    };

    statusElement.hidden = false;
    statusElement.className = [
      'rounded-[var(--radius-md)] border px-4 py-3 text-sm leading-6 outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring)] focus-visible:ring-offset-2',
      toneClasses[tone] || toneClasses.info,
    ].join(' ');
    statusElement.textContent = message;
  };

  const hideStatus = () => {
    if (statusElement instanceof HTMLElement) {
      statusElement.hidden = true;
      statusElement.textContent = '';
    }
  };

  const setFieldInvalid = (field, fieldName, message) => {
    if (!(field instanceof HTMLElement)) {
      return;
    }

    const errorElement = getErrorElement(fieldName);

    field.setAttribute('aria-invalid', 'true');

    if (errorElement instanceof HTMLElement) {
      errorElement.hidden = false;
      errorElement.textContent = 'Error: ' + message;
    }

    if (
      field instanceof HTMLInputElement ||
      field instanceof HTMLTextAreaElement ||
      field instanceof HTMLSelectElement
    ) {
      field.classList.add('border-red-700', 'ring-1', 'ring-red-200');
    }
  };

  const clearFieldInvalid = (fieldName) => {
    const field = fieldMap[fieldName];

    if (
      !(
        field instanceof HTMLInputElement ||
        field instanceof HTMLTextAreaElement ||
        field instanceof HTMLSelectElement
      )
    ) {
      return;
    }

    field.removeAttribute('aria-invalid');
    field.classList.remove('border-red-700', 'ring-1', 'ring-red-200');

    const errorElement = getErrorElement(fieldName);

    if (errorElement instanceof HTMLElement) {
      errorElement.hidden = true;
      errorElement.textContent = '';
    }
  };

  const clearAllFieldErrors = () => {
    fieldNames.forEach((fieldName) => clearFieldInvalid(fieldName));
  };

  const getClientMessage = (fieldName, field) => {
    if (
      !(
        field instanceof HTMLInputElement ||
        field instanceof HTMLTextAreaElement ||
        field instanceof HTMLSelectElement
      )
    ) {
      return 'Please review this field.';
    }

    if (field.validity.valueMissing) {
      switch (fieldName) {
        case 'name':
          return 'Enter your name.';
        case 'email':
          return 'Enter your email address.';
        case 'city':
          return 'Enter the city where the cleaning is needed.';
        case 'service':
          return 'Select the service that best matches your project.';
        case 'details':
          return 'Enter at least a few details about the project.';
        case 'consent':
          return 'You must agree before submitting the form.';
        default:
          return 'This field is required.';
      }
    }

    if (field.validity.typeMismatch && fieldName === 'email') {
      return 'Enter a valid email address.';
    }

    if (field.validity.tooShort) {
      if (fieldName === 'name') {
        return 'Enter at least 2 characters for your name.';
      }

      if (fieldName === 'city') {
        return 'Enter at least 2 characters for the city.';
      }

      if (fieldName === 'details') {
        return 'Enter at least 10 characters about the project.';
      }
    }

    if (field.validity.tooLong) {
      if (fieldName === 'name') {
        return 'Keep the name to 100 characters or fewer.';
      }

      if (fieldName === 'email') {
        return 'Keep the email address to 254 characters or fewer.';
      }

      if (fieldName === 'phone') {
        return 'Keep the phone number to 30 characters or fewer.';
      }

      if (fieldName === 'city') {
        return 'Keep the city to 100 characters or fewer.';
      }

      if (fieldName === 'details') {
        return 'Keep the project details to 2000 characters or fewer.';
      }
    }

    return 'Please review this field.';
  };

  const showInvalidFields = () => {
    let firstInvalidField = null;

    fieldNames.forEach((fieldName) => {
      const field = fieldMap[fieldName];

      if (
        field instanceof HTMLInputElement ||
        field instanceof HTMLTextAreaElement ||
        field instanceof HTMLSelectElement
      ) {
        if (!field.checkValidity()) {
          setFieldInvalid(field, fieldName, getClientMessage(fieldName, field));

          if (!firstInvalidField) {
            firstInvalidField = field;
          }
        }
      }
    });

    if (firstInvalidField instanceof HTMLElement) {
      firstInvalidField.focus();
    } else {
      focusStatus();
    }
  };

  const setTurnstileMessage = (message) => {
    if (turnstileError instanceof HTMLElement) {
      turnstileError.hidden = false;
      turnstileError.textContent = 'Error: ' + message;
    }
  };

  const clearTurnstileMessage = () => {
    if (turnstileError instanceof HTMLElement) {
      turnstileError.hidden = true;
      turnstileError.textContent = '';
    }
  };

  const clearTurnstileToken = () => {
    state.turnstileToken = '';

    if (turnstileTokenInput instanceof HTMLInputElement) {
      turnstileTokenInput.value = '';
    }
  };

  const resetTurnstile = () => {
    clearTurnstileToken();

    if (typeof window.turnstile !== 'undefined' && state.widgetId !== null) {
      window.turnstile.reset(state.widgetId);
    }
  };

  const showFallbackDeliveryNotice = () => {
    if (fallbackCard instanceof HTMLElement) {
      fallbackCard.hidden = false;
      fallbackCard.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    }
  };

  const hideFallbackDeliveryNotice = () => {
    if (fallbackCard instanceof HTMLElement) {
      fallbackCard.hidden = true;
    }
  };

  const setPending = (pending) => {
    state.pending = pending;

    if (submitButton instanceof HTMLButtonElement) {
      submitButton.disabled = pending;
      submitButton.textContent = pending ? 'Sending request...' : initialButtonText;
    }
  };

  const parseResponseJson = async (response) => {
    try {
      return await response.json();
    } catch {
      return null;
    }
  };

  const handleSuccessRedirect = (serviceSlug) => {
    if (state.successHandled) {
      return;
    }

    state.successHandled = true;

    const redirect = () => {
      if (state.formAvailable) {
        state.formAvailable = false;
        window.location.assign('/thank-you');
      }
    };

    if (typeof window.gtag !== 'function') {
      redirect();
      return;
    }

    let completed = false;
    const finish = () => {
      if (completed) {
        return;
      }

      completed = true;
      redirect();
    };

    window.gtag('event', 'quote_submit', {
      page_path: window.location.pathname,
      service_slug: serviceSlug,
      event_callback: finish,
    });

    window.setTimeout(finish, 500);
  };

  const applyServerFieldErrors = (fieldErrors) => {
    let firstErroredField = null;

    Object.entries(fieldErrors || {}).forEach(([fieldName, message]) => {
      const field = fieldMap[fieldName];

      if (
        typeof message === 'string' &&
        (
          field instanceof HTMLInputElement ||
          field instanceof HTMLTextAreaElement ||
          field instanceof HTMLSelectElement
        )
      ) {
        setFieldInvalid(field, fieldName, message);

        if (!firstErroredField) {
          firstErroredField = field;
        }
      }
    });

    if (firstErroredField instanceof HTMLElement) {
      firstErroredField.focus();
    } else {
      focusStatus();
    }
  };

  const initializeTurnstile = () => {
    if (
      typeof window.turnstile === 'undefined' ||
      state.widgetId !== null ||
      !(turnstileContainer instanceof HTMLElement)
    ) {
      return;
    }

    try {
      state.widgetId = window.turnstile.render(turnstileContainer, {
        sitekey: turnstileSiteKey,
        action: 'quote_submit',
        callback(token) {
          clearTurnstileMessage();
          clearTurnstileToken();

          if (turnstileTokenInput instanceof HTMLInputElement) {
            turnstileTokenInput.value = token;
          }

          state.turnstileToken = token;
        },
        'expired-callback'() {
          clearTurnstileToken();
          setTurnstileMessage('Verification expired. Please complete the security check again.');
        },
        'timeout-callback'() {
          clearTurnstileToken();
          setTurnstileMessage('Verification timed out. Please complete the security check again.');
        },
        'error-callback'() {
          clearTurnstileToken();
          setTurnstileMessage('We could not verify the security check. Please try again.');
        },
      });
    } catch {
      setTurnstileMessage('The security check could not be loaded. Please refresh the page or use email instead.');
    }
  };

  let turnstileLoadChecks = 0;
  const waitForTurnstile = () => {
    if (typeof window.turnstile !== 'undefined') {
      initializeTurnstile();
      return;
    }

    turnstileLoadChecks += 1;

    if (turnstileLoadChecks > 100) {
      setTurnstileMessage('The security check could not be loaded. Please refresh the page or use email instead.');
      return;
    }

    window.setTimeout(waitForTurnstile, 100);
  };

  if (apiScript instanceof HTMLScriptElement) {
    apiScript.addEventListener('error', () => {
      setTurnstileMessage('The security check could not be loaded. Please refresh the page or use email instead.');
    });
  }

  waitForTurnstile();

  fieldNames.forEach((fieldName) => {
    const field = fieldMap[fieldName];

    if (
      field instanceof HTMLInputElement ||
      field instanceof HTMLTextAreaElement ||
      field instanceof HTMLSelectElement
    ) {
      const clearError = () => {
        clearFieldInvalid(fieldName);
        hideStatus();
      };

      field.addEventListener('input', clearError);
      field.addEventListener('change', clearError);
    }
  });

  form.addEventListener(
    'invalid',
    (event) => {
      event.preventDefault();
    },
    true
  );

  form.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (state.pending || state.successHandled) {
      return;
    }

    hideStatus();
    hideFallbackDeliveryNotice();
    clearAllFieldErrors();
    clearTurnstileMessage();

    if (!form.checkValidity()) {
      showStatus('Please review the highlighted fields and try again.');
      showInvalidFields();
      return;
    }

    if (!state.turnstileToken) {
      showStatus('Complete the security check before submitting the form.');
      setTurnstileMessage('Complete the security check before submitting the form.');

      if (turnstileContainer instanceof HTMLElement) {
        turnstileContainer.scrollIntoView({ block: 'center', behavior: 'smooth' });
      }

      focusStatus();
      return;
    }

    const payload = {
      name: fieldMap.name instanceof HTMLInputElement ? fieldMap.name.value : '',
      email: fieldMap.email instanceof HTMLInputElement ? fieldMap.email.value : '',
      phone: fieldMap.phone instanceof HTMLInputElement ? fieldMap.phone.value : '',
      city: fieldMap.city instanceof HTMLInputElement ? fieldMap.city.value : '',
      service: fieldMap.service instanceof HTMLSelectElement ? fieldMap.service.value : '',
      details:
        fieldMap.details instanceof HTMLTextAreaElement ? fieldMap.details.value : '',
      consent:
        fieldMap.consent instanceof HTMLInputElement ? fieldMap.consent.checked : false,
      website:
        form.elements.namedItem('website') instanceof HTMLInputElement
          ? form.elements.namedItem('website').value
          : '',
      turnstileToken: state.turnstileToken,
    };

    if (!allowedServiceSlugs.has(payload.service)) {
      showStatus('Please select a valid service and try again.');
      setFieldInvalid(
        fieldMap.service,
        'service',
        'Select the service that best matches your project.'
      );

      if (fieldMap.service instanceof HTMLElement) {
        fieldMap.service.focus();
      }

      return;
    }

    setPending(true);
    showStatus('Submitting your quote request...', 'info');

    try {
      const response = await fetch('/api/quote', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(payload),
      });

      const responseJson = await parseResponseJson(response);

      if (response.ok && responseJson?.ok === true) {
        showStatus('Quote request sent. Redirecting...', 'success');
        handleSuccessRedirect(payload.service);
        return;
      }

      resetTurnstile();

      if (response.status === 400 && responseJson?.code === 'validation_error') {
        showStatus('Please correct the highlighted fields and try again.');
        applyServerFieldErrors(responseJson.fieldErrors);
        return;
      }

      if (response.status === 400 && responseJson?.code === 'verification_failed') {
        showStatus('The security check needs to be completed again. Please try once more.');
        setTurnstileMessage('Verification failed. Please complete the security check again.');
        focusStatus();
        return;
      }

      if (response.status === 503 && responseJson?.code === 'delivery_unavailable') {
        showStatus(
          'The online form could not be delivered right now. Please use email instead at ' +
            siteEmail +
            '.'
        );
        showFallbackDeliveryNotice();
        focusStatus();
        return;
      }

      if (responseJson?.code === 'invalid_request') {
        showStatus('Please review the form details and try again, or use email instead.');
        focusStatus();
        return;
      }

      showStatus(
        'The online form could not be sent right now. Please try again or email ' +
          siteEmail +
          ' instead.'
      );
      showFallbackDeliveryNotice();
      focusStatus();
    } catch {
      resetTurnstile();
      showStatus(
        'The online form could not be sent right now. Please try again or email ' +
          siteEmail +
          ' instead.'
      );
      showFallbackDeliveryNotice();
      focusStatus();
    } finally {
      if (!state.successHandled) {
        setPending(false);
      }
    }
  });
}
`
---

<div class="grid gap-6 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)]">
  <Card class="bg-white">
    {
      hasTurnstile ? (
        <>
          <div class="max-w-2xl">
            <h2 class="text-2xl font-semibold text-[var(--color-text)]">
              Quote request form
            </h2>
            <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)] sm:text-base">
              Share the basics about the project and CFL Wash Co. can review the
              request before following up. Fields marked Required must be
              completed.
            </p>
          </div>

          <form
            data-quote-form
            data-site-email={site.email}
            data-turnstile-site-key={turnstileSiteKey}
            class="mt-8 space-y-5"
            novalidate
          >
            <div
              data-form-status
              tabindex="-1"
              aria-live="polite"
              aria-atomic="true"
              class="hidden rounded-[var(--radius-md)] border px-4 py-3 text-sm leading-6 outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring)] focus-visible:ring-offset-2"
            />

            <div class="grid gap-5 sm:grid-cols-2">
              <div class="sm:col-span-2">
                <label
                  for="quote-name"
                  class="block text-sm font-semibold text-[var(--color-text)]"
                >
                  Name
                  <span class="ml-2 text-xs font-medium text-[var(--color-text-muted)]">
                    Required
                  </span>
                </label>
                <p
                  id="quote-name-hint"
                  class="mt-1 text-sm text-[var(--color-text-muted)]"
                >
                  Use the best name for quote follow-up.
                </p>
                <input
                  id="quote-name"
                  name="name"
                  type="text"
                  required
                  autocomplete="name"
                  minlength="2"
                  maxlength="100"
                  aria-describedby="quote-name-hint quote-name-error"
                  class="mt-2 block w-full rounded-[var(--radius-md)] border border-[var(--color-border)] bg-white px-4 py-3 text-base text-[var(--color-text)] shadow-sm outline-none transition focus:border-[var(--color-primary)] focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring)] focus-visible:ring-offset-2"
                />
                <p
                  id="quote-name-error"
                  data-field-error
                  class="mt-2 text-sm font-medium text-red-700"
                  hidden
                />
              </div>

              <div>
                <label
                  for="quote-email"
                  class="block text-sm font-semibold text-[var(--color-text)]"
                >
                  Email
                  <span class="ml-2 text-xs font-medium text-[var(--color-text-muted)]">
                    Required
                  </span>
                </label>
                <p
                  id="quote-email-hint"
                  class="mt-1 text-sm text-[var(--color-text-muted)]"
                >
                  CFL Wash Co. uses this email to reply about your request.
                </p>
                <input
                  id="quote-email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  maxlength="254"
                  aria-describedby="quote-email-hint quote-email-error"
                  class="mt-2 block w-full rounded-[var(--radius-md)] border border-[var(--color-border)] bg-white px-4 py-3 text-base text-[var(--color-text)] shadow-sm outline-none transition focus:border-[var(--color-primary)] focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring)] focus-visible:ring-offset-2"
                />
                <p
                  id="quote-email-error"
                  data-field-error
                  class="mt-2 text-sm font-medium text-red-700"
                  hidden
                />
              </div>

              <div>
                <label
                  for="quote-phone"
                  class="block text-sm font-semibold text-[var(--color-text)]"
                >
                  Phone
                  <span class="ml-2 text-xs font-medium text-[var(--color-text-muted)]">
                    Optional
                  </span>
                </label>
                <p
                  id="quote-phone-hint"
                  class="mt-1 text-sm text-[var(--color-text-muted)]"
                >
                  Include a phone number only if it is helpful for follow-up.
                </p>
                <input
                  id="quote-phone"
                  name="phone"
                  type="tel"
                  autocomplete="tel"
                  maxlength="30"
                  aria-describedby="quote-phone-hint quote-phone-error"
                  class="mt-2 block w-full rounded-[var(--radius-md)] border border-[var(--color-border)] bg-white px-4 py-3 text-base text-[var(--color-text)] shadow-sm outline-none transition focus:border-[var(--color-primary)] focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring)] focus-visible:ring-offset-2"
                />
                <p
                  id="quote-phone-error"
                  data-field-error
                  class="mt-2 text-sm font-medium text-red-700"
                  hidden
                />
              </div>

              <div>
                <label
                  for="quote-city"
                  class="block text-sm font-semibold text-[var(--color-text)]"
                >
                  City
                  <span class="ml-2 text-xs font-medium text-[var(--color-text-muted)]">
                    Required
                  </span>
                </label>
                <p
                  id="quote-city-hint"
                  class="mt-1 text-sm text-[var(--color-text-muted)]"
                >
                  Tell us the city where the cleaning is needed.
                </p>
                <input
                  id="quote-city"
                  name="city"
                  type="text"
                  required
                  autocomplete="address-level2"
                  minlength="2"
                  maxlength="100"
                  aria-describedby="quote-city-hint quote-city-error"
                  class="mt-2 block w-full rounded-[var(--radius-md)] border border-[var(--color-border)] bg-white px-4 py-3 text-base text-[var(--color-text)] shadow-sm outline-none transition focus:border-[var(--color-primary)] focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring)] focus-visible:ring-offset-2"
                />
                <p
                  id="quote-city-error"
                  data-field-error
                  class="mt-2 text-sm font-medium text-red-700"
                  hidden
                />
              </div>

              <div>
                <label
                  for="quote-service"
                  class="block text-sm font-semibold text-[var(--color-text)]"
                >
                  Service
                  <span class="ml-2 text-xs font-medium text-[var(--color-text-muted)]">
                    Required
                  </span>
                </label>
                <p
                  id="quote-service-hint"
                  class="mt-1 text-sm text-[var(--color-text-muted)]"
                >
                  Choose the closest match for the surface you need cleaned.
                </p>
                <select
                  id="quote-service"
                  name="service"
                  required
                  aria-describedby="quote-service-hint quote-service-error"
                  class="mt-2 block w-full rounded-[var(--radius-md)] border border-[var(--color-border)] bg-white px-4 py-3 text-base text-[var(--color-text)] shadow-sm outline-none transition focus:border-[var(--color-primary)] focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring)] focus-visible:ring-offset-2"
                >
                  <option value="">Select a service</option>
                  {services.map((service) => (
                    <option value={service.slug}>{service.name}</option>
                  ))}
                </select>
                <p
                  id="quote-service-error"
                  data-field-error
                  class="mt-2 text-sm font-medium text-red-700"
                  hidden
                />
              </div>

              <div class="sm:col-span-2">
                <label
                  for="quote-details"
                  class="block text-sm font-semibold text-[var(--color-text)]"
                >
                  Project details
                  <span class="ml-2 text-xs font-medium text-[var(--color-text-muted)]">
                    Required
                  </span>
                </label>
                <p
                  id="quote-details-hint"
                  class="mt-1 text-sm text-[var(--color-text-muted)]"
                >
                  Share the area to clean and relevant buildup or curb appeal
                  context. Do not include payment or other sensitive
                  information.
                </p>
                <textarea
                  id="quote-details"
                  name="details"
                  required
                  minlength="10"
                  maxlength="2000"
                  rows="6"
                  aria-describedby="quote-details-hint quote-details-error"
                  class="mt-2 block w-full rounded-[var(--radius-md)] border border-[var(--color-border)] bg-white px-4 py-3 text-base text-[var(--color-text)] shadow-sm outline-none transition focus:border-[var(--color-primary)] focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring)] focus-visible:ring-offset-2"
                />
                <p
                  id="quote-details-error"
                  data-field-error
                  class="mt-2 text-sm font-medium text-red-700"
                  hidden
                />
              </div>
            </div>

            <div class="hidden" aria-hidden="true">
              <label for="quote-website">Website</label>
              <input
                id="quote-website"
                name="website"
                type="text"
                tabindex="-1"
                autocomplete="off"
              />
            </div>

            <input
              type="hidden"
              id="quote-turnstile-token"
              name="turnstileToken"
              value=""
            />

            <div class="rounded-[var(--radius-md)] border border-[var(--color-border)] bg-[var(--color-surface)] p-4">
              <p class="text-sm font-semibold text-[var(--color-text)]">
                Verification
                <span class="ml-2 text-xs font-medium text-[var(--color-text-muted)]">
                  Required
                </span>
              </p>
              <p
                id="quote-turnstile-hint"
                class="mt-2 text-sm leading-6 text-[var(--color-text-muted)]"
              >
                Complete the security check before submitting the form.
              </p>
              <div
                data-turnstile-container
                class="mt-4 min-h-[72px] rounded-[var(--radius-md)]"
              />
              <p
                id="quote-turnstile-error"
                data-turnstile-error
                class="mt-3 text-sm font-medium text-red-700"
                hidden
              />
            </div>

            <div class="rounded-[var(--radius-md)] border border-[var(--color-border)] bg-[var(--color-surface)] p-4">
              <div class="flex items-start gap-3">
                <input
                  id="quote-consent"
                  name="consent"
                  type="checkbox"
                  value="true"
                  required
                  aria-describedby="quote-consent-hint quote-consent-error"
                  class="mt-1 h-4 w-4 rounded border-[var(--color-border)] text-[var(--color-primary)] focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring)] focus-visible:ring-offset-2"
                />
                <div>
                  <label
                    for="quote-consent"
                    class="text-sm font-semibold text-[var(--color-text)]"
                  >
                    I agree that CFL Wash Co. may use these details to respond
                    to my quote request.
                    <span class="ml-2 text-xs font-medium text-[var(--color-text-muted)]">
                      Required
                    </span>
                  </label>
                  <p
                    id="quote-consent-hint"
                    class="mt-2 text-sm leading-6 text-[var(--color-text-muted)]"
                  >
                    Review the{' '}
                    <a
                      href="/privacy"
                      class="font-semibold text-[var(--color-primary)] underline decoration-[var(--color-border)] underline-offset-4 hover:text-[var(--color-primary-hover)] focus:outline-none focus-visible:rounded-[var(--radius-sm)] focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring)] focus-visible:ring-offset-2"
                    >
                      Privacy Notice
                    </a>
                    .
                  </p>
                </div>
              </div>
              <p
                id="quote-consent-error"
                data-field-error
                class="mt-3 text-sm font-medium text-red-700"
                hidden
              />
            </div>

            <div class="flex flex-col gap-3 border-t border-[var(--color-border)] pt-5 sm:flex-row sm:items-center sm:justify-between">
              <p class="text-sm leading-6 text-[var(--color-text-muted)]">
                Online quote requests are reviewed before follow-up.
              </p>
              <button
                type="submit"
                data-submit-button
                class="inline-flex min-h-11 items-center justify-center rounded-[var(--radius-md)] bg-[var(--color-primary)] px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-[var(--color-primary-hover)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring)] focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-60"
              >
                Request quote
              </button>
            </div>
          </form>
        </>
      ) : (
        <>
          <h2 class="text-2xl font-semibold text-[var(--color-text)]">
            Online quote form temporarily unavailable
          </h2>
          <p class="mt-3 max-w-2xl text-sm leading-7 text-[var(--color-text-muted)] sm:text-base">
            Please email your city, service, and project details to request a
            quote.
          </p>
          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <Button
              href={quoteEmailHref}
              data-cta="email"
              data-cta-location="request-quote-form-unavailable"
            >
              Email CFL Wash Co.
            </Button>
            <Button href="/privacy" variant="secondary">
              Privacy Notice
            </Button>
          </div>
        </>
      )
    }
  </Card>

  <Card class="bg-[var(--color-surface)]" id="quote-fallback">
    <h2 class="text-xl font-semibold text-[var(--color-text)]">
      What happens next
    </h2>
    <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
      CFL Wash Co. reviews the request details, confirms the scope, and follows
      up by email. A quote request does not confirm scheduling or pricing on its
      own.
    </p>

    <div
      data-delivery-fallback
      class="mt-5 rounded-[var(--radius-md)] border border-red-200 bg-red-50 px-4 py-3 text-sm leading-6 text-red-800"
      hidden
    >
      Online form delivery is unavailable right now. Please use email so the
      project details still reach CFL Wash Co.
    </div>

    <div class="mt-6 space-y-4">
      <div class="border-b border-[var(--color-border)] pb-4">
        <h3 class="text-sm font-semibold text-[var(--color-text)]">
          Prefer email?
        </h3>
        <p class="mt-2 text-sm leading-6 text-[var(--color-text-muted)]">
          Email is always available as a fallback for quote requests.
        </p>
        <div class="mt-4">
          <Button
            href={quoteEmailHref}
            data-cta="email"
            data-cta-location="request-quote-fallback"
          >
            Start email
          </Button>
        </div>
      </div>

      <div class="border-b border-[var(--color-border)] pb-4">
        <h3 class="text-sm font-semibold text-[var(--color-text)]">
          Helpful details
        </h3>
        <ul class="mt-3 space-y-3 text-sm leading-6 text-[var(--color-text)]">
          <li class="flex gap-3">
            <span
              class="mt-2 h-2 w-2 shrink-0 rounded-full bg-[var(--color-primary)]"
            ></span>
            <span>City where the cleaning is needed</span>
          </li>
          <li class="flex gap-3">
            <span
              class="mt-2 h-2 w-2 shrink-0 rounded-full bg-[var(--color-primary)]"
            ></span>
            <span>Closest service match for the project</span>
          </li>
          <li class="flex gap-3">
            <span
              class="mt-2 h-2 w-2 shrink-0 rounded-full bg-[var(--color-primary)]"
            ></span>
            <span>Surface details, buildup, or curb appeal concerns</span>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-[var(--color-text)]">Privacy</h3>
        <p class="mt-2 text-sm leading-6 text-[var(--color-text-muted)]">
          Review how contact details, analytics, and operational providers are
          used in the <a
            href="/privacy"
            class="font-semibold text-[var(--color-primary)] underline decoration-[var(--color-border)] underline-offset-4 hover:text-[var(--color-primary-hover)] focus:outline-none focus-visible:rounded-[var(--radius-sm)] focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring)] focus-visible:ring-offset-2"
          >
            Privacy Notice
          </a>.
        </p>
      </div>
    </div>
  </Card>
</div>

{
  hasTurnstile && (
    <>
      <script
        async
        defer
        id="quote-turnstile-api"
        src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
      />
      <script is:inline set:html={turnstileClientScript} />
    </>
  )
}
