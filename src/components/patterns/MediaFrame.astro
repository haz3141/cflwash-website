---
import type { PublicMediaAsset } from '../../data/publicMedia'

type Props = {
  media: PublicMediaAsset
  loading?: 'eager' | 'lazy'
  fetchpriority?: 'high' | 'low' | 'auto'
  sizes?: string
  class?: string
  imageClass?: string
}

const {
  media,
  loading = 'lazy',
  fetchpriority = 'auto',
  sizes = '(min-width: 1024px) 42vw, 100vw',
  class: className = '',
  imageClass = 'aspect-[16/10] lg:aspect-[4/5]',
} = Astro.props as Props

const srcset = media.image.sources
  ?.map(({ src, width }) => `${src} ${width}w`)
  .join(', ')
---

<figure
  class={`media-frame ${className}`.trim()}
  data-media-id={media.id}
  data-media-role={media.role}
  data-proof-status={media.proofStatus}
>
  <img
    src={media.image.src}
    alt={media.alt}
    width={media.image.width}
    height={media.image.height}
    srcset={srcset}
    sizes={srcset ? sizes : undefined}
    class={`w-full object-cover ${imageClass}`.trim()}
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
  />
  {
    media.caption && (
      <figcaption class="border-t border-[var(--color-border)] bg-[var(--color-surface-raised)] px-4 py-3 text-xs leading-5 text-[var(--color-text-muted)]">
        {media.caption}
        {media.attribution && <span> {media.attribution}</span>}
      </figcaption>
    )
  }
</figure>
