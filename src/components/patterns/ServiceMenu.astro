---
import IconBadge from '../ui/IconBadge.astro'
import type { PublicMediaAsset } from '../../data/publicMedia'
import { ArrowRight } from '@lucide/astro'

type ServiceMenuItem = {
  slug: string
  name: string
  summary: string
  fit: string
  media: PublicMediaAsset
  icon: any
}

type Props = {
  items: ServiceMenuItem[]
}

const { items } = Astro.props as Props
---

<ul
  class="m-0 list-none border-y border-[var(--color-border)] p-0"
  data-service-menu
>
  {
    items.map((item, index) => {
      const Icon = item.icon
      const srcset = item.media.image.sources
        .map(({ src, width }) => `${src} ${width}w`)
        .join(', ')

      return (
        <li
          class:list={[
            'grid min-w-0 gap-8 py-10 lg:grid-cols-2 lg:items-center lg:gap-[var(--layout-gap)] lg:py-14',
            index > 0 && 'border-t border-[var(--color-border)]',
          ]}
          data-service-menu-item
          data-media-id={item.media.id}
          data-media-role={item.media.role}
          data-proof-status={item.media.proofStatus}
        >
          <figure class="media-frame min-w-0">
            <img
              src={item.media.image.src}
              srcset={srcset}
              sizes="(min-width: 1024px) 36rem, 100vw"
              alt={item.media.alt}
              width={item.media.image.width}
              height={item.media.image.height}
              loading="lazy"
              decoding="async"
              class="aspect-[3/2] w-full object-cover"
            />
            <figcaption class="border-t border-[var(--color-border)] bg-[var(--color-surface-raised)] px-4 py-3 text-xs leading-5 text-[var(--color-text-muted)]">
              {item.media.caption}
              {item.media.attribution && <span> {item.media.attribution}</span>}
            </figcaption>
          </figure>

          <div class="min-w-0 lg:py-4">
            <IconBadge icon={Icon} tone="accent" size="lg" />
            <h3 class="mt-5 text-section-subtitle text-[var(--color-text)]">
              {item.name}
            </h3>
            <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
              {item.summary}
            </p>
            <p
              class="mt-5 border-l-2 border-[var(--color-accent)] pl-4 text-sm leading-7 text-[var(--color-text-muted)]"
              data-service-fit
            >
              {item.fit}
            </p>
            <a href={`/${item.slug}`} class="text-link mt-6">
              View {item.name}
              <ArrowRight
                class="h-4 w-4"
                aria-hidden="true"
                stroke-width="1.9"
              />
            </a>
          </div>
        </li>
      )
    })
  }
</ul>
