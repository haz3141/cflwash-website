---
import { ArrowRight } from '@lucide/astro'

type Item = {
  label: string
  href?: string
  description?: string
  status?: 'inactive'
}

type Variant = 'cards' | 'compact'
type Columns = 'one' | 'two' | 'three'
type Density = 'compact' | 'comfortable'

type Props = {
  items: Item[]
  variant?: Variant
  columns?: Columns
  density?: Density
  class?: string
}

const {
  items,
  variant = 'compact',
  columns = 'one',
  density = 'compact',
  class: className = '',
} = Astro.props as Props

const gridClasses: Record<Columns, string> = {
  one: 'grid',
  two: 'grid sm:grid-cols-2',
  three: 'grid md:grid-cols-3',
}
const paddingClass = density === 'comfortable' ? 'p-5' : 'p-4'
const labelClass =
  density === 'comfortable'
    ? 'text-base font-semibold'
    : 'text-sm font-semibold'
const isCards = variant === 'cards'
const itemBase = isCards
  ? `block h-full w-full rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-surface-raised)] ${paddingClass} text-[var(--color-text)]`
  : `block h-full w-full border-b border-[var(--color-border)] ${paddingClass} text-[var(--color-text)]`
const linkClass = `${itemBase} transition-colors duration-[var(--duration-fast)] hover:border-[var(--color-action)] hover:text-[var(--color-action)] focus:outline-none focus-visible:relative focus-visible:z-10 focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[var(--color-focus-ring)]`
const inactiveClass = `${itemBase} border-dashed text-[var(--color-text-muted)]`
---

<ul
  class={`${gridClasses[columns]} ${isCards ? 'gap-4' : 'border-t border-[var(--color-border)]'} ${className}`.trim()}
>
  {
    items.map((item) => (
      <li>
        {item.href && item.status !== 'inactive' ? (
          <a href={item.href} class={linkClass}>
            <span class="flex items-start justify-between gap-3">
              <span
                class={`${labelClass} ${item.description ? 'block' : ''}`.trim()}
              >
                {item.label}
              </span>
              <ArrowRight
                class="mt-0.5 h-4 w-4 shrink-0"
                aria-hidden="true"
                stroke-width="1.9"
              />
            </span>
            {item.description && (
              <span class="mt-3 block text-sm font-normal leading-7 text-[var(--color-text-muted)]">
                {item.description}
              </span>
            )}
          </a>
        ) : (
          <p class={inactiveClass}>
            <span
              class={`${labelClass} ${item.description ? 'block' : ''}`.trim()}
            >
              {item.label}
            </span>
            {item.description && (
              <span class="mt-3 block text-sm font-normal leading-7 text-[var(--color-text-muted)]">
                {item.description}
              </span>
            )}
          </p>
        )}
      </li>
    ))
  }
</ul>
