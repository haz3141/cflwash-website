---
import Button from '../ui/Button.astro'
import Card from '../ui/Card.astro'
import Section from '../ui/Section.astro'
import BreadcrumbSchema from '../site/BreadcrumbSchema.astro'
import Breadcrumbs from '../site/Breadcrumbs.astro'
import CTASection from './CTASection.astro'
import FAQList from './FAQList.astro'
import HeroSection from './HeroSection.astro'
import LinkGrid from './LinkGrid.astro'
import MediaFrame from './MediaFrame.astro'
import ProcessSteps from './ProcessSteps.astro'
import Layout from '../../layouts/Layout.astro'
import type { ServiceDetailPageContent } from '../../data/serviceDetailPageTypes'
import { serviceAreas } from '../../data/serviceAreas'
import { services } from '../../data/services'
import { site } from '../../data/site'
import { Check, Mail, Phone } from '@lucide/astro'

type Props = {
  page: ServiceDetailPageContent
}

const { page } = Astro.props as Props
const service = services.find((item) => item.slug === page.slug)

if (!service) {
  throw new Error(`Unknown service: ${page.slug}`)
}

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: service.name, href: `/${service.slug}` },
]
const relatedServiceLinks = services
  .filter((item) => item.slug !== service.slug)
  .map((item) => ({
    label: item.name,
    href: `/${item.slug}`,
  }))
const activeServiceAreaLinks = serviceAreas.map((area) => ({
  label: area.name,
  href: `/service-areas/${area.slug}`,
}))
const hasPhone = Boolean(site.phoneDisplay && site.phoneHref)
const heroLocation = `service-${service.slug}`
const finalLocation = `${heroLocation}-final`
---

<Layout
  title={page.seoTitle}
  description={page.seoDescription}
  canonicalPath={`/${page.slug}`}
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />
  <main data-service-detail-page>
    <Breadcrumbs items={breadcrumbs} />

    <HeroSection
      variant="split"
      tone="soft"
      eyebrow={page.hero.eyebrow}
      title={page.hero.title}
      description={page.hero.description}
    >
      <Fragment slot="actions">
        <Button
          href="/request-quote"
          size="lg"
          fullWidth
          class="sm:w-auto"
          data-cta="quote"
          data-cta-location={heroLocation}
        >
          Request a Quote
        </Button>
        {
          hasPhone ? (
            <Button
              href={site.phoneHref!}
              variant="secondary"
              size="lg"
              fullWidth
              class="sm:w-auto"
              data-cta="call"
              data-cta-location={heroLocation}
            >
              <Phone
                slot="startIcon"
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
              Call {site.phoneDisplay}
            </Button>
          ) : (
            <Button
              href={`mailto:${site.email}`}
              variant="secondary"
              size="lg"
              fullWidth
              class="sm:w-auto"
              data-cta="email"
              data-cta-location={heroLocation}
            >
              <Mail
                slot="startIcon"
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
              Email CFL Wash Co.
            </Button>
          )
        }
      </Fragment>

      <MediaFrame
        slot="media"
        media={page.hero.media}
        loading="eager"
        fetchpriority="high"
      />
    </HeroSection>

    <Section
      eyebrow={page.scope.eyebrow}
      title={page.scope.title}
      description={page.scope.description}
      class="border-t border-[var(--color-border)]"
    >
      <ul
        class="grid border-t border-[var(--color-border)] md:grid-cols-2"
        data-service-scope
      >
        {
          page.scope.items.map((item, index) => (
            <li
              class:list={[
                'flex min-w-0 gap-3 border-b border-[var(--color-border)] py-5',
                index % 2 === 1 && 'md:border-l md:pl-8',
                index % 2 === 0 && 'md:pr-8',
              ]}
            >
              <Check
                class="mt-1 h-4 w-4 shrink-0 text-[var(--color-action)]"
                aria-hidden="true"
                stroke-width="2"
              />
              <span class="text-sm font-semibold leading-7 text-[var(--color-text)]">
                {item}
              </span>
            </li>
          ))
        }
      </ul>
    </Section>

    <Section
      eyebrow={page.guidance.eyebrow}
      title={page.guidance.title}
      description={page.guidance.description}
      tone="water"
    >
      <div
        class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,0.7fr)] lg:items-start lg:gap-[var(--layout-gap)]"
      >
        <ul class="border-t border-[var(--color-border)]" data-service-guidance>
          {
            page.guidance.items.map((item) => (
              <li class="border-b border-[var(--color-border)] py-5">
                <h3 class="text-base font-semibold text-[var(--color-text)]">
                  {item.title}
                </h3>
                <p class="mt-2 text-sm leading-7 text-[var(--color-text-muted)]">
                  {item.description}
                </p>
              </li>
            ))
          }
        </ul>

        <Card tone="raised" padding="lg" data-service-preparation>
          <h3 class="text-section-subtitle text-[var(--color-text)]">
            {page.preparation.title}
          </h3>
          <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
            {page.preparation.description}
          </p>
          <ul class="mt-6 border-t border-[var(--color-border)]">
            {
              page.preparation.items.map((item) => (
                <li class="border-b border-[var(--color-border)] py-4 text-sm leading-7 text-[var(--color-text-muted)]">
                  {item}
                </li>
              ))
            }
          </ul>
        </Card>
      </div>
    </Section>

    <Section
      eyebrow={page.process.eyebrow}
      title={page.process.title}
      description={page.process.description}
    >
      <ProcessSteps steps={page.process.steps} />
    </Section>

    <Section
      eyebrow={page.related.eyebrow}
      title={page.related.title}
      description={page.related.description}
      tone="warm"
    >
      <div class="grid gap-10 lg:grid-cols-2 lg:gap-[var(--layout-gap)]">
        <div>
          <h3 class="text-lg font-semibold text-[var(--color-text)]">
            Related services
          </h3>
          <LinkGrid items={relatedServiceLinks} columns="two" class="mt-4" />
        </div>

        <div>
          <h3 class="text-lg font-semibold text-[var(--color-text)]">
            Active service areas
          </h3>
          <LinkGrid items={activeServiceAreaLinks} columns="two" class="mt-4" />
        </div>
      </div>
    </Section>

    <Section eyebrow={page.faq.eyebrow} title={page.faq.title} tone="soft">
      <FAQList faqs={page.faq.items} />
    </Section>

    <CTASection
      tone="inverse"
      title={page.cta.title}
      description={page.cta.description}
    >
      <Fragment slot="actions">
        <Button
          href="/request-quote"
          variant="light"
          size="lg"
          fullWidth
          class="sm:w-auto"
          data-cta="quote"
          data-cta-location={finalLocation}
        >
          Request a Quote
        </Button>
        {
          hasPhone ? (
            <Button
              href={site.phoneHref!}
              variant="inverseGhost"
              size="lg"
              fullWidth
              class="sm:w-auto"
              data-cta="call"
              data-cta-location={finalLocation}
            >
              <Phone
                slot="startIcon"
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
              Call {site.phoneDisplay}
            </Button>
          ) : (
            <Button
              href={`mailto:${site.email}`}
              variant="inverseGhost"
              size="lg"
              fullWidth
              class="sm:w-auto"
              data-cta="email"
              data-cta-location={finalLocation}
            >
              <Mail
                slot="startIcon"
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
              Email CFL Wash Co.
            </Button>
          )
        }
      </Fragment>
    </CTASection>
  </main>
</Layout>
