---
import Card from '../ui/Card.astro'

type Step = {
  title: string
  description: string
}

type Variant = 'featured' | 'compact'
type Tone = 'raised' | 'soft'

type Props = {
  steps: Step[]
  variant?: Variant
  cardTone?: Tone
  class?: string
}

const {
  steps,
  variant = 'compact',
  cardTone = 'raised',
  class: className = '',
} = Astro.props as Props

const isFeatured = variant === 'featured'
const listClasses = isFeatured
  ? `grid list-none gap-4 p-0 m-0 md:grid-cols-3 ${className}`.trim()
  : `grid list-none gap-0 p-0 m-0 md:grid-cols-3 ${className}`.trim()
---

<ol class={listClasses} data-process-list>
  {
    steps.map((step, index) => (
      <li
        class:list={[
          'min-w-0',
          !isFeatured && 'border-t border-[var(--color-border)] py-6',
          !isFeatured && index > 0 && 'md:border-l md:pl-8',
          !isFeatured && index < steps.length - 1 && 'md:border-t-0 md:pr-8',
          !isFeatured && index === steps.length - 1 && 'md:border-t-0',
        ]}
        data-process-step={index + 1}
      >
        {isFeatured ? (
          <Card tone={cardTone} padding="lg" class="flex h-full flex-col">
            <>
              <div class="flex items-center">
                <span class="theme-shadow-xs flex h-12 w-12 items-center justify-center rounded-full bg-[var(--color-action)] text-base font-semibold text-[var(--color-text-inverse)] ring-4 ring-[var(--color-surface)] md:h-14 md:w-14 md:text-lg">
                  {index + 1}
                </span>
              </div>
              <h3 class="mt-5 text-section-subtitle text-[var(--color-text)]">
                {step.title}
              </h3>
            </>
            <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
              {step.description}
            </p>
          </Card>
        ) : (
          <div>
            <div class="flex items-center gap-4">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[var(--color-surface-inverse)] text-sm font-semibold text-[var(--color-accent)]">
                {index + 1}
              </span>
              <h3 class="text-base font-semibold text-[var(--color-text)]">
                {step.title}
              </h3>
            </div>
            <p class="mt-4 text-sm leading-7 text-[var(--color-text-muted)]">
              {step.description}
            </p>
          </div>
        )}
      </li>
    ))
  }
</ol>
