---
import Container from '../ui/Container.astro'

type Props = {
  eyebrow?: string
  title: string
  description?: string
  surface?: 'default' | 'elevated'
  tone?: 'action' | 'inverse'
  titleWidth?: 'default' | 'wide'
}

const {
  eyebrow,
  title,
  description,
  surface = 'default',
  tone = 'action',
  titleWidth = 'default',
} = Astro.props as Props

const titleClass =
  titleWidth === 'wide'
    ? 'mx-auto max-w-3xl text-section-title text-[var(--color-text-inverse)]'
    : 'mx-auto max-w-2xl text-section-title text-[var(--color-text-inverse)]'

const panelClass = surface === 'elevated' ? 'theme-shadow-sm' : ''
const toneClass =
  tone === 'inverse'
    ? 'cta-shell border-[var(--color-inverse-border)] bg-[var(--color-surface-inverse)]'
    : 'cta-shell border-[var(--color-inverse-border)] bg-[var(--color-cta-surface)]'
---

<section class="py-[var(--section-space)]" data-sticky-cta-stop>
  <Container>
    <div
      class={`relative overflow-hidden rounded-[var(--radius-xl)] border px-6 py-[var(--space-12)] text-center text-[var(--color-text-inverse)] sm:px-10 sm:py-14 ${toneClass} ${panelClass}`.trim()}
    >
      <div class="cta-shell-art" aria-hidden="true"></div>
      {
        eyebrow && (
          <p class="relative text-eyebrow text-[var(--color-inverse-muted)]">
            {eyebrow}
          </p>
        )
      }
      <h2
        class={`${titleClass} ${eyebrow ? 'relative mt-3' : 'relative'}`.trim()}
      >
        {title}
      </h2>
      {
        description && (
          <p class="relative mx-auto mt-4 max-w-2xl text-base leading-8 text-[var(--color-inverse-muted)]">
            {description}
          </p>
        )
      }
      <div class="relative mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <slot name="actions" />
      </div>
    </div>
  </Container>
</section>
