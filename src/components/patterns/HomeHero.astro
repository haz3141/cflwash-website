---
import {
  ArrowRight,
  MapPin,
  Sparkles,
  House,
  ShieldCheck,
  CalendarCheck2,
} from '@lucide/astro'
import Button from '../ui/Button.astro'
import IconBadge from '../ui/IconBadge.astro'
import { site } from '../../data/site'
import { publicMedia } from '../../data/publicMedia'

const hasPhone = Boolean(site.phoneDisplay && site.phoneHref)

const heroBenefits = [
  { icon: Sparkles, title: 'Boosts curb appeal' },
  { icon: House, title: 'HOA notice support' },
  { icon: ShieldCheck, title: 'Surface-aware review' },
  { icon: CalendarCheck2, title: 'Clear next steps' },
]
---

<section
  class="relative overflow-hidden bg-[var(--color-surface-warm)] pt-6 pb-12 lg:pt-16 lg:pb-20"
>
  <div
    class="relative mx-auto w-full max-w-[82rem] px-[var(--container-gutter)]"
  >
    <div
      class="grid grid-cols-1 gap-10 lg:grid-cols-2 lg:items-center lg:gap-16"
    >
      <!-- Content Column -->
      <div
        class="relative z-10 flex flex-col items-center text-center lg:items-start lg:text-left"
      >
        <p class="text-eyebrow text-[var(--color-accent)]">
          Central Florida Pressure Washing
        </p>
        <h1
          class="mt-4 max-w-[15ch] text-[clamp(2.25rem,6vw,4.25rem)] font-semibold leading-[0.95] tracking-tight text-[var(--color-text)] lg:max-w-[12ch]"
        >
          Driveway, Sidewalk, and Exterior Cleaning in Central Florida
        </h1>
        <p
          class="mt-6 max-w-[42rem] text-base leading-7 text-[var(--color-text-muted)] sm:text-lg sm:leading-8"
        >
          Quote-first exterior cleaning for driveways, sidewalks, walkways,
          patios, pool decks, and HOA notice cleanup.
        </p>

        <!-- CTA Stack -->
        <div
          class="mt-8 flex w-full flex-col gap-3 sm:flex-row sm:justify-center lg:justify-start"
        >
          <Button
            href="/request-quote"
            variant="accent"
            size="lg"
            fullWidth
            class="sm:w-auto"
            data-cta="quote"
            data-cta-location="home-hero"
          >
            Request a Quote
            <ArrowRight
              slot="endIcon"
              class="h-5 w-5"
              aria-hidden="true"
              stroke-width="2"
            />
          </Button>
          {
            hasPhone && (
              <Button
                href={site.phoneHref}
                variant="light"
                size="lg"
                fullWidth
                class="sm:w-auto"
                data-cta="call"
                data-cta-location="home-hero"
              >
                Call
              </Button>
            )
          }
        </div>

        <!-- Mobile Visual (compact mosaic) -->
        <div class="mt-10 w-full lg:hidden">
          <div class="hero-mosaic-container relative mx-auto max-w-[440px]">
            <div class="grid aspect-[4/3] grid-cols-12 grid-rows-6 gap-2">
              <div class="mosaic-card-main col-span-8 row-span-6">
                <img
                  src={publicMedia.serviceDriveway.image.src}
                  alt={publicMedia.serviceDriveway.alt}
                  class="h-full w-full object-cover"
                  loading="eager"
                />
                <div class="mosaic-label bottom-2 left-2">Driveways</div>
              </div>
              <div class="mosaic-card-side col-span-4 row-span-3">
                <img
                  src={publicMedia.serviceWalkway.image.src}
                  alt={publicMedia.serviceWalkway.alt}
                  class="h-full w-full object-cover"
                  loading="eager"
                />
                <div class="mosaic-label bottom-2 left-2">Walkways</div>
              </div>
              <div class="mosaic-card-side col-span-4 row-span-3">
                <img
                  src={publicMedia.serviceConcrete.image.src}
                  alt={publicMedia.serviceConcrete.alt}
                  class="h-full w-full object-cover"
                  loading="eager"
                />
                <div class="mosaic-label bottom-2 left-2">Concrete</div>
              </div>
              <img
                src="/images/brand/logo-mark-transparent.png"
                alt=""
                class="theme-shadow-action absolute -right-2 -bottom-2 z-10 h-16 w-16"
              />
            </div>
          </div>
        </div>

        <!-- Benefit Chips -->
        <div
          class="mt-10 grid w-full grid-cols-2 gap-x-4 gap-y-6 sm:grid-cols-4 lg:mt-12"
        >
          {
            heroBenefits.map((benefit) => (
              <div class="flex flex-col items-center gap-2 lg:items-start">
                <IconBadge
                  icon={benefit.icon}
                  tone="default"
                  size="sm"
                  class="theme-shadow-xs shrink-0 text-[var(--color-action)]"
                />
                <p class="text-[0.72rem] font-bold leading-tight text-[var(--color-text)]">
                  {benefit.title}
                </p>
              </div>
            ))
          }
        </div>

        <p
          class="mt-8 flex items-center gap-2 text-sm font-semibold text-[var(--color-text)]"
        >
          <MapPin
            class="h-4 w-4 text-[var(--color-action)]"
            aria-hidden="true"
            stroke-width="2"
          />
          Serving Central Florida
        </p>
      </div>

      <!-- Desktop Visual Column -->
      <div class="relative hidden lg:block">
        <div class="hero-mosaic-container relative">
          <div class="grid aspect-square grid-cols-12 grid-rows-6 gap-4">
            <div class="mosaic-card-main col-span-8 row-span-6">
              <img
                src={publicMedia.serviceDriveway.image.src}
                alt={publicMedia.serviceDriveway.alt}
                class="h-full w-full object-cover transition-transform duration-700 hover:scale-105"
                loading="eager"
              />
              <div class="mosaic-label bottom-4 left-4 !text-xs">
                Driveway Cleaning
              </div>
            </div>
            <div class="mosaic-card-side col-span-4 row-span-3">
              <img
                src={publicMedia.serviceWalkway.image.src}
                alt={publicMedia.serviceWalkway.alt}
                class="h-full w-full object-cover transition-transform duration-700 hover:scale-105"
                loading="eager"
              />
              <div class="mosaic-label bottom-3 left-3">Walkways</div>
            </div>
            <div class="mosaic-card-side col-span-4 row-span-3">
              <img
                src={publicMedia.serviceConcrete.image.src}
                alt={publicMedia.serviceConcrete.alt}
                class="h-full w-full object-cover transition-transform duration-700 hover:scale-105"
                loading="eager"
              />
              <div class="mosaic-label bottom-3 left-3">Concrete</div>
            </div>
            <img
              src="/images/brand/logo-mark-transparent.png"
              alt=""
              class="theme-shadow-action absolute -right-6 -bottom-6 z-20 h-32 w-32"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
