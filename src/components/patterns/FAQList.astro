---
import Card from '../ui/Card.astro'

type FAQ = {
  question: string
  answer: string
}

type Columns = 'two' | 'three'

type Props = {
  faqs: FAQ[]
  columns?: Columns
  class?: string
}

const { faqs, columns = 'three', class: className = '' } = Astro.props as Props

const gridClass =
  columns === 'two' ? 'grid gap-4 md:grid-cols-2' : 'grid gap-4 md:grid-cols-3'
---

<ul class={`${gridClass} ${className}`.trim()}>
  {
    faqs.map((faq) => (
      <li>
        <Card tone="raised" class="h-full">
          <h3 class="text-base font-semibold text-[var(--color-text)]">
            {faq.question}
          </h3>
          <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
            {faq.answer}
          </p>
        </Card>
      </li>
    ))
  }
</ul>
