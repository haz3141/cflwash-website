---
type FAQ = {
  question: string
  answer: string
}

type Columns = 'two' | 'three'

type Props = {
  faqs: FAQ[]
  columns?: Columns
  class?: string
}

const { faqs, columns = 'three', class: className = '' } = Astro.props as Props

const gridClass =
  columns === 'two' ? 'grid md:grid-cols-2' : 'grid md:grid-cols-3'
---

<ul class={`${gridClass} ${className}`.trim()}>
  {
    faqs.map((faq, index) => (
      <li
        class:list={[
          'border-t border-[var(--color-border)] py-6',
          index > 0 && 'md:border-l md:pl-8',
          index < faqs.length - 1 && 'md:pr-8',
          columns === 'two' && index % 2 === 0 && 'md:border-l-0 md:pl-0',
          columns === 'three' && index % 3 === 0 && 'md:border-l-0 md:pl-0',
        ]}
      >
        <h3 class="text-base font-semibold text-[var(--color-text)]">
          {faq.question}
        </h3>
        <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
          {faq.answer}
        </p>
      </li>
    ))
  }
</ul>
