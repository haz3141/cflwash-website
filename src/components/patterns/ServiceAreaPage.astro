---
import Button from '../ui/Button.astro'
import BreadcrumbSchema from '../site/BreadcrumbSchema.astro'
import Breadcrumbs from '../site/Breadcrumbs.astro'
import CTASection from './CTASection.astro'
import CityContextMedia from './CityContextMedia.astro'
import FAQList from './FAQList.astro'
import HeroSection from './HeroSection.astro'
import LinkGrid from './LinkGrid.astro'
import MediaFrame from './MediaFrame.astro'
import ProcessSteps from './ProcessSteps.astro'
import Section from '../ui/Section.astro'
import Layout from '../../layouts/Layout.astro'
import { cityContextImages } from '../../data/cityContextImages'
import { serviceAreaFaqAdditions } from '../../data/serviceAreaFaqAdditions'
import type { ServiceAreaPageContent } from '../../data/serviceAreaPages'
import { serviceAreas } from '../../data/serviceAreas'
import { services } from '../../data/services'
import { site } from '../../data/site'
import { ClipboardList, Phone } from '@lucide/astro'

type Props = {
  page: ServiceAreaPageContent
}

const { page } = Astro.props as Props
const area = serviceAreas.find((item) => item.slug === page.slug)

if (!area) {
  throw new Error(`Unknown service area: ${page.slug}`)
}

const cityContextImage = cityContextImages[page.slug]
const faqs = [...page.faqs, ...(serviceAreaFaqAdditions[page.slug] ?? [])]
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: area.name, href: `/service-areas/${area.slug}` },
]
const hasPhone = Boolean(site.phoneDisplay && site.phoneHref)
const serviceLinks = services.map((service) => ({
  label: service.name,
  href: `/${service.slug}`,
  description: service.summary,
}))
const nearbyAreas = page.nearbySlugs.flatMap((slug) => {
  const nearbyArea = serviceAreas.find((item) => item.slug === slug)
  return nearbyArea ? [nearbyArea] : []
})

const quoteSteps = [
  {
    title: 'Name the surfaces',
    description:
      'Share the service address and list every concrete area you want included, along with any HOA notice wording.',
  },
  {
    title: 'Show the property clearly',
    description:
      'Add one wide photo, close views of buildup or staining, and notes about access, coatings, or decorative finishes.',
  },
  {
    title: 'Quote first, scheduling later',
    description:
      'CFL Wash Co. uses those details to prepare the quote. Sending a request does not book a cleaning visit.',
  },
]
---

<Layout
  title={page.seoTitle}
  description={page.seoDescription}
  canonicalPath={`/service-areas/${area.slug}`}
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />
  <main data-city-page>
    <Breadcrumbs items={breadcrumbs} />

    <HeroSection
      variant="split"
      tone="soft"
      eyebrow={`${area.name}, Florida service area`}
      title={`Pressure washing in ${area.name}, FL`}
      description={page.heroDescription}
    >
      <Fragment slot="actions">
        <Button
          href="/request-quote"
          size="lg"
          fullWidth
          class="sm:w-auto"
          data-cta="quote"
          data-cta-location={`service-area-${area.slug}-hero`}
        >
          <ClipboardList
            slot="startIcon"
            class="h-5 w-5"
            aria-hidden="true"
            stroke-width="1.8"
          />
          Request a Quote
        </Button>
        {
          hasPhone ? (
            <Button
              href={site.phoneHref!}
              variant="secondary"
              size="lg"
              fullWidth
              class="sm:w-auto"
              data-cta="call"
              data-cta-location={`service-area-${area.slug}-hero`}
            >
              <Phone
                slot="startIcon"
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
              Call {site.phoneDisplay}
            </Button>
          ) : (
            <Button
              href={`mailto:${site.email}`}
              variant="secondary"
              size="lg"
              fullWidth
              class="sm:w-auto"
              data-cta="email"
              data-cta-location={`service-area-${area.slug}-hero`}
            >
              Email CFL Wash Co.
            </Button>
          )
        }
      </Fragment>

      <MediaFrame
        slot="media"
        media={page.heroMedia}
        imageClass="aspect-[3/2] lg:aspect-[4/3]"
        loading="eager"
        fetchpriority="high"
      />
    </HeroSection>

    <section
      class="border-y border-[var(--color-border)] bg-[var(--color-surface-raised)]"
    >
      <div
        class="mx-auto grid w-full max-w-[var(--container-width)] divide-y divide-[var(--color-border)] px-[var(--container-gutter)] md:grid-cols-3 md:divide-x md:divide-y-0"
      >
        <div class="py-5 md:pr-6">
          <p class="text-sm font-semibold text-[var(--color-text)]">
            Concrete surfaces you can request
          </p>
          <p class="mt-1 text-sm leading-6 text-[var(--color-text-muted)]">
            Driveways, sidewalks, walkways, entries, patios, pads, aprons, and
            curbs.
          </p>
        </div>
        <div class="py-5 md:px-6">
          <p class="text-sm font-semibold text-[var(--color-text)]">
            A few photos are enough to start
          </p>
          <p class="mt-1 text-sm leading-6 text-[var(--color-text-muted)]">
            Show the full area, close marks, access, and any specialty finish.
          </p>
        </div>
        <div class="py-5 md:pl-6">
          <p class="text-sm font-semibold text-[var(--color-text)]">
            Quote first, scheduling later
          </p>
          <p class="mt-1 text-sm leading-6 text-[var(--color-text-muted)]">
            A quote request starts the conversation; it does not book a visit.
          </p>
        </div>
      </div>
    </section>

    <Section
      id="services"
      eyebrow="Services"
      title={`${area.name} service options`}
      description="Choose the service that best matches the main surface. Add connected concrete to the same quote request."
    >
      <div data-city-services>
        <LinkGrid items={serviceLinks} columns="three" density="comfortable" />
      </div>
    </Section>

    <Section
      eyebrow="Common reasons to call"
      title="Why clean the concrete?"
      description="Start with the visible problem: a dark driveway, a marked walkway, an HOA notice, or a front approach that needs attention."
      tone="water"
    >
      <div
        class="grid border-y border-[var(--color-border)] lg:grid-cols-[minmax(0,1.15fr)_minmax(18rem,0.85fr)]"
        data-city-scenarios
      >
        {
          page.reasons.map((reason, index) => (
            <article
              class:list={[
                'min-w-0 py-8',
                index === 0 &&
                  'lg:row-span-2 lg:border-r lg:border-[var(--color-border)] lg:pr-10',
                index > 0 && 'border-t border-[var(--color-border)] lg:pl-10',
                index === 1 && 'lg:border-t-0',
              ]}
            >
              <h3
                class:list={[
                  'font-semibold text-[var(--color-text)]',
                  index === 0 ? 'text-section-subtitle' : 'text-lg',
                ]}
              >
                {reason.title}
              </h3>
              <p
                class:list={[
                  'mt-3 text-[var(--color-text-muted)]',
                  index === 0 ? 'text-base leading-8' : 'text-sm leading-7',
                ]}
              >
                {reason.description}
              </p>
            </article>
          ))
        }
      </div>
    </Section>

    <Section
      eyebrow="Planning the work"
      title={`${area.name}: ${page.localHeading}`}
      description={page.localBody}
      spacing="compact"
      class="border-y border-[var(--color-border)]"
    >
      <div
        class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,0.56fr)] lg:items-start lg:gap-[var(--layout-gap)]"
      >
        <div class="max-w-2xl border-l-2 border-[var(--color-accent)] pl-5">
          <p class="text-base leading-8 text-[var(--color-text-muted)]">
            {page.localNote}
          </p>
        </div>

        <CityContextMedia
          media={cityContextImage}
          variant="compact"
          sizes="(min-width: 1024px) 22rem, 100vw"
          class="w-full max-w-sm justify-self-end"
        />
      </div>
    </Section>

    <Section
      eyebrow="Simple quote process"
      title={`${area.name} quote checklist`}
      description="A short description and useful photos help define the surfaces without turning the request into an inspection form."
      tone="warm"
    >
      <ProcessSteps steps={quoteSteps} cardTone="soft" />
    </Section>

    <Section
      eyebrow="Questions"
      title={`${area.name} quote questions`}
      tone="soft"
    >
      <FAQList faqs={faqs} columns="two" />
    </Section>

    <Section
      eyebrow="Nearby service areas"
      title="Nearby CFL Wash Co. service areas"
      description="Use the page that matches the property address, or include the exact address in your quote request."
      spacing="compact"
      class="border-t border-[var(--color-border)]"
    >
      <div class="flex flex-wrap gap-3">
        {
          nearbyAreas.map((nearbyArea) => (
            <a href={`/service-areas/${nearbyArea.slug}`} class="pill-link">
              {nearbyArea.name}
            </a>
          ))
        }
      </div>
    </Section>

    <CTASection
      tone="inverse"
      eyebrow={`${area.name} service area`}
      title="Ready to request a quote?"
      description="Share the address, concrete surfaces, clear photos, and any HOA notice. That is enough to start the quote."
      titleWidth="wide"
    >
      <Fragment slot="actions">
        <Button
          href="/request-quote"
          variant="light"
          size="lg"
          fullWidth
          class="sm:w-auto"
          data-cta="quote"
          data-cta-location={`service-area-${area.slug}-final`}
        >
          Request a Quote
        </Button>
        {
          hasPhone ? (
            <Button
              href={site.phoneHref!}
              variant="inverseGhost"
              size="lg"
              fullWidth
              class="sm:w-auto"
              data-cta="call"
              data-cta-location={`service-area-${area.slug}-final`}
            >
              <Phone
                slot="startIcon"
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
              Call {site.phoneDisplay}
            </Button>
          ) : (
            <Button
              href={`mailto:${site.email}`}
              variant="inverseGhost"
              size="lg"
              fullWidth
              class="sm:w-auto"
              data-cta="email"
              data-cta-location={`service-area-${area.slug}-final`}
            >
              Email CFL Wash Co.
            </Button>
          )
        }
      </Fragment>
    </CTASection>
  </main>
</Layout>
