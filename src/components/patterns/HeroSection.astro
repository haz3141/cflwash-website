---
import Container from '../ui/Container.astro'

type Variant = 'split' | 'compact'
type Tone = 'default' | 'soft' | 'brand'

type Props = {
  variant?: Variant
  tone?: Tone
  eyebrow?: string
  title: string
  description?: string
}

const {
  variant = 'compact',
  tone = 'default',
  eyebrow,
  title,
  description,
} = Astro.props as Props

const hasMedia = Astro.slots.has('media')
const isSplit = variant === 'split'
const toneClass = {
  default: 'hero-shell hero-shell--default',
  soft: 'hero-shell hero-shell--soft',
  brand: 'hero-shell hero-shell--brand',
}[tone]
const titleClass = isSplit
  ? 'measure-copy text-hero text-[var(--color-text)]'
  : 'measure-copy text-section-title text-[var(--color-text)]'
const descriptionClass = isSplit
  ? 'measure-copy mt-5 text-lead text-[var(--color-text-muted)]'
  : 'measure-copy mt-5 text-lead text-[var(--color-text-muted)]'
const contentClass = [
  isSplit ? 'min-w-0' : '',
  Astro.slots.has('aside')
    ? 'grid gap-10 lg:grid-cols-[minmax(0,1.05fr)_minmax(320px,0.7fr)] lg:items-end'
    : '',
]
  .filter(Boolean)
  .join(' ')
---

<section class={isSplit ? 'overflow-hidden' : undefined}>
  <Container
    class="py-[var(--section-space)] lg:py-[var(--section-space-compact)]"
  >
    <div
      class={`${toneClass} ${isSplit ? 'px-5 py-5 sm:px-8 sm:py-8 lg:px-10' : 'px-5 py-8 sm:px-8 sm:py-10 lg:px-10 lg:py-12'}`.trim()}
    >
      {tone === 'brand' && <div class="hero-shell-art" aria-hidden="true" />}

      <div
        class={`relative min-w-0 ${isSplit ? 'grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(20rem,0.92fr)] lg:items-center lg:gap-[var(--layout-gap)]' : ''}`.trim()}
      >
        <div class={contentClass || undefined}>
          <div>
            {
              eyebrow && (
                <p
                  class={
                    isSplit
                      ? 'text-eyebrow text-[var(--color-action)]'
                      : 'eyebrow-action'
                  }
                >
                  {eyebrow}
                </p>
              )
            }
            <h1 class={`${eyebrow ? 'mt-4' : ''} ${titleClass}`.trim()}>
              {title}
            </h1>
            {description && <p class={descriptionClass}>{description}</p>}
            {
              Astro.slots.has('actions') && (
                <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                  <slot name="actions" />
                </div>
              )
            }
          </div>

          {Astro.slots.has('aside') && <slot name="aside" />}
        </div>

        {
          isSplit && hasMedia && (
            <div class="min-w-0">
              <slot name="media" />
            </div>
          )
        }
      </div>
    </div>
  </Container>
</section>
