---
import Container from '../ui/Container.astro'

type Variant = 'split' | 'compact'
type Tone = 'default' | 'soft'

type Props = {
  variant?: Variant
  tone?: Tone
  eyebrow?: string
  title: string
  description?: string
}

type AutomaticMedia = {
  src: string
  alt: string
  caption: string
}

const {
  variant = 'compact',
  tone = 'default',
  eyebrow,
  title,
  description,
} = Astro.props as Props

const automaticMediaByPath: Record<string, AutomaticMedia> = {
  '/driveway-pressure-washing': {
    src: '/images/services/results/after/driveway-apron-after-wide-01-640.webp',
    alt: 'Clean residential concrete driveway apron and curb after washing',
    caption:
      'A cleaned residential driveway apron and curb. Results vary with surface condition and staining.',
  },
  '/sidewalk-walkway-cleaning': {
    src: '/images/services/results/after/sidewalk-after-wide-01-640.webp',
    alt: 'Clean residential concrete sidewalk through a landscaped neighborhood',
    caption:
      'A cleaned residential sidewalk. Results vary with surface condition and staining.',
  },
  '/concrete-cleaning': {
    src: '/images/services/results/after/curb-gutter-after-wide-01-640.webp',
    alt: 'Clean residential concrete curb and gutter beside a landscaped street',
    caption:
      'A cleaned residential curb and gutter. Results vary with surface condition and staining.',
  },
}

const automaticMedia = automaticMediaByPath[Astro.url.pathname]
const hasMedia = Astro.slots.has('media') || Boolean(automaticMedia)
const isSplit = variant === 'split' || Boolean(automaticMedia)
const toneClass =
  tone === 'soft' || automaticMedia ? 'bg-[var(--color-surface)]' : ''
---

<section class={`${isSplit ? 'overflow-hidden' : ''} ${toneClass}`.trim()}>
  <Container
    class={isSplit
      ? 'grid gap-12 py-[var(--section-space)] lg:grid-cols-[minmax(0,1fr)_minmax(22rem,0.92fr)] lg:items-center lg:py-[var(--section-space-spacious)]'
      : 'py-16 sm:py-20'}
  >
    <div
      class={Astro.slots.has('aside')
        ? 'grid gap-10 lg:grid-cols-[minmax(0,1.05fr)_minmax(320px,0.7fr)] lg:items-end'
        : undefined}
    >
      <div>
        {
          eyebrow && (
            <p
              class={
                isSplit
                  ? 'text-eyebrow text-[var(--color-action)]'
                  : 'eyebrow-action'
              }
            >
              {eyebrow}
            </p>
          )
        }
        <h1
          class={isSplit
            ? 'measure-copy mt-4 text-display text-[var(--color-text)]'
            : 'mt-4 max-w-4xl text-4xl font-semibold leading-tight text-[var(--color-text)] sm:text-5xl'}
        >
          {title}
        </h1>
        {
          description && (
            <p
              class={
                isSplit
                  ? 'measure-copy mt-5 text-lead text-[var(--color-text-muted)]'
                  : 'mt-5 max-w-3xl text-base leading-8 text-[var(--color-text-muted)] sm:text-lg'
              }
            >
              {description}
            </p>
          )
        }
        {
          Astro.slots.has('actions') && (
            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <slot name="actions" />
            </div>
          )
        }
      </div>

      {Astro.slots.has('aside') && <slot name="aside" />}
    </div>

    {
      isSplit &&
        hasMedia &&
        (Astro.slots.has('media') ? (
          <slot name="media" />
        ) : automaticMedia ? (
          <figure class="media-frame shadow-[var(--shadow-xs)]">
            <img
              src={automaticMedia.src}
              alt={automaticMedia.alt}
              width="480"
              height="640"
              class="aspect-[3/4] h-full w-full object-cover"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
            <figcaption class="border-t border-[var(--color-border)] px-4 py-3 text-xs leading-5 text-[var(--color-text-muted)]">
              {automaticMedia.caption}
            </figcaption>
          </figure>
        ) : null)
    }
  </Container>
</section>
