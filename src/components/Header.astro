---
import Button from './Button.astro'
import { site } from '../data/site'
import { services } from '../data/services'
import { serviceAreas } from '../data/serviceAreas'

const serviceLinks = services.map((service) => ({
  label: service.name,
  href: `/${service.slug}`,
}))

const areaLinks = serviceAreas.map((area) => ({
  label: area.name,
  href: `/service-areas/${area.slug}`,
}))
---

<header class="border-b border-slate-200 bg-white">
  <div class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4 px-6 py-4">
    <a href="/" class="text-sm font-semibold tracking-tight text-slate-950">
      {site.name}
    </a>

    <nav class="hidden items-center gap-6 text-sm text-slate-600 md:flex">
      <a href="/request-quote" class="hover:text-slate-950">Request a Quote</a>
      <a href={serviceLinks[0].href} class="hover:text-slate-950">{serviceLinks[0].label}</a>
      <a href={areaLinks[0].href} class="hover:text-slate-950">{areaLinks[0].label}</a>
    </nav>

    <Button href={site.phoneHref} variant="secondary" class="hidden sm:inline-flex">
      Call {site.phoneDisplay}
    </Button>
  </div>
</header>
