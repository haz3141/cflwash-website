---
import Button from './Button.astro'

type Props = {
  title: string
  description: string
  primaryHref: string
  primaryLabel: string
  secondaryHref?: string
  secondaryLabel?: string
}

const {
  title,
  description,
  primaryHref,
  primaryLabel,
  secondaryHref,
  secondaryLabel,
} = Astro.props as Props
---

<section class="mx-auto w-full max-w-6xl px-6">
  <div class="rounded-lg border border-slate-200 bg-slate-50 p-6 sm:p-8">
    <h2 class="text-xl font-semibold tracking-tight text-slate-950 sm:text-2xl">{title}</h2>
    <p class="mt-3 max-w-2xl text-sm leading-7 text-slate-600 sm:text-base">{description}</p>
    <div class="mt-6 flex flex-col gap-3 sm:flex-row">
      <Button href={primaryHref}>{primaryLabel}</Button>
      {secondaryHref && secondaryLabel && (
        <Button href={secondaryHref} variant="secondary">
          {secondaryLabel}
        </Button>
      )}
    </div>
  </div>
</section>
