---
import Container from '../ui/Container.astro'

type BreadcrumbItem = {
  label: string
  href?: string
}

type Props = {
  items: BreadcrumbItem[]
  class?: string
}

const { items, class: className = '' } = Astro.props as Props
const pathname =
  Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/'
const serviceRoutes = new Set([
  '/driveway-pressure-washing',
  '/sidewalk-walkway-cleaning',
  '/concrete-cleaning',
])

let displayItems = items

if (items.length === 2 && items[0]?.href === '/') {
  if (serviceRoutes.has(pathname)) {
    displayItems = [
      items[0],
      { label: 'Services', href: '/services' },
      items[1],
    ]
  } else if (pathname.startsWith('/service-areas/')) {
    displayItems = [
      items[0],
      { label: 'Service Areas', href: '/service-areas' },
      items[1],
    ]
  }
}
---

<nav aria-label="Breadcrumb" class={className}>
  <Container>
    <ol
      class="flex flex-wrap items-center gap-x-2 gap-y-1 py-6 text-sm text-[var(--color-text-muted)]"
    >
      {
        displayItems.map((item, index) => (
          <>
            <li>
              {index < displayItems.length - 1 && item.href ? (
                <a
                  href={item.href}
                  class="transition-colors duration-[var(--duration-fast)] hover:text-[var(--color-text)] focus:outline-none focus-visible:rounded-[var(--radius-sm)] focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-page)]"
                >
                  {item.label}
                </a>
              ) : (
                <span
                  aria-current="page"
                  class="font-medium text-[var(--color-text)]"
                >
                  {item.label}
                </span>
              )}
            </li>
            {index < displayItems.length - 1 && (
              <li aria-hidden="true" class="text-[var(--color-border-strong)]">
                /
              </li>
            )}
          </>
        ))
      }
    </ol>
  </Container>
</nav>
