---
const ga4MeasurementId = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID?.trim()
const cfWebAnalyticsToken =
  import.meta.env.PUBLIC_CF_WEB_ANALYTICS_TOKEN?.trim()
const ga4ConfigScript = ga4MeasurementId
  ? `window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${ga4MeasurementId}', {
  page_location: window.location.origin + window.location.pathname,
});`
  : undefined
const ga4CtaTrackingScript = ga4MeasurementId
  ? `(() => {
  const eventNameByCta = {
    quote: 'quote_click',
    email: 'email_click',
    call: 'call_click',
  };

  document.addEventListener('click', (event) => {
    const ctaElement =
      event.target instanceof Element
        ? event.target.closest('[data-cta]')
        : null;

    if (!ctaElement) {
      return;
    }

    const eventName = eventNameByCta[ctaElement.getAttribute('data-cta') || ''];

    if (!eventName || typeof window.gtag !== 'function') {
      return;
    }

    window.gtag('event', eventName, {
      cta_location: ctaElement.getAttribute('data-cta-location') || '',
      page_path: window.location.pathname,
    });
  });
})();`
  : undefined
---

{
  ga4MeasurementId && (
    <>
      <script
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${ga4MeasurementId}`}
      />
      <script is:inline set:html={ga4ConfigScript} />
      <script is:inline set:html={ga4CtaTrackingScript} />
    </>
  )
}

{
  cfWebAnalyticsToken && (
    <script
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={JSON.stringify({ token: cfWebAnalyticsToken })}
    />
  )
}
