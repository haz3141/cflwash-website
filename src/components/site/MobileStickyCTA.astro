---
import Button from '../ui/Button.astro'
import { site } from '../../data/site'

const hasPhone = Boolean(site.phoneDisplay && site.phoneHref)
---

<div
  class="fixed inset-x-0 bottom-0 z-40 border-t border-[var(--color-border)] bg-[var(--color-background)]/95 p-3 shadow-sm backdrop-blur sm:hidden"
>
  <div class={hasPhone ? 'grid grid-cols-2 gap-3' : undefined}>
    {
      hasPhone && (
        <Button
          href={site.phoneHref}
          variant="secondary"
          class="w-full"
          data-cta="call"
          data-cta-location="mobile-sticky"
        >
          Call
        </Button>
      )
    }
    <Button
      href="/request-quote"
      class="w-full"
      data-cta="quote"
      data-cta-location="mobile-sticky"
    >
      Request a Quote
    </Button>
  </div>
</div>
