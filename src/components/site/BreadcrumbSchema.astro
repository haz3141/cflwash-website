---
import { site } from '../../data/site'
import StructuredData from './StructuredData.astro'

type BreadcrumbItem = {
  label: string
  href: string
}

type Props = {
  items: BreadcrumbItem[]
}

const { items } = Astro.props as Props
const pathname =
  Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/'
const serviceRoutes = new Set([
  '/driveway-pressure-washing',
  '/sidewalk-walkway-cleaning',
  '/concrete-cleaning',
])

let schemaItems = items

if (items.length === 2 && items[0]?.href === '/') {
  if (serviceRoutes.has(pathname)) {
    schemaItems = [items[0], { label: 'Services', href: '/services' }, items[1]]
  } else if (pathname.startsWith('/service-areas/')) {
    schemaItems = [
      items[0],
      { label: 'Service Areas', href: '/service-areas' },
      items[1],
    ]
  }
}

const normalizedItems = schemaItems.map((item, index) => {
  const path =
    item.href === '/'
      ? ''
      : item.href.startsWith('/')
        ? item.href
        : `/${item.href}`

  return {
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: `${site.url}${path}`,
  }
})

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: normalizedItems,
}
---

<StructuredData value={schema} />
