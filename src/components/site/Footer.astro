---
import { serviceAreas } from '../../data/serviceAreas'
import { services } from '../../data/services'
import { site } from '../../data/site'

const unlinkedServiceAreas = ['DeLand', 'Sanford', 'Lake Mary']
---

<footer class="border-t border-[var(--color-border)] bg-[var(--color-surface)]">
  <div
    class="mx-auto grid w-full max-w-[var(--container-width)] gap-8 px-6 py-10 md:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)_minmax(0,0.8fr)]"
  >
    <div>
      <a
        href="/"
        aria-label={`${site.name} home`}
        class="inline-flex focus:outline-none focus-visible:rounded-[var(--radius-sm)] focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring)] focus-visible:ring-offset-2"
      >
        <img
          src="/images/brand/logo-primary.png"
          alt=""
          width="1280"
          height="500"
          class="h-14 w-auto max-w-[14rem] object-contain"
          loading="lazy"
          decoding="async"
        />
      </a>
      <p class="mt-3 max-w-sm text-sm leading-6 text-[var(--color-text-muted)]">
        Driveway, sidewalk, walkway, and concrete cleaning for Central Florida
        curb appeal.
      </p>
      <p class="mt-4 text-sm text-[var(--color-text-muted)]">
        <a
          href={`mailto:${site.email}`}
          data-cta="email"
          data-cta-location="footer"
          class="hover:text-[var(--color-text)]"
        >
          {site.email}
        </a>
      </p>
    </div>

    <div>
      <p class="text-sm font-semibold text-[var(--color-text)]">Services</p>
      <ul class="mt-3 space-y-2 text-sm text-[var(--color-text-muted)]">
        {
          services.map((service) => (
            <li>
              <a
                href={`/${service.slug}`}
                class="hover:text-[var(--color-text)]"
              >
                {service.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold text-[var(--color-text)]">
        Service Areas
      </p>
      <ul class="mt-3 space-y-2 text-sm text-[var(--color-text-muted)]">
        {
          serviceAreas.map((area) => (
            <li>
              <a
                href={`/service-areas/${area.slug}`}
                class="hover:text-[var(--color-text)]"
              >
                {area.name}
              </a>
            </li>
          ))
        }
        {
          unlinkedServiceAreas.map((area) => (
            <li>
              <span>{area}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-[var(--color-border)]">
    <div
      class="mx-auto flex w-full max-w-[var(--container-width)] flex-col gap-2 px-6 py-4 text-sm text-[var(--color-text-muted)] sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {new Date().getFullYear()} {site.legalName}</p>
      <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-4">
        <p>Serving Central Florida</p>
        <a href="/privacy" class="hover:text-[var(--color-text)]">
          Privacy Notice
        </a>
      </div>
    </div>
  </div>
</footer>
