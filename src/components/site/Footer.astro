---
import Button from '../ui/Button.astro'
import Container from '../ui/Container.astro'
import { Mail, MapPin, ClipboardList, Phone } from '@lucide/astro'
import { serviceAreas } from '../../data/serviceAreas'
import { services } from '../../data/services'
import { site } from '../../data/site'

const unlinkedServiceAreas = ['Lake Mary']
---

<footer
  class="border-t border-white/10 bg-[var(--color-surface-inverse)] text-[var(--color-text-inverse)]"
>
  <Container
    as="div"
    class="grid gap-10 py-[var(--section-space-compact)] md:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)_minmax(0,0.9fr)] lg:gap-12"
  >
    <div class="space-y-5">
      <a
        href="/"
        aria-label={`${site.name} home`}
        class="inline-flex rounded-[var(--radius-sm)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring-inverse)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-surface-inverse)]"
      >
        <img
          src="/images/brand/responsive/logo-primary-reversed-320.png"
          srcset="
            /images/brand/responsive/logo-primary-reversed-320.png 1x,
            /images/brand/responsive/logo-primary-reversed-480.png 2x
          "
          alt=""
          width="320"
          height="146"
          class="h-16 w-auto max-w-[14.5rem] object-contain"
          loading="lazy"
          decoding="async"
        />
      </a>
      <p class="max-w-sm text-sm leading-6 text-white/78">
        Driveway, sidewalk, walkway, and concrete cleaning for Central Florida
        curb appeal.
      </p>
      <div class="space-y-3 text-sm">
        <a
          href={site.phoneHref}
          data-cta="call"
          data-cta-location="footer"
          class="inline-flex items-center gap-2 transition-colors duration-[var(--duration-fast)] hover:text-white focus:outline-none focus-visible:rounded-[var(--radius-sm)] focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring-inverse)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-surface-inverse)]"
        >
          <Phone class="h-4 w-4" aria-hidden="true" stroke-width="1.8" />
          {site.phoneDisplay}
        </a>
        <a
          href={`mailto:${site.email}`}
          data-cta="email"
          data-cta-location="footer"
          class="inline-flex items-center gap-2 transition-colors duration-[var(--duration-fast)] hover:text-white focus:outline-none focus-visible:rounded-[var(--radius-sm)] focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring-inverse)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-surface-inverse)]"
        >
          <Mail class="h-4 w-4" aria-hidden="true" stroke-width="1.8" />
          {site.email}
        </a>
        <div class="flex items-center gap-2 text-white/72">
          <MapPin class="h-4 w-4" aria-hidden="true" stroke-width="1.8" />
          <span>Serving Central Florida</span>
        </div>
      </div>
      <Button
        href="/request-quote"
        variant="inverse"
        size="sm"
        data-cta="quote"
        data-cta-location="footer"
      >
        <ClipboardList
          slot="startIcon"
          class="h-5 w-5"
          aria-hidden="true"
          stroke-width="1.8"
        />
        Request a Quote
      </Button>
    </div>

    <div>
      <p class="text-sm font-semibold text-[var(--color-text-inverse)]">
        Services
      </p>
      <ul class="mt-4 space-y-2 text-sm text-white/74">
        {
          services.map((service) => (
            <li>
              <a
                href={`/${service.slug}`}
                class="transition-colors duration-[var(--duration-fast)] hover:text-white focus:outline-none focus-visible:rounded-[var(--radius-sm)] focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring-inverse)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-surface-inverse)]"
              >
                {service.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold text-[var(--color-text-inverse)]">
        Service Areas
      </p>
      <ul class="mt-4 space-y-2 text-sm text-white/74">
        {
          serviceAreas.map((area) => (
            <li>
              <a
                href={`/service-areas/${area.slug}`}
                class="transition-colors duration-[var(--duration-fast)] hover:text-white focus:outline-none focus-visible:rounded-[var(--radius-sm)] focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring-inverse)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-surface-inverse)]"
              >
                {area.name}
              </a>
            </li>
          ))
        }
        {
          unlinkedServiceAreas.map((area) => (
            <li class="text-white/48">
              <span>{area}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>

  <div class="border-t border-white/10">
    <Container
      as="div"
      class="flex flex-col gap-2 py-4 text-sm text-white/62 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {new Date().getFullYear()} {site.legalName}</p>
      <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-4">
        <a
          href="/privacy"
          class="transition-colors duration-[var(--duration-fast)] hover:text-white focus:outline-none focus-visible:rounded-[var(--radius-sm)] focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring-inverse)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-surface-inverse)]"
        >
          Privacy Notice
        </a>
      </div>
    </Container>
  </div>
</footer>
