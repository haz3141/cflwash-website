---
import Button from '../ui/Button.astro'
import Container from '../ui/Container.astro'
import { ArrowRight, Mail, MapPin, Phone } from '@lucide/astro'
import { services } from '../../data/services'
import { site } from '../../data/site'

const companyLinks = [
  { label: 'Why Choose Us', href: '/#why-cfl-wash' },
  { label: 'Our Process', href: '/#our-process' },
  { label: 'Service Areas', href: '/service-areas' },
  { label: 'Contact', href: '/request-quote' },
  { label: 'Privacy', href: '/privacy' },
]
---

<footer
  class="border-t border-white/10 bg-[var(--color-surface-inverse)] text-[var(--color-text-inverse)]"
>
  <Container
    as="div"
    class="grid gap-9 py-12 sm:grid-cols-2 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.8fr)_minmax(0,0.8fr)_minmax(0,1fr)] lg:gap-12"
  >
    <div>
      <a
        href="/"
        aria-label={`${site.name} home`}
        class="inline-flex rounded-[var(--radius-sm)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring-inverse)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-surface-inverse)]"
      >
        <img
          src="/images/brand/responsive/logo-primary-reversed-320.png"
          srcset="/images/brand/responsive/logo-primary-reversed-320.png 1x, /images/brand/responsive/logo-primary-reversed-480.png 2x"
          alt=""
          width="320"
          height="146"
          class="h-14 w-auto max-w-[13rem] object-contain"
          loading="lazy"
          decoding="async"
        />
      </a>
      <p class="mt-4 max-w-xs text-sm leading-6 text-white/72">
        Exterior cleaning made easy across Central Florida, with a focused
        launch scope for driveways, sidewalks, walkways, and concrete.
      </p>
      <div class="mt-5 space-y-2.5 text-sm text-white/72">
        <a
          href={site.phoneHref}
          data-cta="call"
          data-cta-location="footer"
          class="flex items-center gap-2 transition-colors hover:text-white focus:outline-none focus-visible:rounded-[var(--radius-sm)] focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring-inverse)]"
        >
          <Phone class="h-4 w-4" aria-hidden="true" stroke-width="1.8" />
          {site.phoneDisplay}
        </a>
        <a
          href={`mailto:${site.email}`}
          data-cta="email"
          data-cta-location="footer"
          class="flex items-center gap-2 transition-colors hover:text-white focus:outline-none focus-visible:rounded-[var(--radius-sm)] focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring-inverse)]"
        >
          <Mail class="h-4 w-4" aria-hidden="true" stroke-width="1.8" />
          {site.email}
        </a>
        <p class="flex items-center gap-2">
          <MapPin class="h-4 w-4" aria-hidden="true" stroke-width="1.8" />
          Proudly serving Central Florida
        </p>
      </div>
    </div>

    <div>
      <a
        href="/services"
        class="text-xs font-bold uppercase tracking-[0.12em] text-white transition-colors hover:text-[var(--color-accent)]"
      >
        Services
      </a>
      <ul class="mt-4 space-y-2 text-sm text-white/68">
        {
          services.map((service) => (
            <li>
              <a
                href={`/${service.slug}`}
                class="transition-colors hover:text-white focus:outline-none focus-visible:rounded-[var(--radius-sm)] focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring-inverse)]"
              >
                {service.name}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/request-quote" class="transition-colors hover:text-white">
            HOA Notice Cleanup
          </a>
        </li>
        <li>
          <a href="/request-quote" class="transition-colors hover:text-white">
            Curb Appeal Cleanup
          </a>
        </li>
      </ul>
    </div>

    <div>
      <p class="text-xs font-bold uppercase tracking-[0.12em] text-white">
        Company
      </p>
      <ul class="mt-4 space-y-2 text-sm text-white/68">
        {
          companyLinks.map((item) => (
            <li>
              <a
                href={item.href}
                class="transition-colors hover:text-white focus:outline-none focus-visible:rounded-[var(--radius-sm)] focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring-inverse)]"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="text-xs font-bold uppercase tracking-[0.12em] text-white">
        Get a Free Quote
      </p>
      <p class="mt-4 text-sm leading-6 text-white/68">
        Share the city, surfaces, photos, access notes, and any HOA wording that
        helps explain the request.
      </p>
      <Button
        href="/request-quote"
        variant="accent"
        size="sm"
        class="mt-5"
        data-cta="quote"
        data-cta-location="footer"
      >
        Get a Free Quote
        <ArrowRight
          slot="endIcon"
          class="h-4 w-4"
          aria-hidden="true"
          stroke-width="1.8"
        />
      </Button>
    </div>
  </Container>

  <div class="border-t border-white/10">
    <Container
      as="div"
      class="flex flex-col gap-2 py-4 text-xs text-white/56 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {new Date().getFullYear()} {site.legalName}. All rights reserved.</p>
      <p>Proudly serving Central Florida</p>
    </Container>
  </div>
</footer>
