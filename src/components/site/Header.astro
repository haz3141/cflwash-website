---
import Button from '../ui/Button.astro'
import Container from '../ui/Container.astro'
import { site } from '../../data/site'
import { ClipboardList, Menu, Phone, X } from '@lucide/astro'

const hasPhone = Boolean(site.phoneDisplay && site.phoneHref)
---

<header
  class="sticky top-0 z-30 border-b border-[var(--color-border)] bg-[var(--color-page)]/95 shadow-[var(--shadow-xs)] backdrop-blur supports-[backdrop-filter]:bg-[var(--color-page)]/90"
>
  <Container
    as="div"
    class="relative flex items-center justify-between gap-4 py-3 sm:py-4"
  >
    <a
      href="/"
      aria-label={`${site.name} home`}
      class="block shrink-0 rounded-[var(--radius-sm)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-page)]"
    >
      <img
        src="/images/brand/logo-primary-header-transparent.png"
        alt=""
        width="1419"
        height="648"
        class="h-12 w-auto max-w-[10.5rem] object-contain sm:h-[3.25rem] sm:max-w-[12.5rem] lg:h-[3.375rem] lg:max-w-[13.5rem]"
        decoding="async"
        fetchpriority="high"
      />
    </a>

    <details class="group relative shrink-0 lg:hidden">
      <summary
        aria-controls="mobile-navigation-panel"
        data-mobile-nav-trigger
        class="flex h-11 w-11 list-none items-center justify-center rounded-[var(--radius-md)] border border-[var(--color-border)] bg-[var(--color-page)] text-[var(--color-text)] shadow-[var(--shadow-xs)] transition-colors duration-[var(--duration-fast)] hover:bg-[var(--color-surface)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-page)] [&::-webkit-details-marker]:hidden"
      >
        <Menu
          class="h-5 w-5 group-open:hidden"
          aria-hidden="true"
          stroke-width="1.8"
        />
        <X
          class="hidden h-5 w-5 group-open:block"
          aria-hidden="true"
          stroke-width="1.8"
        />
        <span class="sr-only group-open:hidden">Open navigation menu</span>
        <span class="sr-only hidden group-open:inline"
          >Close navigation menu</span
        >
      </summary>

      <div
        class="absolute right-0 top-full z-40 pt-3 w-[calc(100vw-1.5rem)] max-w-sm"
      >
        <div
          id="mobile-navigation-panel"
          data-mobile-nav-panel
          class="overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-page)] shadow-[var(--shadow-sm)]"
        >
          <nav
            aria-label="Mobile navigation"
            class="divide-y divide-[var(--color-border)]"
          >
            <a
              href="/#services"
              class="flex min-h-11 items-center px-4 py-3 text-sm font-medium text-[var(--color-text)] transition-colors duration-[var(--duration-fast)] hover:bg-[var(--color-surface)] focus:outline-none focus-visible:bg-[var(--color-surface)] focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[var(--color-focus-ring)]"
              >Services</a
            >
            <a
              href="/#service-areas"
              class="flex min-h-11 items-center px-4 py-3 text-sm font-medium text-[var(--color-text)] transition-colors duration-[var(--duration-fast)] hover:bg-[var(--color-surface)] focus:outline-none focus-visible:bg-[var(--color-surface)] focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[var(--color-focus-ring)]"
              >Service Areas</a
            >
          </nav>

          <div class="border-t border-[var(--color-border)] p-2">
            <div class="grid gap-2">
              <Button
                href="/request-quote"
                size="sm"
                fullWidth
                data-cta="quote"
                data-cta-location="mobile-header-menu"
              >
                <ClipboardList
                  slot="startIcon"
                  class="h-5 w-5"
                  aria-hidden="true"
                  stroke-width="1.8"
                />
                Request a Quote
              </Button>

              {
                hasPhone && (
                  <Button
                    href={site.phoneHref}
                    variant="secondary"
                    size="sm"
                    fullWidth
                    data-cta="call"
                    data-cta-location="mobile-header-menu"
                    class="whitespace-nowrap"
                  >
                    <Phone
                      slot="startIcon"
                      class="h-5 w-5"
                      aria-hidden="true"
                      stroke-width="1.8"
                    />
                    Call {site.phoneDisplay}
                  </Button>
                )
              }
            </div>
          </div>
        </div>
      </div>
    </details>

    <nav
      class="hidden items-center gap-6 text-sm font-medium text-[var(--color-text-muted)] lg:flex"
    >
      <a
        href="/#services"
        class="transition-colors duration-[var(--duration-fast)] hover:text-[var(--color-text)] focus:outline-none focus-visible:rounded-[var(--radius-sm)] focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-page)]"
        >Services</a
      >
      <a
        href="/#service-areas"
        class="transition-colors duration-[var(--duration-fast)] hover:text-[var(--color-text)] focus:outline-none focus-visible:rounded-[var(--radius-sm)] focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-page)]"
        >Service Areas</a
      >
      <a
        href="/request-quote"
        data-cta="quote"
        data-cta-location="header-nav"
        class="transition-colors duration-[var(--duration-fast)] hover:text-[var(--color-text)] focus:outline-none focus-visible:rounded-[var(--radius-sm)] focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-page)]"
        >Request a Quote</a
      >
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      {
        hasPhone && (
          <Button
            href={site.phoneHref}
            variant="secondary"
            size="sm"
            data-cta="call"
            data-cta-location="header"
            aria-label={`Call ${site.phoneDisplay}`}
          >
            <Phone
              slot="startIcon"
              class="h-5 w-5"
              aria-hidden="true"
              stroke-width="1.8"
            />
            Call
          </Button>
        )
      }
      <Button
        href="/request-quote"
        size="sm"
        data-cta="quote"
        data-cta-location="header"
      >
        <ClipboardList
          slot="startIcon"
          class="h-5 w-5"
          aria-hidden="true"
          stroke-width="1.8"
        />
        Request a Quote
      </Button>
    </div>
  </Container>
</header>

<script is:inline>
  const mobileNav = document
    .querySelector('[data-mobile-nav-trigger]')
    ?.closest('details')

  if (mobileNav instanceof HTMLDetailsElement) {
    const trigger = mobileNav.querySelector('[data-mobile-nav-trigger]')
    const panel = mobileNav.querySelector('[data-mobile-nav-panel]')

    const closeMenu = (focusTrigger = false) => {
      mobileNav.open = false

      if (focusTrigger && trigger instanceof HTMLElement) {
        trigger.focus()
      }
    }

    panel?.addEventListener('click', (event) => {
      const target = event.target

      if (target instanceof Element && target.closest('a')) {
        closeMenu()
      }
    })

    document.addEventListener('pointerdown', (event) => {
      if (!mobileNav.open) return

      const target = event.target

      if (target instanceof Node && !mobileNav.contains(target)) {
        closeMenu()
      }
    })

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !mobileNav.open) return

      event.preventDefault()
      closeMenu(true)
    })
  }
</script>
