---
import Button from '../ui/Button.astro'
import Container from '../ui/Container.astro'
import { site } from '../../data/site'
import { ArrowRight, ClipboardList, Menu, Phone, X } from '@lucide/astro'

const hasPhone = Boolean(site.phoneDisplay && site.phoneHref)

const navigation = [
  { label: 'Services', href: '/services' },
  { label: 'Why Choose Us', href: '/#why-cfl-wash' },
  { label: 'Our Process', href: '/#our-process' },
  { label: 'Service Areas', href: '/service-areas' },
  { label: 'Contact', href: '/request-quote' },
]
---

<header
  class="sticky top-0 z-30 border-b border-white/10 bg-[var(--color-surface-inverse)]/96 text-white shadow-[var(--shadow-xs)] backdrop-blur supports-[backdrop-filter]:bg-[var(--color-surface-inverse)]/92"
>
  <Container
    as="div"
    class="relative flex items-center justify-between gap-4 py-2.5 sm:py-3"
  >
    <a
      href="/"
      aria-label={`${site.name} home`}
      class="block shrink-0 rounded-[var(--radius-sm)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring-inverse)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-surface-inverse)]"
    >
      <img
        src="/images/brand/responsive/logo-primary-reversed-320.png"
        srcset="/images/brand/responsive/logo-primary-reversed-320.png 1x, /images/brand/responsive/logo-primary-reversed-480.png 2x"
        alt=""
        width="320"
        height="146"
        class="h-10 w-auto max-w-[10.5rem] object-contain sm:h-11 sm:max-w-[11.5rem]"
        decoding="async"
      />
    </a>

    <details class="group relative shrink-0 lg:hidden">
      <summary
        aria-controls="mobile-navigation-panel"
        data-mobile-nav-trigger
        class="flex h-11 w-11 list-none items-center justify-center rounded-[var(--radius-md)] border border-white/20 bg-white/8 text-white transition-colors duration-[var(--duration-fast)] hover:bg-white/14 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring-inverse)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-surface-inverse)] [&::-webkit-details-marker]:hidden"
      >
        <Menu
          class="h-5 w-5 group-open:hidden"
          aria-hidden="true"
          stroke-width="1.8"
        />
        <X
          class="hidden h-5 w-5 group-open:block"
          aria-hidden="true"
          stroke-width="1.8"
        />
        <span class="sr-only group-open:hidden">Open navigation menu</span>
        <span class="sr-only hidden group-open:inline"
          >Close navigation menu</span
        >
      </summary>

      <div
        class="absolute right-0 top-full z-40 w-[calc(100vw-2rem)] max-w-sm pt-3"
      >
        <div
          id="mobile-navigation-panel"
          data-mobile-nav-panel
          class="overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-white text-[var(--color-text)] shadow-[var(--shadow-sm)]"
        >
          <nav
            aria-label="Mobile navigation"
            class="divide-y divide-[var(--color-border)]"
          >
            {
              navigation.map((item) => (
                <a
                  href={item.href}
                  class="flex min-h-11 items-center px-4 py-3 text-sm font-medium transition-colors duration-[var(--duration-fast)] hover:bg-[var(--color-surface)] focus:outline-none focus-visible:bg-[var(--color-surface)] focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[var(--color-focus-ring)]"
                >
                  {item.label}
                </a>
              ))
            }
          </nav>

          <div class="border-t border-[var(--color-border)] p-3">
            <div class="grid gap-2">
              <Button
                href="/request-quote"
                variant="accent"
                size="sm"
                fullWidth
                data-cta="quote"
                data-cta-location="mobile-header-menu"
              >
                <ClipboardList
                  slot="startIcon"
                  class="h-5 w-5"
                  aria-hidden="true"
                  stroke-width="1.8"
                />
                Get a Free Quote
              </Button>

              {
                hasPhone && (
                  <Button
                    href={site.phoneHref}
                    variant="secondary"
                    size="sm"
                    fullWidth
                    data-cta="call"
                    data-cta-location="mobile-header-menu"
                    class="whitespace-nowrap"
                  >
                    <Phone
                      slot="startIcon"
                      class="h-5 w-5"
                      aria-hidden="true"
                      stroke-width="1.8"
                    />
                    Call {site.phoneDisplay}
                  </Button>
                )
              }
            </div>
          </div>
        </div>
      </div>
    </details>

    <nav
      class="hidden items-center gap-5 text-[0.67rem] font-bold uppercase tracking-[0.1em] text-white/72 lg:flex xl:gap-7"
    >
      {
        navigation.map((item) => (
          <a
            href={item.href}
            class="whitespace-nowrap transition-colors duration-[var(--duration-fast)] hover:text-white focus:outline-none focus-visible:rounded-[var(--radius-sm)] focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring-inverse)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-surface-inverse)]"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-2 lg:flex">
      {
        hasPhone && (
          <a
            href={site.phoneHref}
            data-cta="call"
            data-cta-location="header"
            aria-label={`Call ${site.phoneDisplay}`}
            class="inline-flex min-h-10 items-center gap-2 rounded-[var(--radius-md)] px-2.5 text-xs font-semibold text-white/78 transition-colors hover:bg-white/8 hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring-inverse)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-surface-inverse)] xl:px-3"
          >
            <Phone class="h-4 w-4" aria-hidden="true" stroke-width="1.8" />
            Call
          </a>
        )
      }
      <a
        href="/request-quote"
        data-cta="quote"
        data-cta-location="header"
        class="inline-flex min-h-10 items-center justify-center gap-2 rounded-[var(--radius-sm)] bg-[var(--color-accent)] px-4 py-2 text-xs font-bold text-[var(--color-surface-inverse)] shadow-[var(--shadow-action)] transition-colors hover:bg-[var(--color-accent-hover)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring-inverse)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-surface-inverse)] xl:px-5"
      >
        Get a Free Quote
        <ArrowRight class="h-4 w-4" aria-hidden="true" stroke-width="1.8" />
      </a>
    </div>
  </Container>
</header>

<script is:inline>
  const mobileNav = document
    .querySelector('[data-mobile-nav-trigger]')
    ?.closest('details')

  if (mobileNav instanceof HTMLDetailsElement) {
    const trigger = mobileNav.querySelector('[data-mobile-nav-trigger]')
    const panel = mobileNav.querySelector('[data-mobile-nav-panel]')

    const closeMenu = (focusTrigger = false) => {
      mobileNav.open = false

      if (focusTrigger && trigger instanceof HTMLElement) {
        trigger.focus()
      }
    }

    panel?.addEventListener('click', (event) => {
      const target = event.target

      if (target instanceof Element && target.closest('a')) {
        closeMenu()
      }
    })

    document.addEventListener('pointerdown', (event) => {
      if (!mobileNav.open) return

      const target = event.target

      if (target instanceof Node && !mobileNav.contains(target)) {
        closeMenu()
      }
    })

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !mobileNav.open) return

      event.preventDefault()
      closeMenu(true)
    })
  }
</script>
