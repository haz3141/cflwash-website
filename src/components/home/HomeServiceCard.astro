---
import IconBadge from '../ui/IconBadge.astro'
import { ArrowRight } from '@lucide/astro'

type Props = {
  title: string
  description: string
  href: string
  image: string
  alt: string
  icon: any
  label?: string
}

const {
  title,
  description,
  href,
  image,
  alt,
  icon,
  label = 'Service',
} = Astro.props as Props
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-white shadow-[var(--shadow-xs)] transition duration-[var(--duration-normal)] ease-[var(--ease-standard)] hover:-translate-y-1 hover:shadow-[var(--shadow-sm)]"
>
  <a
    href={href}
    class="relative block overflow-hidden focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[var(--color-focus-ring)]"
    aria-label={`View ${title}`}
  >
    <img
      src={image}
      alt={alt}
      width="480"
      height="640"
      loading="lazy"
      decoding="async"
      class="aspect-[4/3] w-full object-cover transition duration-500 ease-[var(--ease-emphasis)] group-hover:scale-[1.025]"
    />
    <span
      class="absolute left-4 top-4 rounded-full bg-[var(--color-surface-inverse)]/90 px-3 py-1 text-[0.68rem] font-bold uppercase tracking-[0.16em] text-white backdrop-blur"
    >
      {label}
    </span>
  </a>

  <div class="relative flex flex-1 flex-col px-5 pb-5 pt-8">
    <IconBadge
      icon={icon}
      tone="inverse"
      size="lg"
      class="absolute -top-6 left-5 bg-[var(--color-surface-inverse)] text-[var(--color-accent)] ring-4 ring-white"
    />
    <h3 class="text-lg font-semibold leading-6 text-[var(--color-text)]">
      <a
        href={href}
        class="rounded-[var(--radius-sm)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring)] focus-visible:ring-offset-2"
      >
        {title}
      </a>
    </h3>
    <p class="mt-3 flex-1 text-sm leading-6 text-[var(--color-text-muted)]">
      {description}
    </p>
    <a
      href={href}
      class="mt-5 inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.12em] text-[var(--color-action)] transition-colors hover:text-[var(--color-action-hover)] focus:outline-none focus-visible:rounded-[var(--radius-sm)] focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring)] focus-visible:ring-offset-2"
    >
      Learn more
      <ArrowRight class="h-4 w-4" aria-hidden="true" stroke-width="1.8" />
    </a>
  </div>
</article>
