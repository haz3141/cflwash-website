---
import {
  ArrowRight,
  CalendarCheck2,
  House,
  MapPin,
  Phone,
  ShieldCheck,
  Sparkles,
} from '@lucide/astro'
import { publicMedia } from '../../data/publicMedia'
import { site } from '../../data/site'
import Button from '../ui/Button.astro'
import IconBadge from '../ui/IconBadge.astro'

const hasPhone = Boolean(site.phoneDisplay && site.phoneHref)

const heroBenefits = [
  { icon: Sparkles, title: 'Cleaner curb appeal' },
  { icon: House, title: 'HOA notice support' },
  { icon: ShieldCheck, title: 'Concrete-focused service' },
  { icon: CalendarCheck2, title: 'Clear next steps' },
]

const serviceTiles = [
  { label: 'Driveways', media: publicMedia.serviceDriveway, kind: 'main' },
  { label: 'Sidewalks', media: publicMedia.serviceWalkway, kind: 'side' },
  { label: 'Patios', media: publicMedia.serviceConcrete, kind: 'side' },
] as const

const responsiveSources = (media: (typeof serviceTiles)[number]['media']) =>
  media.image.sources.map(({ src, width }) => `${src} ${width}w`).join(', ')
---

<section
  data-home-hero
  class="relative overflow-hidden bg-[var(--color-surface-warm)] pb-5 pt-6 sm:pb-8 sm:pt-10 min-[60rem]:pb-12 min-[60rem]:pt-14"
>
  <div
    class="hero-art-panel pointer-events-none absolute inset-0 opacity-45"
    aria-hidden="true"
  >
  </div>

  <div
    class="home-hero-layout relative mx-auto w-full max-w-[82rem] px-[var(--container-gutter)]"
  >
    <div
      class="home-hero-copy flex flex-col items-center text-center min-[60rem]:items-start min-[60rem]:text-left"
    >
      <p class="text-eyebrow text-[var(--color-accent)]">
        Central Florida Pressure Washing
      </p>
      <h1
        class="mt-3 max-w-[17ch] text-[clamp(2.15rem,8.8vw,3.25rem)] font-semibold leading-[1.02] tracking-[-0.04em] text-[var(--color-text)] min-[60rem]:max-w-[13ch] min-[60rem]:text-[clamp(3.25rem,4.8vw,4.75rem)] min-[60rem]:leading-[0.98]"
      >
        Driveway and Concrete Cleaning in Central Florida
      </h1>
      <p
        class="mt-4 max-w-[42rem] text-base leading-7 text-[var(--color-text-muted)] sm:text-lg sm:leading-8 min-[60rem]:max-w-[36rem]"
      >
        Driveways, sidewalks, walkways, patios, and other residential
        concrete—cleaned through a clear, quote-first process.
      </p>

      <div
        class="mt-6 flex w-full flex-col gap-3 sm:w-auto sm:flex-row sm:justify-center min-[60rem]:justify-start"
      >
        <Button
          href="/request-quote"
          variant="accent"
          size="lg"
          fullWidth
          class="sm:w-auto"
          data-cta="quote"
          data-cta-location="home-hero"
        >
          Request a Quote
          <ArrowRight
            slot="endIcon"
            class="h-5 w-5"
            aria-hidden="true"
            stroke-width="1.8"
          />
        </Button>
        {
          hasPhone && (
            <Button
              href={site.phoneHref}
              variant="light"
              size="lg"
              fullWidth
              class="sm:w-auto"
              data-cta="call"
              data-cta-location="home-hero"
            >
              Call
              <Phone
                slot="endIcon"
                class="h-4 w-4"
                aria-hidden="true"
                stroke-width="1.8"
              />
            </Button>
          )
        }
      </div>
    </div>

    <div
      class="home-hero-visual hero-mosaic-container mx-auto w-full max-w-[38rem] min-[60rem]:max-w-none"
      role="group"
      aria-label="Exterior cleaning service surfaces"
    >
      <div class="hero-mosaic-grid">
        {
          serviceTiles.map((tile) => (
            <div
              class={
                tile.kind === 'main' ? 'mosaic-card-main' : 'mosaic-card-side'
              }
              data-media-id={tile.media.id}
              data-media-role={tile.media.role}
              data-proof-status={tile.media.proofStatus}
            >
              <img
                src={tile.media.image.src}
                srcset={responsiveSources(tile.media)}
                sizes={
                  tile.kind === 'main'
                    ? '(min-width: 960px) 29vw, (min-width: 768px) 54vw, 62vw'
                    : '(min-width: 960px) 15vw, (min-width: 768px) 25vw, 30vw'
                }
                alt={tile.media.alt}
                width={tile.media.image.width}
                height={tile.media.image.height}
                loading={tile.kind === 'main' ? 'eager' : 'lazy'}
                decoding="async"
                fetchpriority={tile.kind === 'main' ? 'high' : 'auto'}
                class="h-full w-full object-cover"
              />
              <span class="mosaic-label bottom-2 left-2 sm:bottom-3 sm:left-3">
                {tile.label}
              </span>
              {tile.kind === 'main' && (
                <span class="mosaic-label hero-mosaic-hoa left-2 top-2 sm:left-3 sm:top-3">
                  HOA cleanup
                </span>
              )}
            </div>
          ))
        }
      </div>

      <img
        src="/images/brand/logo-mark-transparent.png"
        alt=""
        width="640"
        height="640"
        loading="eager"
        decoding="async"
        class="hero-mosaic-seal absolute bottom-2 right-2 z-10 h-14 w-14 object-contain sm:h-16 sm:w-16 min-[60rem]:h-20 min-[60rem]:w-20"
      />
    </div>

    <ul
      class="home-hero-benefits grid w-full grid-cols-2 gap-4 sm:grid-cols-4 min-[60rem]:grid-cols-2"
      aria-label="Quote and service benefits"
    >
      {
        heroBenefits.map((benefit) => (
          <li class="flex items-center gap-3 text-left">
            <IconBadge
              icon={benefit.icon}
              tone="default"
              size="lg"
              class="theme-shadow-xs shrink-0 text-[var(--color-action)]"
            />
            <span class="text-xs font-semibold leading-4 text-[var(--color-text)]">
              {benefit.title}
            </span>
          </li>
        ))
      }
    </ul>

    <p
      class="home-hero-serving flex items-center justify-center gap-2 text-sm font-semibold text-[var(--color-text)] min-[60rem]:justify-start"
    >
      <MapPin
        class="h-4 w-4 text-[var(--color-action)]"
        aria-hidden="true"
        stroke-width="1.8"
      />
      Serving Central Florida
    </p>
  </div>
</section>
