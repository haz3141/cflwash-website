---
import Container from './Container.astro'
import SectionHeader from './SectionHeader.astro'

type Spacing = 'compact' | 'default' | 'spacious' | 'none'
type Tone = 'default' | 'soft' | 'warm' | 'inverse'
type ContentWidth = 'narrow' | 'default' | 'wide' | 'full'

type Props = {
  id?: string
  eyebrow?: string
  title?: string
  description?: string
  spacing?: Spacing
  tone?: Tone
  contentWidth?: ContentWidth
  class?: string
}

const {
  id,
  eyebrow,
  title,
  description,
  spacing = 'default',
  tone = 'default',
  contentWidth = 'full',
  class: className = '',
} = Astro.props as Props

const hasHeader = Boolean(eyebrow || title || description)

const spacingClasses: Record<Spacing, string> = {
  compact: 'py-[var(--section-space-compact)]',
  default: 'py-[var(--section-space)]',
  spacious: 'py-[var(--section-space-spacious)]',
  none: '',
}

const toneClasses: Record<Tone, string> = {
  default: '',
  soft: 'bg-[var(--color-surface)]',
  warm: 'bg-[var(--color-surface-warm)]',
  inverse: 'bg-[var(--color-surface-inverse)] text-[var(--color-text-inverse)]',
}

const widthClasses: Record<ContentWidth, string> = {
  narrow: 'max-w-[var(--container-content-narrow)]',
  default: 'max-w-[var(--container-content-default)]',
  wide: 'max-w-[var(--container-content-wide)]',
  full: 'max-w-none',
}

const sectionClasses = `${toneClasses[tone]} ${className}`.trim()
---

<section id={id} class={sectionClasses}>
  <Container class={spacingClasses[spacing]}>
    {
      hasHeader && (
        <SectionHeader
          eyebrow={eyebrow}
          title={title}
          description={description}
          tone={tone === 'inverse' ? 'inverse' : 'default'}
        />
      )
    }

    <div
      class={hasHeader
        ? `mt-[var(--section-header-gap)] ${widthClasses[contentWidth]}`
        : widthClasses[contentWidth]}
    >
      <slot />
    </div>
  </Container>
</section>
