---
type Tone = 'default' | 'raised' | 'soft' | 'water' | 'warm' | 'inverse'
type Padding = 'sm' | 'md' | 'lg'

type Props = {
  tone?: Tone
  padding?: Padding
  elevated?: boolean
  class?: string
  [key: string]: unknown
}

const {
  tone = 'default',
  padding = 'md',
  elevated = false,
  class: className = '',
  ...attrs
} = Astro.props as Props

const toneClasses: Record<Tone, string> = {
  default:
    'bg-[var(--color-page)] text-[var(--color-text)] border-[var(--color-border)]',
  raised:
    'bg-[var(--color-surface-raised)] text-[var(--color-text)] border-[var(--color-border)]',
  soft: 'bg-[var(--color-surface)] text-[var(--color-text)] border-[var(--color-border)]',
  water:
    'bg-[var(--color-surface-water)] text-[var(--color-text)] border-[var(--color-border)]',
  warm: 'bg-[var(--color-surface-warm)] text-[var(--color-text)] border-[var(--color-border)]',
  inverse:
    'bg-[var(--color-surface-inverse)] text-[var(--color-text-inverse)] border-[var(--color-inverse-border)]',
}

const paddingClasses: Record<Padding, string> = {
  sm: 'p-4 sm:p-5',
  md: 'p-6',
  lg: 'p-7 sm:p-8',
}

const shadowClass = elevated ? 'theme-shadow-xs' : ''
const classes =
  `rounded-[var(--radius-lg)] border ${toneClasses[tone]} ${paddingClasses[padding]} ${shadowClass} ${className}`.trim()
---

<article class={classes} {...attrs}>
  <slot />
</article>
