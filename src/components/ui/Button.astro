---
type Variant =
  | 'primary'
  | 'secondary'
  | 'ghost'
  | 'inverse'
  | 'accent'
  | 'light'
  | 'inverseGhost'
type Size = 'sm' | 'md' | 'lg'
type ButtonType = 'button' | 'submit' | 'reset'

type Props = {
  href?: string
  variant?: Variant
  size?: Size
  fullWidth?: boolean
  disabled?: boolean
  type?: ButtonType
  class?: string
}

const {
  href,
  variant = 'primary',
  size = 'md',
  fullWidth = false,
  disabled = false,
  type = 'button',
  class: className = '',
  ...attrs
} = Astro.props as Props

const base =
  'inline-flex min-h-11 items-center justify-center gap-2 rounded-[var(--radius-md)] font-semibold transition-colors duration-[var(--duration-normal)] ease-[var(--ease-standard)] focus-visible:outline-none focus-visible:ring-2'

const sizeClasses: Record<Size, string> = {
  sm: 'min-h-11 px-4 py-2 text-sm',
  md: 'min-h-11 px-5 py-3 text-sm',
  lg: 'min-h-12 px-6 py-3.5 text-base',
}

const variants: Record<Variant, string> = {
  primary:
    'bg-[var(--color-action)] text-white hover:bg-[var(--color-action-hover)] active:bg-[var(--color-action-active)]',
  secondary:
    'bg-[var(--color-page)] text-[var(--color-text)] ring-1 ring-inset ring-[var(--color-border)] hover:bg-[var(--color-surface)] active:bg-[var(--color-surface-soft)]',
  ghost:
    'text-[var(--color-text)] hover:bg-[var(--color-surface)] active:bg-[var(--color-surface-soft)]',
  inverse:
    'bg-[var(--color-surface-inverse)] text-[var(--color-text-inverse)] ring-1 ring-inset ring-white/15 hover:bg-[var(--color-surface-inverse-hover)] active:bg-[var(--color-surface-inverse-active)]',
  accent:
    'bg-[var(--color-accent)] text-[var(--color-surface-inverse)] shadow-[var(--shadow-action)] hover:bg-[var(--color-accent-hover)] active:bg-[var(--color-accent-hover)]',
  light:
    'bg-[var(--color-surface-raised)] text-[var(--color-action)] ring-1 ring-inset ring-[var(--color-border)] hover:bg-[var(--color-surface)] active:bg-[var(--color-surface-soft)]',
  inverseGhost:
    'text-[var(--color-text-inverse)] ring-1 ring-inset ring-[var(--color-inverse-border-strong)] hover:bg-[var(--color-inverse-subtle)] active:bg-[var(--color-inverse-subtle-hover)]',
}

const disabledClasses = disabled ? 'cursor-not-allowed opacity-50' : ''
const widthClass = fullWidth ? 'w-full' : ''
const ringOffsetClass =
  variant === 'inverse' || variant === 'inverseGhost'
    ? 'focus-visible:ring-offset-[var(--color-surface-inverse)]'
    : 'focus-visible:ring-offset-[var(--color-page)]'
const ringColorClass =
  variant === 'inverse' || variant === 'inverseGhost'
    ? 'focus-visible:ring-[var(--color-focus-ring-inverse)]'
    : 'focus-visible:ring-[var(--color-focus-ring)]'
const classes =
  `${base} ${ringColorClass} ${ringOffsetClass} ${sizeClasses[size]} ${variants[variant]} ${widthClass} ${disabledClasses} ${className}`.trim()
const startIcon = Astro.slots.has('startIcon')
const endIcon = Astro.slots.has('endIcon')
---

{
  href ? (
    <a
      href={disabled ? undefined : href}
      class={classes}
      aria-disabled={disabled ? 'true' : undefined}
      tabindex={disabled ? '-1' : undefined}
      {...attrs}
    >
      {startIcon && <slot name="startIcon" />}
      <slot />
      {endIcon && <slot name="endIcon" />}
    </a>
  ) : (
    <button type={type} class={classes} disabled={disabled} {...attrs}>
      {startIcon && <slot name="startIcon" />}
      <slot />
      {endIcon && <slot name="endIcon" />}
    </button>
  )
}
