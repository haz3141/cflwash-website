---
type Tone =
  | 'default'
  | 'soft'
  | 'water'
  | 'warm'
  | 'action'
  | 'accent'
  | 'inverse'
type Size = 'sm' | 'md' | 'lg'

type Props = {
  icon: any
  tone?: Tone
  size?: Size
  class?: string
}

const {
  icon: Icon,
  tone = 'soft',
  size = 'md',
  class: className = '',
} = Astro.props as Props

const toneClasses: Record<Tone, string> = {
  default:
    'bg-[var(--color-page)] text-[var(--color-text)] ring-1 ring-inset ring-[var(--color-border)]',
  soft: 'bg-[var(--color-surface-soft)] text-[var(--color-text)] ring-1 ring-inset ring-[var(--color-border)]',
  water:
    'bg-[var(--color-surface-water)] text-[var(--color-action)] ring-1 ring-inset ring-[var(--color-border)]',
  warm: 'bg-[var(--color-surface-warm)] text-[var(--color-text)] ring-1 ring-inset ring-[var(--color-border)]',
  action:
    'bg-[var(--color-action)] text-[var(--color-text-inverse)] ring-1 ring-inset ring-[var(--color-action)]',
  accent:
    'bg-[var(--color-surface-inverse)] text-[var(--color-accent)] ring-1 ring-inset ring-[var(--color-inverse-border)]',
  inverse:
    'bg-[var(--color-inverse-surface)] text-[var(--color-text-inverse)] ring-1 ring-inset ring-[var(--color-inverse-border)]',
}

const sizeClasses: Record<Size, string> = {
  sm: 'h-8 w-8 rounded-[var(--radius-md)]',
  md: 'h-10 w-10 rounded-[var(--radius-md)]',
  lg: 'h-12 w-12 rounded-[var(--radius-lg)]',
}
---

<span
  class={`inline-flex items-center justify-center ${sizeClasses[size]} ${toneClasses[tone]} ${className}`.trim()}
>
  <Icon aria-hidden="true" class="h-5 w-5" stroke-width="1.8" />
</span>
