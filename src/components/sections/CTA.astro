---
import Button from '../ui/Button.astro'
import Card from '../ui/Card.astro'

type Props = {
  title: string
  description: string
  primaryHref: string
  primaryLabel: string
  secondaryHref?: string
  secondaryLabel?: string
}

const {
  title,
  description,
  primaryHref,
  primaryLabel,
  secondaryHref,
  secondaryLabel,
} = Astro.props as Props
---

<section class="mx-auto w-full max-w-[var(--container-width)] px-6">
  <Card tone="soft" padding="lg" elevated>
    <h2 class="text-section-title text-[var(--color-text)]">
      {title}
    </h2>
    <p class="mt-3 max-w-2xl text-lead text-[var(--color-text-muted)]">
      {description}
    </p>
    <div class="mt-6 flex flex-col gap-3 sm:flex-row">
      <Button href={primaryHref} size="md">
        {primaryLabel}
      </Button>
      {
        secondaryHref && secondaryLabel && (
          <Button href={secondaryHref} variant="secondary" size="md">
            {secondaryLabel}
          </Button>
        )
      }
    </div>
  </Card>
</section>
