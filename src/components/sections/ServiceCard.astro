---
import Button from '../ui/Button.astro'
import Card from '../ui/Card.astro'

type Props = {
  title: string
  description: string
  href: string
}

const { title, description, href } = Astro.props as Props
---

<Card class="flex h-full flex-col">
  <h3 class="text-base font-semibold text-[var(--color-text)]">{title}</h3>
  <p class="mt-2 text-sm leading-6 text-[var(--color-text-muted)]">
    {description}
  </p>
  <div class="mt-5">
    <Button href={href} variant="secondary" class="w-full sm:w-auto">
      View service
    </Button>
  </div>
</Card>
