---
type Props = {
  eyebrow?: string
  title?: string
  description?: string
  class?: string
}

const {
  eyebrow,
  title,
  description,
  class: className = '',
} = Astro.props as Props
---

<section class={`mx-auto w-full max-w-6xl px-6 ${className}`.trim()}>
  {(eyebrow || title || description) && (
    <div class="max-w-2xl">
      {eyebrow && (
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-600">
          {eyebrow}
        </p>
      )}
      {title && <h2 class="mt-3 text-2xl font-semibold tracking-tight text-slate-950 sm:text-3xl">{title}</h2>}
      {description && <p class="mt-3 text-sm leading-7 text-slate-600 sm:text-base">{description}</p>}
    </div>
  )}

  <div class="mt-8">
    <slot />
  </div>
</section>
