---
import Button from '../components/ui/Button.astro'
import BreadcrumbSchema from '../components/site/BreadcrumbSchema.astro'
import Breadcrumbs from '../components/site/Breadcrumbs.astro'
import HeroSection from '../components/patterns/HeroSection.astro'
import LinkGrid from '../components/patterns/LinkGrid.astro'
import QuoteForm from '../components/quote/QuoteForm.astro'
import Section from '../components/ui/Section.astro'
import Layout from '../layouts/Layout.astro'
import { serviceAreas } from '../data/serviceAreas'
import { services } from '../data/services'
import { site } from '../data/site'
import { ClipboardList, Mail, Phone } from '@lucide/astro'

const hasPhone = Boolean(site.phoneDisplay && site.phoneHref)
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Request a Quote', href: '/request-quote' },
]
const serviceLinks = services.map((service) => ({
  label: service.name,
  href: `/${service.slug}`,
  description: service.summary,
}))
const serviceAreaLinks = serviceAreas.map((area) => ({
  label: area.name,
  href: `/service-areas/${area.slug}`,
  description: area.description,
}))
const quoteEmailSubject = 'Quote request for driveway or concrete cleaning'
const quoteEmailBody = [
  'Name:',
  'City:',
  'Service needed:',
  'Surface or area to clean:',
  'HOA notice or curb appeal goal (if relevant):',
].join('\n')
const quoteEmailHref = `mailto:${site.email}?subject=${encodeURIComponent(quoteEmailSubject)}&body=${encodeURIComponent(quoteEmailBody)}`
---

<Layout
  title="Request a Cleaning Quote | CFL Wash Co."
  description="Request a quote from CFL Wash Co. for driveway, sidewalk, walkway, and concrete cleaning in Central Florida."
  canonicalPath="/request-quote"
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />
  <main>
    <Breadcrumbs items={breadcrumbs} />

    <HeroSection
      variant="split"
      tone="soft"
      eyebrow="Request a Quote"
      title="Request a quote for your driveway or concrete cleaning project."
      description="Use the form below to send the city, surfaces, and site details CFL Wash Co. needs to review the request. If photos help explain the job, mention them in the form or send them by email after you submit."
    >
      <Fragment slot="actions">
        <Button
          href="#quote-form"
          size="lg"
          fullWidth
          data-cta="start-form"
          data-cta-location="request-quote-hero"
          data-mobile-sticky-trigger
          class="sm:w-auto"
        >
          <ClipboardList
            slot="startIcon"
            class="h-5 w-5"
            aria-hidden="true"
            stroke-width="1.8"
          />
          Start your request
        </Button>
        {
          hasPhone && (
            <Button
              href={site.phoneHref!}
              variant="secondary"
              size="lg"
              fullWidth
              data-cta="call"
              data-cta-location="request-quote-hero"
              class="sm:w-auto"
            >
              <Phone
                slot="startIcon"
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
              Call {site.phoneDisplay}
            </Button>
          )
        }
        <Button
          href={quoteEmailHref}
          variant="secondary"
          size="lg"
          fullWidth
          data-cta="email"
          data-cta-location="request-quote-hero"
          class="sm:w-auto"
        >
          <Mail
            slot="startIcon"
            class="h-5 w-5"
            aria-hidden="true"
            stroke-width="1.8"
          />
          Request by email
        </Button>
      </Fragment>

      <div slot="aside" class="form-panel max-w-md">
        <h2 class="text-lg font-semibold text-[var(--color-text)]">
          A strong request usually includes:
        </h2>
        <ul class="mt-4 space-y-3 text-sm leading-6 text-[var(--color-text)]">
          <li class="flex gap-3">
            <span
              class="mt-2 h-2 w-2 shrink-0 rounded-full bg-[var(--color-action)]"
            ></span>
            <span>The city and the concrete surfaces you want cleaned</span>
          </li>
          <li class="flex gap-3">
            <span
              class="mt-2 h-2 w-2 shrink-0 rounded-full bg-[var(--color-action)]"
            ></span>
            <span
              >Access notes, gates, parked vehicles, and any HOA wording</span
            >
          </li>
          <li class="flex gap-3">
            <span
              class="mt-2 h-2 w-2 shrink-0 rounded-full bg-[var(--color-action)]"
            ></span>
            <span
              >Priority stains, buildup, or any part of the surface you want
              reviewed closely</span
            >
          </li>
        </ul>
        <p class="mt-4 text-sm leading-6 text-[var(--color-text-muted)]">
          Sending a request starts the quote review. It does not book service or
          confirm pricing on its own.
        </p>
      </div>
    </HeroSection>

    <Section spacing="compact" class="pb-20">
      <QuoteForm />
    </Section>

    <Section
      eyebrow="Explore current coverage"
      title="Review the live service and city pages"
      description="These pages explain the concrete cleaning services and published service-area coverage if you want to confirm the fit before sending details."
      tone="soft"
      class="border-t border-[var(--color-border)]"
    >
      <div class="grid gap-8 lg:grid-cols-2">
        <div>
          <h2 class="text-xl font-semibold text-[var(--color-text)]">
            Service pages
          </h2>
          <LinkGrid items={serviceLinks} columns="one" class="mt-4" />
        </div>
        <div>
          <h2 class="text-xl font-semibold text-[var(--color-text)]">
            Published city pages
          </h2>
          <LinkGrid items={serviceAreaLinks} columns="one" class="mt-4" />
        </div>
      </div>
    </Section>
  </main>
</Layout>
