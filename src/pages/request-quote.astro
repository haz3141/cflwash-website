---
import Button from '../components/ui/Button.astro'
import BreadcrumbSchema from '../components/site/BreadcrumbSchema.astro'
import Breadcrumbs from '../components/site/Breadcrumbs.astro'
import LinkGrid from '../components/patterns/LinkGrid.astro'
import QuoteForm from '../components/quote/QuoteForm.astro'
import Section from '../components/ui/Section.astro'
import Layout from '../layouts/Layout.astro'
import { serviceAreas } from '../data/serviceAreas'
import { services } from '../data/services'
import { site } from '../data/site'
import { Mail, Phone } from '@lucide/astro'

const hasPhone = Boolean(site.phoneDisplay && site.phoneHref)
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Request a Quote', href: '/request-quote' },
]
const serviceLinks = services.map((service) => ({
  label: service.name,
  href: `/${service.slug}`,
  description: service.summary,
}))
const serviceAreaLinks = serviceAreas.map((area) => ({
  label: area.name,
  href: `/service-areas/${area.slug}`,
  description: area.description,
}))
const quoteEmailSubject = 'Quote request for exterior cleaning'
const quoteEmailBody = [
  'Name:',
  'City:',
  'Service needed:',
  'Surface or area to clean:',
  'HOA notice or curb appeal goal (if relevant):',
].join('\n')
const quoteEmailHref = `mailto:${site.email}?subject=${encodeURIComponent(quoteEmailSubject)}&body=${encodeURIComponent(quoteEmailBody)}`
---

<Layout
  title="Request a Cleaning Quote | CFL Wash Co."
  description="Request a quote from CFL Wash Co. for driveway, sidewalk, walkway, and concrete cleaning in Central Florida."
  canonicalPath="/request-quote"
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />
  <main>
    <Breadcrumbs items={breadcrumbs} />

    <Section spacing="none" class="py-20">
      <div class="max-w-3xl">
        <p class="text-eyebrow text-[var(--color-text-muted)]">
          Request a Quote
        </p>
        <h1 class="measure-copy mt-4 text-display text-[var(--color-text)]">
          Request a quote for your cleaning project.
        </h1>
        <p class="measure-copy mt-5 text-lead text-[var(--color-text-muted)]">
          Share your city, service, and project details to request a quote for
          driveway, sidewalk, walkway, and concrete cleaning. Email is still
          available if you prefer not to use the online form.
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          {
            hasPhone && (
              <Button
                href={site.phoneHref!}
                variant="secondary"
                size="lg"
                fullWidth
                data-cta="call"
                data-cta-location="request-quote-hero"
                class="sm:w-auto"
              >
                <Phone
                  slot="startIcon"
                  class="h-5 w-5"
                  aria-hidden="true"
                  stroke-width="1.8"
                />
                Call {site.phoneDisplay}
              </Button>
            )
          }
          <Button
            href={quoteEmailHref}
            variant="ghost"
            size="lg"
            fullWidth
            data-cta="email"
            data-cta-location="request-quote-hero"
            class="sm:w-auto"
          >
            <Mail
              slot="startIcon"
              class="h-5 w-5"
              aria-hidden="true"
              stroke-width="1.8"
            />
            Prefer Email?
          </Button>
          <Button
            href="/#services"
            variant="ghost"
            size="lg"
            fullWidth
            data-cta="services"
            data-cta-location="request-quote-hero"
            class="sm:w-auto"
          >
            View Services
          </Button>
        </div>
      </div>
    </Section>

    <Section spacing="compact" class="pb-20">
      <QuoteForm />
    </Section>

    <Section
      eyebrow="Explore current coverage"
      title="Review the live service and city pages"
      description="These pages show the current launch services and published service-area coverage if you want to confirm the fit before sending details."
      tone="soft"
      class="border-t border-[var(--color-border)]"
    >
      <div class="grid gap-8 lg:grid-cols-2">
        <div>
          <h2 class="text-xl font-semibold text-[var(--color-text)]">
            Service pages
          </h2>
          <LinkGrid items={serviceLinks} columns="one" class="mt-4" />
        </div>
        <div>
          <h2 class="text-xl font-semibold text-[var(--color-text)]">
            Published city pages
          </h2>
          <LinkGrid items={serviceAreaLinks} columns="one" class="mt-4" />
        </div>
      </div>
    </Section>
  </main>
</Layout>
