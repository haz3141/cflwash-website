---
import Button from '../components/ui/Button.astro'
import QuoteForm from '../components/quote/QuoteForm.astro'
import Section from '../components/ui/Section.astro'
import Layout from '../layouts/Layout.astro'
import { site } from '../data/site'

const hasPhone = Boolean(site.phoneDisplay && site.phoneHref)
const quoteEmailSubject = 'Quote request for exterior cleaning'
const quoteEmailBody = [
  'Name:',
  'City:',
  'Service needed:',
  'Surface or area to clean:',
  'HOA notice or curb appeal goal (if relevant):',
].join('\n')
const quoteEmailHref = `mailto:${site.email}?subject=${encodeURIComponent(quoteEmailSubject)}&body=${encodeURIComponent(quoteEmailBody)}`
---

<Layout
  title="Request a Cleaning Quote | CFL Wash Co."
  description="Request a quote from CFL Wash Co. for driveway, sidewalk, walkway, and concrete cleaning in Central Florida."
  canonicalPath="/request-quote"
>
  <main>
    <Section spacing="none" class="py-20">
      <div class="max-w-3xl">
        <p
          class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-text-muted)]"
        >
          Request a Quote
        </p>
        <h1
          class="mt-4 text-4xl font-semibold text-[var(--color-text)] sm:text-5xl"
        >
          Request a quote for your cleaning project.
        </h1>
        <p
          class="mt-5 max-w-2xl text-base leading-8 text-[var(--color-text-muted)] sm:text-lg"
        >
          Share your city, service, and project details to request a quote for
          driveway, sidewalk, walkway, and concrete cleaning. Email is still
          available if you prefer not to use the online form.
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button
            href={quoteEmailHref}
            data-cta="email"
            data-cta-location="request-quote-hero"
          >
            Prefer Email?
          </Button>
          <Button
            href="/#services"
            variant="secondary"
            data-cta="services"
            data-cta-location="request-quote-hero"
          >
            View Services
          </Button>
          {
            hasPhone && (
              <Button
                href={site.phoneHref!}
                variant="ghost"
                data-cta="call"
                data-cta-location="request-quote-hero"
              >
                Call {site.phoneDisplay}
              </Button>
            )
          }
        </div>
      </div>
    </Section>

    <Section spacing="compact" class="pb-20">
      <QuoteForm />
    </Section>
  </main>
</Layout>
