---
import Button from '../components/Button.astro'
import Layout from '../layouts/Layout.astro'
import Section from '../components/Section.astro'
import { site } from '../data/site'
---

<Layout
  title="Request a Quote | CFL Wash Co."
  description="Request a pressure washing quote from CFL Wash Co. for driveway, sidewalk, walkway, and concrete cleaning in Central Florida."
  canonicalPath="/request-quote"
>
  <main>
    <Section class="py-20">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-600">
        Request a Quote
      </p>
      <h1 class="mt-4 max-w-2xl text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl">
        This route is ready for the future quote flow.
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-8 text-slate-600 sm:text-lg">
        No form is implemented yet. The page exists so the quote workflow, SEO, and
        internal linking have a stable destination.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <Button href={site.phoneHref}>Call {site.phoneDisplay}</Button>
        <Button href={`mailto:${site.email}`} variant="secondary">
          Email {site.email}
        </Button>
      </div>
    </Section>
  </main>
</Layout>
