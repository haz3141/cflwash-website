---
import Button from '../components/ui/Button.astro'
import Card from '../components/ui/Card.astro'
import Section from '../components/ui/Section.astro'
import Layout from '../layouts/Layout.astro'
import { serviceAreas } from '../data/serviceAreas'
import { site } from '../data/site'
import { services } from '../data/services'

const service = services.find(
  (item) => item.slug === 'driveway-pressure-washing',
)!

const relatedServices = services.filter((item) => item.slug !== service.slug)

const seoTitle = 'Driveway Pressure Washing in Central Florida | CFL Wash Co.'
const seoDescription =
  'Request a quote for concrete driveway pressure washing in Central Florida. CFL Wash Co. helps with curb appeal, surface grime, and HOA notice cleanup.'

const inclusions = [
  'Concrete driveway pressure washing focused on surface buildup, grime, and visible discoloration',
  'Attention to driveway edges, aprons, and entry-side transitions when they are part of the requested scope',
  'A pre-cleaning review of surface condition, drainage, nearby landscaping, and access',
  'Clear quote-first scope before work is scheduled',
]

const considerations = [
  {
    title: 'Surface condition',
    description:
      'Older, cracked, patched, painted, or previously coated concrete may need a more careful approach and may not clean evenly.',
  },
  {
    title: 'Drainage and runoff',
    description:
      'Driveway slope, low spots, nearby drains, and surrounding landscape beds can affect how the work is approached.',
  },
  {
    title: 'Access',
    description:
      'Parked cars, gates, tight side yards, and hose access can change the available cleaning area and quote details.',
  },
  {
    title: 'Staining',
    description:
      'Rust, irrigation staining, oil, tire marks, and deep organic stains can improve with cleaning, but complete removal is not promised.',
  },
]

const prepItems = [
  'Move vehicles off the driveway before the visit.',
  'Clear toys, planters, mats, trash bins, and loose items from the work area.',
  'Point out fragile edges, damaged concrete, known drainage issues, or stains that are a priority.',
  'Keep pets and people away from the active work area.',
]

const processSteps = [
  {
    title: 'Request a quote',
    description:
      'Share your city, driveway size or layout, surface concerns, and any HOA notice details that matter.',
  },
  {
    title: 'Confirm the scope',
    description:
      'CFL Wash Co. reviews the surface, access, drainage, and staining notes before confirming the cleaning plan.',
  },
  {
    title: 'Clean the driveway',
    description:
      'The work stays focused on improving the appearance of appropriate concrete driveway surfaces.',
  },
]

const faqs = [
  {
    question: 'Can driveway pressure washing remove every stain?',
    answer:
      'No. Pressure washing can help with surface grime and many types of everyday buildup, but deep oil, rust, irrigation staining, tire marks, and older discoloration may remain visible.',
  },
  {
    question: 'Do you clean paver driveways or sealed surfaces?',
    answer:
      'This launch service is focused on appropriate concrete surfaces. Share the surface type in the quote request so CFL Wash Co. can confirm whether it fits the current service scope.',
  },
  {
    question: 'Is driveway cleaning useful for HOA notices?',
    answer:
      'It can help when the notice is about visible driveway or concrete buildup. Include the notice details in the quote request so the scope stays clear.',
  },
]
---

<Layout
  title={seoTitle}
  description={seoDescription}
  canonicalPath="/driveway-pressure-washing"
>
  <main>
    <Section spacing="none" class="py-16 sm:py-20">
      <p
        class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-primary)]"
      >
        Service
      </p>
      <h1
        class="mt-4 max-w-4xl text-4xl font-semibold leading-tight text-[var(--color-text)] sm:text-5xl"
      >
        Concrete driveway pressure washing for cleaner curb appeal.
      </h1>
      <p
        class="mt-5 max-w-3xl text-base leading-8 text-[var(--color-text-muted)] sm:text-lg"
      >
        Driveways collect tire marks, organic buildup, irrigation staining,
        tracked-in dirt, and everyday grime. CFL Wash Co. focuses this service
        on concrete driveway cleaning that can help the front of the home look
        cleaner without implying repair, sealing, or complete stain removal.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <Button
          href="/request-quote"
          data-cta="quote"
          data-cta-location={`service-${service.slug}`}
        >
          Request a Quote
        </Button>
        <Button
          href={`mailto:${site.email}`}
          variant="secondary"
          data-cta="email"
          data-cta-location={`service-${service.slug}`}
        >
          Email CFL Wash Co.
        </Button>
      </div>
    </Section>

    <Section
      eyebrow="What is included"
      title="A focused driveway cleaning scope"
      description="The quote stays centered on the concrete driveway and connected hard-surface details that affect the visible result."
      class="border-t border-[var(--color-border)]"
    >
      <div class="grid gap-4 md:grid-cols-2">
        {
          inclusions.map((item) => (
            <Card class="bg-white">
              <p class="text-sm font-semibold leading-7 text-[var(--color-text)]">
                {item}
              </p>
            </Card>
          ))
        }
      </div>
    </Section>

    <section class="bg-[var(--color-surface)]">
      <div
        class="mx-auto grid w-full max-w-[var(--container-width)] gap-8 px-6 py-[var(--section-spacing)] lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]"
      >
        <div>
          <p
            class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-primary)]"
          >
            Quote considerations
          </p>
          <h2
            class="mt-3 text-2xl font-semibold text-[var(--color-text)] sm:text-3xl"
          >
            Surface, drainage, access, and staining all matter.
          </h2>
          <p
            class="mt-3 text-sm leading-7 text-[var(--color-text-muted)] sm:text-base"
          >
            Driveway cleaning is not a one-size-fits-all promise. The starting
            condition of the concrete, how water moves across the driveway, and
            what type of staining is present can affect both the process and the
            visible outcome.
          </p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          {
            considerations.map((item) => (
              <Card class="bg-white">
                <h3 class="text-base font-semibold text-[var(--color-text)]">
                  {item.title}
                </h3>
                <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
                  {item.description}
                </p>
              </Card>
            ))
          }
        </div>
      </div>
    </section>

    <Section
      eyebrow="Before the visit"
      title="Simple preparation for driveway cleaning"
      description="A clear driveway helps the quote and cleaning visit stay focused."
    >
      <ul class="grid gap-3 md:grid-cols-2">
        {
          prepItems.map((item) => (
            <li class="rounded-[var(--radius-md)] border border-[var(--color-border)] bg-white p-4 text-sm leading-7 text-[var(--color-text-muted)]">
              {item}
            </li>
          ))
        }
      </ul>
    </Section>

    <Section
      eyebrow="Process"
      title="Quote-first driveway cleaning"
      description="Request a quote first, then confirm the scope before any work is scheduled."
      class="border-y border-[var(--color-border)] bg-[var(--color-surface)]"
    >
      <div class="grid gap-4 md:grid-cols-3">
        {
          processSteps.map((step, index) => (
            <Card class="bg-white">
              <div class="flex items-center gap-4">
                <span class="flex h-10 w-10 items-center justify-center rounded-full bg-[var(--color-primary)] text-sm font-semibold text-white">
                  {index + 1}
                </span>
                <h3 class="text-base font-semibold text-[var(--color-text)]">
                  {step.title}
                </h3>
              </div>
              <p class="mt-4 text-sm leading-7 text-[var(--color-text-muted)]">
                {step.description}
              </p>
            </Card>
          ))
        }
      </div>
    </Section>

    <Section
      eyebrow="Related pages"
      title="Explore connected concrete cleaning options"
      description="Pair driveway cleaning with nearby sidewalks, entry walks, or other appropriate concrete surfaces when the quote scope calls for it."
    >
      <div class="grid gap-8 lg:grid-cols-2">
        <div>
          <h2 class="text-lg font-semibold text-[var(--color-text)]">
            Related services
          </h2>
          <div class="mt-4 grid gap-3">
            {
              relatedServices.map((item) => (
                <a
                  href={`/${item.slug}`}
                  class="rounded-[var(--radius-md)] border border-[var(--color-border)] bg-white p-4 text-sm font-semibold text-[var(--color-text)] transition-colors hover:border-[var(--color-primary)] hover:text-[var(--color-primary)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring)] focus-visible:ring-offset-2"
                >
                  {item.name}
                </a>
              ))
            }
          </div>
        </div>

        <div>
          <h2 class="text-lg font-semibold text-[var(--color-text)]">
            Active service areas
          </h2>
          <div class="mt-4 grid gap-3">
            {
              serviceAreas.map((area) => (
                <a
                  href={`/service-areas/${area.slug}`}
                  class="rounded-[var(--radius-md)] border border-[var(--color-border)] bg-white p-4 text-sm font-semibold text-[var(--color-text)] transition-colors hover:border-[var(--color-primary)] hover:text-[var(--color-primary)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring)] focus-visible:ring-offset-2"
                >
                  {area.name}
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </Section>

    <Section
      eyebrow="FAQ"
      title="Driveway pressure washing questions"
      class="border-y border-[var(--color-border)] bg-[var(--color-surface)]"
    >
      <div class="grid gap-4 md:grid-cols-3">
        {
          faqs.map((faq) => (
            <Card class="bg-white">
              <h2 class="text-base font-semibold text-[var(--color-text)]">
                {faq.question}
              </h2>
              <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
                {faq.answer}
              </p>
            </Card>
          ))
        }
      </div>
    </Section>

    <section class="px-6 py-[var(--section-spacing)]">
      <div
        class="mx-auto max-w-[var(--container-width)] rounded-[var(--radius-lg)] bg-[var(--color-primary)] px-6 py-12 text-center text-white sm:px-10"
      >
        <h2 class="mx-auto max-w-2xl text-3xl font-semibold sm:text-4xl">
          Request a driveway pressure washing quote.
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-base leading-8 text-white/85">
          Share the driveway details, city, surface condition, and any HOA
          notice language so CFL Wash Co. can review the scope.
        </p>
        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
          <Button
            href="/request-quote"
            variant="secondary"
            class="bg-white text-[var(--color-primary)] hover:bg-[var(--color-surface)]"
            data-cta="quote"
            data-cta-location={`service-${service.slug}-final`}
          >
            Request a Quote
          </Button>
          <Button
            href={`mailto:${site.email}`}
            variant="ghost"
            class="text-white ring-1 ring-inset ring-white/35 hover:bg-white/10"
            data-cta="email"
            data-cta-location={`service-${service.slug}-final`}
          >
            Email CFL Wash Co.
          </Button>
        </div>
      </div>
    </section>
  </main>
</Layout>
