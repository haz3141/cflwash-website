---
import Button from '../components/ui/Button.astro'
import BreadcrumbSchema from '../components/site/BreadcrumbSchema.astro'
import Breadcrumbs from '../components/site/Breadcrumbs.astro'
import CTASection from '../components/patterns/CTASection.astro'
import Card from '../components/ui/Card.astro'
import FAQList from '../components/patterns/FAQList.astro'
import HeroSection from '../components/patterns/HeroSection.astro'
import LinkGrid from '../components/patterns/LinkGrid.astro'
import MediaFrame from '../components/patterns/MediaFrame.astro'
import ProcessSteps from '../components/patterns/ProcessSteps.astro'
import Section from '../components/ui/Section.astro'
import SplitFeature from '../components/patterns/SplitFeature.astro'
import Layout from '../layouts/Layout.astro'
import { publicMedia } from '../data/publicMedia'
import { serviceAreas } from '../data/serviceAreas'
import { site } from '../data/site'
import { services } from '../data/services'
import { Mail, Phone } from '@lucide/astro'

const service = services.find(
  (item) => item.slug === 'driveway-pressure-washing',
)!

const relatedServices = services.filter((item) => item.slug !== service.slug)
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: service.name, href: `/${service.slug}` },
]
const relatedServiceLinks = relatedServices.map((item) => ({
  label: item.name,
  href: `/${item.slug}`,
}))
const activeServiceAreaLinks = serviceAreas.map((area) => ({
  label: area.name,
  href: `/service-areas/${area.slug}`,
}))
const hasPhone = Boolean(site.phoneDisplay && site.phoneHref)

const seoTitle = 'Driveway Pressure Washing in Central Florida | CFL Wash Co.'
const seoDescription =
  'Request a quote for concrete driveway pressure washing in Central Florida. CFL Wash Co. helps with curb appeal, surface grime, and HOA notice cleanup.'

const inclusions = [
  'Concrete driveway pressure washing focused on surface buildup, grime, and visible discoloration',
  'Attention to driveway edges, aprons, and entry-side transitions when they are part of the requested scope',
  'A pre-cleaning review of surface condition, drainage, nearby landscaping, and access',
  'Clear quote-first scope before work is scheduled',
]

const considerations = [
  {
    title: 'Surface condition',
    description:
      'Older, cracked, patched, painted, or previously coated concrete may need a more careful approach and may not clean evenly.',
  },
  {
    title: 'Drainage and runoff',
    description:
      'Driveway slope, low spots, nearby drains, and surrounding landscape beds can affect how the work is approached.',
  },
  {
    title: 'Access',
    description:
      'Parked cars, gates, tight side yards, and hose access can change the available cleaning area and quote details.',
  },
  {
    title: 'Staining',
    description:
      'Results depend on the surface condition, age, staining, drainage, and prior treatment.',
  },
]

const prepItems = [
  'Move vehicles off the driveway before the visit.',
  'Clear toys, planters, mats, trash bins, and loose items from the work area.',
  'Point out fragile edges, damaged concrete, known drainage issues, or stains that are a priority.',
  'Keep pets and people away from the active work area.',
]

const processSteps = [
  {
    title: 'Request a quote',
    description:
      'Share your city, driveway size or layout, surface concerns, and any HOA notice details that matter.',
  },
  {
    title: 'Confirm the scope',
    description:
      'CFL Wash Co. reviews the surface, access, drainage, and staining notes before confirming the cleaning plan.',
  },
  {
    title: 'Clean the driveway',
    description:
      'The work stays focused on improving the appearance of appropriate concrete driveway surfaces.',
  },
]

const faqs = [
  {
    question: 'Can driveway pressure washing remove every stain?',
    answer:
      'No. Pressure washing can help with surface grime and many types of everyday buildup, but deep oil, rust, irrigation staining, tire marks, and older discoloration may remain visible.',
  },
  {
    question: 'Do you clean paver driveways or sealed surfaces?',
    answer:
      'This launch service is focused on appropriate concrete surfaces. Share the surface type in the quote request so CFL Wash Co. can confirm whether it fits the current service scope.',
  },
  {
    question: 'Is driveway cleaning useful for HOA notices?',
    answer:
      'It can help when the notice is about visible driveway or concrete buildup. Include the notice details in the quote request so the scope stays clear.',
  },
]
---

<Layout
  title={seoTitle}
  description={seoDescription}
  canonicalPath="/driveway-pressure-washing"
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />
  <main>
    <Breadcrumbs items={breadcrumbs} />

    <HeroSection
      variant="split"
      tone="soft"
      eyebrow="Service"
      title="Concrete driveway pressure washing for cleaner curb appeal."
      description="Driveways collect tire marks, organic buildup, irrigation staining, tracked-in dirt, and everyday grime. CFL Wash Co. focuses this service on concrete driveway cleaning that can help the front of the home look cleaner while keeping the quote tied to the surface condition and staining involved."
    >
      <Fragment slot="actions">
        <Button
          href="/request-quote"
          data-cta="quote"
          data-cta-location={`service-${service.slug}`}
        >
          Request a Quote
        </Button>
        <Button
          href={`mailto:${site.email}`}
          variant="secondary"
          data-cta="email"
          data-cta-location={`service-${service.slug}`}
        >
          Email CFL Wash Co.
        </Button>
      </Fragment>

      <MediaFrame
        slot="media"
        media={publicMedia.serviceDriveway}
        loading="eager"
        fetchpriority="high"
      />
    </HeroSection>

    <Section
      eyebrow="What is included"
      title="A focused driveway cleaning scope"
      description="The quote stays centered on the concrete driveway and connected hard-surface details that affect the visible result."
      class="border-t border-[var(--color-border)]"
    >
      <div class="grid gap-4 md:grid-cols-2">
        {
          inclusions.map((item) => (
            <Card tone="raised">
              <p class="text-sm font-semibold leading-7 text-[var(--color-text)]">
                {item}
              </p>
            </Card>
          ))
        }
      </div>
    </Section>

    <SplitFeature
      eyebrow="Quote considerations"
      title="Surface, drainage, access, and staining all matter."
      description="Driveway cleaning starts with the actual surface. The condition of the concrete, how water moves across the driveway, and what type of staining is present can affect both the process and the visible outcome."
    >
      <div class="grid gap-4 sm:grid-cols-2">
        {
          considerations.map((item) => (
            <Card tone="raised">
              <h3 class="text-base font-semibold text-[var(--color-text)]">
                {item.title}
              </h3>
              <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
                {item.description}
              </p>
            </Card>
          ))
        }
      </div>
    </SplitFeature>

    <Section
      eyebrow="Before the visit"
      title="Simple preparation for driveway cleaning"
      description="A clear driveway helps the quote and cleaning visit stay focused."
    >
      <ul class="grid gap-3 md:grid-cols-2">
        {
          prepItems.map((item) => (
            <li class="feature-panel text-sm leading-7">{item}</li>
          ))
        }
      </ul>
    </Section>

    <Section
      eyebrow="Process"
      title="Quote-first driveway cleaning"
      description="Request a quote first, then confirm the scope before any work is scheduled."
      tone="soft"
      class="border-y border-[var(--color-border)]"
    >
      <ProcessSteps steps={processSteps} />
    </Section>

    <Section
      eyebrow="Related pages"
      title="Explore connected concrete cleaning options"
      description="Pair driveway cleaning with nearby sidewalks, entry walks, or other appropriate concrete surfaces when the quote scope calls for it."
    >
      <div class="grid gap-8 lg:grid-cols-2">
        <div>
          <h3 class="text-lg font-semibold text-[var(--color-text)]">
            Related services
          </h3>
          <LinkGrid items={relatedServiceLinks} class="mt-4" />
        </div>

        <div>
          <h3 class="text-lg font-semibold text-[var(--color-text)]">
            Active service areas
          </h3>
          <LinkGrid items={activeServiceAreaLinks} class="mt-4" />
        </div>
      </div>
    </Section>

    <Section
      eyebrow="FAQ"
      title="Driveway pressure washing questions"
      tone="soft"
      class="border-y border-[var(--color-border)]"
    >
      <FAQList faqs={faqs} />
    </Section>

    <CTASection
      tone="inverse"
      title="Request a driveway pressure washing quote."
      description="Share the driveway details, city, surface condition, and any HOA notice language so CFL Wash Co. can review the scope."
    >
      <Fragment slot="actions">
        <Button
          href="/request-quote"
          variant="light"
          data-cta="quote"
          data-cta-location={`service-${service.slug}-final`}
        >
          Request a Quote
        </Button>
        {
          hasPhone ? (
            <Button
              href={site.phoneHref!}
              variant="inverseGhost"
              data-cta="call"
              data-cta-location={`service-${service.slug}-final`}
            >
              <Phone
                slot="startIcon"
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
              Call {site.phoneDisplay}
            </Button>
          ) : (
            <Button
              href={`mailto:${site.email}`}
              variant="inverseGhost"
              data-cta="email"
              data-cta-location={`service-${service.slug}-final`}
            >
              <Mail
                slot="startIcon"
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
              Email CFL Wash Co.
            </Button>
          )
        }
      </Fragment>
    </CTASection>
  </main>
</Layout>
