---
import Button from '../components/ui/Button.astro'
import Breadcrumbs from '../components/site/Breadcrumbs.astro'
import HeroSection from '../components/patterns/HeroSection.astro'
import Layout from '../layouts/Layout.astro'
import { site } from '../data/site'

const breadcrumbs = [{ label: 'Home', href: '/' }, { label: 'Thank You' }]
---

<Layout
  title="Thank You | CFL Wash Co."
  description="Confirmation page for quote requests and contact follow-up."
  canonicalPath="/thank-you"
  noindex={true}
>
  <main>
    <Breadcrumbs items={breadcrumbs} />

    <HeroSection
      tone="soft"
      eyebrow="Thank You"
      title="Thanks for reaching out."
      description="We have your request details. If you need to add anything else about the driveway, sidewalk, walkway, or concrete area, send us an email."
    >
      <Fragment slot="actions">
        <Button href="/">Back Home</Button>
        <Button
          href={`mailto:${site.email}`}
          variant="secondary"
          data-cta="email"
          data-cta-location="thank-you"
        >
          Email CFL Wash Co.
        </Button>
      </Fragment>
    </HeroSection>
  </main>
</Layout>
