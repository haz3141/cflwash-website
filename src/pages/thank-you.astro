---
import Button from '../components/ui/Button.astro'
import Card from '../components/ui/Card.astro'
import Breadcrumbs from '../components/site/Breadcrumbs.astro'
import HeroSection from '../components/patterns/HeroSection.astro'
import Section from '../components/ui/Section.astro'
import Layout from '../layouts/Layout.astro'
import { site } from '../data/site'
import { Mail, Phone } from '@lucide/astro'

const breadcrumbs = [{ label: 'Home', href: '/' }, { label: 'Thank You' }]
const hasPhone = Boolean(site.phoneDisplay && site.phoneHref)
---

<Layout
  title="Thank You | CFL Wash Co."
  description="Confirmation page for quote requests and contact follow-up."
  canonicalPath="/thank-you"
  noindex={true}
>
  <main>
    <Breadcrumbs items={breadcrumbs} />

    <HeroSection
      tone="soft"
      eyebrow="Thank You"
      title="Thanks for reaching out."
      description="If you just submitted the quote form, your request is on its way. If you want to add surface details or send photos, email CFL Wash Co. and include the same name and property context."
    >
      <Fragment slot="actions">
        <Button
          href={`mailto:${site.email}`}
          data-cta="email"
          data-cta-location="thank-you"
        >
          <Mail
            slot="startIcon"
            class="h-5 w-5"
            aria-hidden="true"
            stroke-width="1.8"
          />
          Email more details
        </Button>
        <Button href="/" variant="secondary">Back Home</Button>
      </Fragment>
    </HeroSection>

    <Section spacing="compact" class="pb-20">
      <div class="grid gap-6 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)]">
        <Card tone="raised" padding="lg">
          <h2 class="text-xl font-semibold text-[var(--color-text)]">
            What happens next
          </h2>
          <ol class="mt-5 space-y-4 text-sm leading-6 text-[var(--color-text)]">
            <li class="flex gap-3">
              <span
                class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-surface)] text-xs font-semibold text-[var(--color-action)] ring-1 ring-[var(--color-border)]"
              >
                1
              </span>
              <span
                >CFL Wash Co. reviews the city, surfaces, and request notes you
                sent.</span
              >
            </li>
            <li class="flex gap-3">
              <span
                class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-surface)] text-xs font-semibold text-[var(--color-action)] ring-1 ring-[var(--color-border)]"
              >
                2
              </span>
              <span
                >If anything needs clarification, follow-up happens by email or
                phone using the contact details from the request.</span
              >
            </li>
            <li class="flex gap-3">
              <span
                class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-surface)] text-xs font-semibold text-[var(--color-action)] ring-1 ring-[var(--color-border)]"
              >
                3
              </span>
              <span
                >Scheduling is discussed after the request is reviewed. The
                thank-you page is not a booking confirmation.</span
              >
            </li>
          </ol>
        </Card>

        <Card tone="soft" padding="lg">
          <h2 class="text-xl font-semibold text-[var(--color-text)]">
            Want to add photos or access notes?
          </h2>
          <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
            Reply by email with the same name, city, and surface details so the
            follow-up stays easy to match to your request.
          </p>

          <div class="mt-6 space-y-3">
            <Button
              href={`mailto:${site.email}`}
              data-cta="email"
              data-cta-location="thank-you-follow-up"
            >
              <Mail
                slot="startIcon"
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
              Email {site.email}
            </Button>
            {
              hasPhone && (
                <Button
                  href={site.phoneHref}
                  variant="secondary"
                  data-cta="call"
                  data-cta-location="thank-you-follow-up"
                >
                  <Phone
                    slot="startIcon"
                    class="h-5 w-5"
                    aria-hidden="true"
                    stroke-width="1.8"
                  />
                  Call {site.phoneDisplay}
                </Button>
              )
            }
          </div>
        </Card>
      </div>
    </Section>
  </main>
</Layout>
