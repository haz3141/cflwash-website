---
import Button from '../components/Button.astro'
import Layout from '../layouts/Layout.astro'
import Section from '../components/Section.astro'
import { site } from '../data/site'
---

<Layout
  title="Thank You | CFL Wash Co."
  description="Confirmation page for quote requests and contact follow-up."
  canonicalPath="/thank-you"
>
  <main>
    <Section class="py-20">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-600">
        Thank You
      </p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl">
        Your request has been received.
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-8 text-slate-600 sm:text-lg">
        This is a static confirmation route for the future form workflow. It gives
        the site a stable destination for post-submit navigation.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <Button href="/">Back Home</Button>
        <Button href={site.phoneHref} variant="secondary">
          Call {site.phoneDisplay}
        </Button>
      </div>
    </Section>
  </main>
</Layout>
