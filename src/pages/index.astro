---
import Button from '../components/ui/Button.astro'
import Card from '../components/ui/Card.astro'
import Section from '../components/ui/Section.astro'
import Layout from '../layouts/Layout.astro'
import { services } from '../data/services'
import { serviceAreas } from '../data/serviceAreas'
import { site } from '../data/site'

const hasPhone = Boolean(site.phoneDisplay && site.phoneHref)
const secondaryHeroHref = hasPhone ? site.phoneHref : `mailto:${site.email}`
const secondaryHeroLabel = hasPhone
  ? `Call ${site.phoneDisplay}`
  : 'Email CFL Wash Co.'

const trustCues = [
  {
    label: 'Central Florida based',
    detail: 'Serving homeowners across the local area',
  },
  {
    label: 'Driveways, sidewalks, and concrete',
    detail: 'Focused curb appeal cleaning for hard surfaces',
  },
  {
    label: 'HOA notice cleanup',
    detail: 'Quote-first help for visible concrete buildup',
  },
  {
    label: 'Simple quote path',
    detail: 'Request a quote before any work is scheduled',
  },
]

const processSteps = [
  {
    title: 'Request a quote',
    description:
      'Share the surface, city, and a few details about the driveway, sidewalk, walkway, or concrete area.',
  },
  {
    title: 'Confirm the scope',
    description:
      'CFL Wash Co. reviews the job details and confirms the best cleaning plan before work begins.',
  },
  {
    title: 'Clean the concrete',
    description:
      'The work stays focused on cleaner-looking concrete and practical curb appeal for the property.',
  },
]

const unlinkedServiceAreas = ['DeLand', 'Sanford', 'Lake Mary']
---

<Layout
  title="Driveway, Sidewalk, and Concrete Cleaning in Central Florida | CFL Wash Co."
  description="Request a simple quote for driveway, walkway, sidewalk, and concrete cleaning across Central Florida."
  canonicalPath="/"
>
  <main>
    <section class="overflow-hidden bg-[var(--color-surface)]">
      <div
        class="mx-auto grid w-full max-w-[var(--container-width)] gap-12 px-6 py-16 lg:grid-cols-[minmax(0,1fr)_minmax(22rem,0.92fr)] lg:items-center lg:py-24"
      >
        <div>
          <p
            class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-primary)]"
          >
            Serving Central Florida
          </p>
          <h1
            class="mt-4 max-w-3xl text-4xl font-semibold leading-tight text-[var(--color-text)] sm:text-5xl lg:text-6xl"
          >
            Driveway, Sidewalk, and Concrete Cleaning in Central Florida
          </h1>
          <p
            class="mt-5 max-w-2xl text-base leading-8 text-[var(--color-text-muted)] sm:text-lg"
          >
            Simple quotes for driveway, walkway, sidewalk, and concrete cleaning
            across Central Florida. Built for curb appeal, HOA notices, and
            cleaner-looking concrete.
          </p>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <Button
              href="/request-quote"
              data-cta="quote"
              data-cta-location="home-hero"
            >
              Request a Quote
            </Button>
            {
              secondaryHeroHref && (
                <Button
                  href={secondaryHeroHref}
                  variant="secondary"
                  data-cta={hasPhone ? 'call' : 'email'}
                  data-cta-location="home-hero"
                >
                  {secondaryHeroLabel}
                </Button>
              )
            }
          </div>
        </div>

        <div
          class="relative aspect-[16/13] overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-white shadow-sm sm:aspect-[16/10] lg:aspect-[11/12]"
          aria-hidden="true"
        >
          <img
            src="/images/brand/hero-homepage.jpg"
            alt=""
            width="1280"
            height="675"
            class="h-full w-full object-cover object-center"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
      </div>
    </section>

    <section class="border-y border-[var(--color-border)] bg-white">
      <div
        class="mx-auto grid w-full max-w-[var(--container-width)] gap-4 px-6 py-6 sm:grid-cols-2 lg:grid-cols-4"
      >
        {
          trustCues.map((cue) => (
            <div class="flex gap-3">
              <span class="mt-1 h-2.5 w-2.5 shrink-0 rounded-full bg-[var(--color-secondary)]" />
              <div>
                <p class="text-sm font-semibold text-[var(--color-text)]">
                  {cue.label}
                </p>
                <p class="mt-1 text-sm leading-6 text-[var(--color-text-muted)]">
                  {cue.detail}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <Section
      id="services"
      eyebrow="Services"
      title="Concrete-focused exterior cleaning"
      description="Start with the surfaces homeowners notice first: driveways, sidewalks, walkways, and concrete around the property."
      class="scroll-mt-24"
    >
      <div class="grid gap-4 md:grid-cols-3">
        {
          services.map((service) => (
            <Card class="flex h-full flex-col bg-white">
              <div class="mb-5 h-10 w-10 rounded-[var(--radius-md)] bg-[var(--color-primary)]/10 ring-1 ring-[var(--color-primary)]/15" />
              <h3 class="text-lg font-semibold text-[var(--color-text)]">
                {service.name}
              </h3>
              <p class="mt-3 flex-1 text-sm leading-7 text-[var(--color-text-muted)]">
                {service.summary}
              </p>
              <a
                href={`/${service.slug}`}
                class="mt-6 inline-flex text-sm font-semibold text-[var(--color-primary)] hover:text-[var(--color-primary-hover)] focus:outline-none focus-visible:rounded-[var(--radius-sm)] focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring)] focus-visible:ring-offset-2"
              >
                View service
              </a>
            </Card>
          ))
        }
      </div>
    </Section>

    <section class="bg-[var(--color-surface)]">
      <div
        class="mx-auto grid w-full max-w-[var(--container-width)] gap-8 px-6 py-[var(--section-spacing)] lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:items-center"
      >
        <div>
          <p
            class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-primary)]"
          >
            HOA and curb appeal
          </p>
          <h2
            class="mt-3 text-3xl font-semibold leading-tight text-[var(--color-text)] sm:text-4xl"
          >
            A practical cleanup path for visible concrete.
          </h2>
          <p class="mt-4 text-base leading-8 text-[var(--color-text-muted)]">
            HOA notices and curb appeal projects usually start with the surfaces
            closest to the street. CFL Wash Co. keeps the service focus on
            driveway, walkway, sidewalk, and concrete cleaning so the quote
            stays clear.
          </p>
          <div class="mt-7">
            <Button
              href="/request-quote"
              data-cta="quote"
              data-cta-location="home-hoa"
            >
              Request a Quote
            </Button>
          </div>
        </div>

        <div class="grid gap-3 sm:grid-cols-2">
          {
            [
              'Driveway and front walk refreshes',
              'Sidewalk cleaning for neighborhood presentation',
              'Concrete patios, pads, aprons, and entry areas',
              'Quote-first scope before work is scheduled',
            ].map((item) => (
              <div class="rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-white p-5">
                <span class="block h-1 w-10 rounded-full bg-[var(--color-accent)]" />
                <p class="mt-4 text-sm font-semibold leading-6 text-[var(--color-text)]">
                  {item}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <Section
      eyebrow="Process"
      title="Simple quote-first process"
      description="Request a quote, confirm the scope, and move forward with the concrete cleaning that fits the property."
    >
      <div class="grid gap-4 md:grid-cols-3">
        {
          processSteps.map((step, index) => (
            <Card class="bg-white">
              <div class="flex items-center gap-4">
                <span class="flex h-10 w-10 items-center justify-center rounded-full bg-[var(--color-primary)] text-sm font-semibold text-white">
                  {index + 1}
                </span>
                <h3 class="text-base font-semibold text-[var(--color-text)]">
                  {step.title}
                </h3>
              </div>
              <p class="mt-4 text-sm leading-7 text-[var(--color-text-muted)]">
                {step.description}
              </p>
            </Card>
          ))
        }
      </div>
    </Section>

    <section
      id="service-areas"
      class="scroll-mt-24 border-y border-[var(--color-border)] bg-[var(--color-surface)]"
    >
      <div
        class="mx-auto grid w-full max-w-[var(--container-width)] gap-8 px-6 py-[var(--section-spacing)] lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]"
      >
        <div>
          <p
            class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-primary)]"
          >
            Service areas
          </p>
          <h2
            class="mt-3 text-2xl font-semibold text-[var(--color-text)] sm:text-3xl"
          >
            Serving Central Florida homeowners.
          </h2>
          <p
            class="mt-3 text-sm leading-7 text-[var(--color-text-muted)] sm:text-base"
          >
            Explore the current service area pages below. Additional nearby
            cities are listed as part of the broader Central Florida service
            area.
          </p>
        </div>

        <div class="grid gap-3 sm:grid-cols-2">
          {
            serviceAreas.map((area) => (
              <a
                href={`/service-areas/${area.slug}`}
                class="rounded-[var(--radius-md)] border border-[var(--color-border)] bg-white p-4 text-sm font-semibold text-[var(--color-text)] transition-colors hover:border-[var(--color-primary)] hover:text-[var(--color-primary)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring)] focus-visible:ring-offset-2"
              >
                {area.name}
              </a>
            ))
          }
          {
            unlinkedServiceAreas.map((area) => (
              <p class="rounded-[var(--radius-md)] border border-dashed border-[var(--color-border)] bg-white/70 p-4 text-sm font-semibold text-[var(--color-text-muted)]">
                {area}
              </p>
            ))
          }
        </div>
      </div>
    </section>

    <section class="px-6 py-[var(--section-spacing)]">
      <div
        class="mx-auto max-w-[var(--container-width)] overflow-hidden rounded-[var(--radius-lg)] bg-[var(--color-primary)] px-6 py-12 text-center text-white shadow-sm sm:px-10"
      >
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-white/75"
        >
          Ready for a cleaner-looking driveway?
        </p>
        <h2 class="mx-auto mt-3 max-w-2xl text-3xl font-semibold sm:text-4xl">
          Request a simple Central Florida concrete cleaning quote.
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-base leading-8 text-white/85">
          Tell CFL Wash Co. what needs attention and get a clear next step for
          driveway, walkway, sidewalk, or concrete cleaning.
        </p>
        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
          <Button
            href="/request-quote"
            variant="secondary"
            class="bg-white text-[var(--color-primary)] hover:bg-[var(--color-surface)]"
            data-cta="quote"
            data-cta-location="home-final"
          >
            Request a Quote
          </Button>
          <Button
            href={secondaryHeroHref}
            variant="ghost"
            class="text-white ring-1 ring-inset ring-white/35 hover:bg-white/10"
            data-cta={hasPhone ? 'call' : 'email'}
            data-cta-location="home-final"
          >
            {secondaryHeroLabel}
          </Button>
        </div>
      </div>
    </section>
  </main>
</Layout>
