---
import CTA from '../components/sections/CTA.astro'
import ServiceCard from '../components/sections/ServiceCard.astro'
import Button from '../components/ui/Button.astro'
import Card from '../components/ui/Card.astro'
import Section from '../components/ui/Section.astro'
import Layout from '../layouts/Layout.astro'
import { services } from '../data/services'
import { serviceAreas } from '../data/serviceAreas'
import { site } from '../data/site'
---

<Layout>
  <main>
    <section class="border-b border-[var(--color-border)]">
      <div
        class="mx-auto grid w-full max-w-[var(--container-width)] gap-10 px-6 py-20 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] lg:items-end lg:py-24"
      >
        <div>
          <p
            class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-text-muted)]"
          >
            {site.serviceArea}
          </p>
          <h1
            class="mt-4 max-w-3xl text-4xl font-semibold text-[var(--color-text)] sm:text-5xl"
          >
            Pressure washing for driveways, sidewalks, walkways, and concrete.
          </h1>
          <p
            class="mt-5 max-w-2xl text-base leading-8 text-[var(--color-text-muted)] sm:text-lg"
          >
            {site.tagline} This version keeps the site static and simple while the
            content foundation is established.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <Button href="/request-quote">Request a Quote</Button>
            <Button href={`mailto:${site.email}`} variant="secondary">
              Email CFL Wash Co.
            </Button>
          </div>
        </div>

        <Card class="bg-[var(--color-surface)] p-6">
          <p class="text-sm font-semibold text-[var(--color-text)]">
            Core services
          </p>
          <ul
            class="mt-4 space-y-3 text-sm leading-6 text-[var(--color-text-muted)]"
          >
            {services.map((service) => <li>{service.name}</li>)}
          </ul>
          <p class="mt-6 text-sm text-[var(--color-text-muted)]">
            Placeholder service foundation for build-out, content, and future
            visual direction.
          </p>
        </Card>
      </div>
    </section>

    <Section
      eyebrow="Services"
      title="Primary service pages"
      description="Each service page is a standalone static route so the site can grow without changing the structure."
    >
      <div class="grid gap-4 md:grid-cols-3">
        {
          services.map((service) => (
            <ServiceCard
              title={service.name}
              description={service.summary}
              href={`/${service.slug}`}
            />
          ))
        }
      </div>
    </Section>

    <Section
      eyebrow="Coverage"
      title="Service areas"
      description="The foundation includes the initial local area pages we know we need."
    >
      <div class="grid gap-4 md:grid-cols-3">
        {
          serviceAreas.map((area) => (
            <Card>
              <h3 class="text-base font-semibold text-[var(--color-text)]">
                {area.name}
              </h3>
              <p class="mt-2 text-sm leading-6 text-[var(--color-text-muted)]">
                {area.description}
              </p>
              <a
                href={`/service-areas/${area.slug}`}
                class="mt-4 inline-flex text-sm font-medium text-[var(--color-primary)] hover:text-[var(--color-primary-hover)] focus:outline-none focus-visible:rounded-[var(--radius-sm)] focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring)] focus-visible:ring-offset-2"
              >
                View area page
              </a>
            </Card>
          ))
        }
      </div>
    </Section>

    <CTA
      title="Start with the route structure."
      description="The site now has the pages, shared components, and SEO scaffolding needed before visual direction is finalized in Stitch."
      primaryHref="/request-quote"
      primaryLabel="Request a Quote"
      secondaryHref={`mailto:${site.email}`}
      secondaryLabel="Email CFL Wash Co."
    />
  </main>
</Layout>
