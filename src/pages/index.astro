---
import HomeServiceCard from '../components/home/HomeServiceCard.astro'
import WaterWaveDivider from '../components/home/WaterWaveDivider.astro'
import OrganizationSchema from '../components/site/OrganizationSchema.astro'
import Button from '../components/ui/Button.astro'
import IconBadge from '../components/ui/IconBadge.astro'
import Layout from '../layouts/Layout.astro'
import { publicMedia } from '../data/publicMedia'
import { serviceAreas } from '../data/serviceAreas'
import { site } from '../data/site'
import {
  ArrowRight,
  BadgeCheck,
  Blocks,
  CalendarCheck2,
  CarFront,
  Check,
  ClipboardCheck,
  ClipboardList,
  Droplets,
  Footprints,
  House,
  MapPin,
  Phone,
  ShieldCheck,
  Sparkles,
  Waves,
} from '@lucide/astro'

const hasPhone = Boolean(site.phoneDisplay && site.phoneHref)

const heroBenefits = [
  { icon: Sparkles, title: 'Boosts curb appeal' },
  { icon: House, title: 'HOA notice support' },
  { icon: ShieldCheck, title: 'Surface-aware review' },
  { icon: CalendarCheck2, title: 'Clear next steps' },
]

const trustItems = [
  {
    icon: MapPin,
    title: 'Central Florida Focus',
    description: 'Published local pages for the cities currently served.',
  },
  {
    icon: Droplets,
    title: 'Concrete-First Scope',
    description:
      'Driveways, sidewalks, walkways, entries, and similar surfaces.',
  },
  {
    icon: ClipboardCheck,
    title: 'Quote Before Scheduling',
    description:
      'Property details, surfaces, photos, and notes are reviewed first.',
  },
  {
    icon: BadgeCheck,
    title: 'Clear Job Details',
    description: 'Know which areas are included before a visit is arranged.',
  },
]

const serviceCards = [
  {
    title: 'Driveway Pressure Washing',
    description:
      'Remove visible buildup and refresh the front approach to your home.',
    href: '/driveway-pressure-washing',
    media: publicMedia.serviceDriveway,
    icon: CarFront,
  },
  {
    title: 'Sidewalk Cleaning',
    description:
      'Refresh street-facing sidewalk panels and everyday pedestrian paths.',
    href: '/sidewalk-walkway-cleaning',
    media: publicMedia.serviceWalkway,
    icon: Footprints,
  },
  {
    title: 'Walkway Cleaning',
    description:
      'Restore the look of entry walks and paths leading toward the home.',
    href: '/sidewalk-walkway-cleaning',
    media: publicMedia.serviceWalkway,
    icon: Waves,
  },
  {
    title: 'Concrete Cleaning',
    description:
      'Clean appropriate patios, pads, aprons, curbs, and entry surfaces.',
    href: '/concrete-cleaning',
    media: publicMedia.serviceConcrete,
    icon: Blocks,
  },
  {
    title: 'HOA Notice Cleanup',
    description:
      'Start with the cited surface and include the notice wording for review.',
    href: '/request-quote',
    media: publicMedia.serviceDriveway,
    icon: ClipboardList,
  },
  {
    title: 'Curb Appeal Cleanup',
    description:
      'Bundle visible front-of-home surfaces into one focused quote request.',
    href: '/request-quote',
    media: publicMedia.serviceConcrete,
    icon: Sparkles,
  },
]

const reasons = [
  'Local Central Florida service-area focus',
  'Concrete-first launch scope',
  'Photos and property details reviewed before scheduling',
  'Connected surfaces can be included in one quote request',
]

const processFeatures = [
  {
    icon: ClipboardCheck,
    title: 'Send the Details',
    description:
      'Share the city, surfaces, photos, access notes, and useful context.',
  },
  {
    icon: Phone,
    title: 'Review the Scope',
    description: hasPhone
      ? `Questions can be discussed at ${site.phoneDisplay}.`
      : 'Questions can be discussed through the published contact details.',
  },
  {
    icon: Check,
    title: 'Plan the Visit',
    description:
      'Confirm what is included before arranging the cleaning visit.',
  },
]
---

<Layout
  title="CFL Wash Co. | Pressure Washing in Central Florida"
  description="Request a clear quote for driveway, sidewalk, walkway, and concrete cleaning across Central Florida."
  canonicalPath="/"
  ogImage="/images/brand/og-default.png"
  ogImageAlt="CFL Wash Co. exterior cleaning in Central Florida"
>
  <OrganizationSchema slot="head" />

  <main>
    <section
      class="relative overflow-hidden bg-[var(--color-surface-warm)] pt-10 sm:pt-14 lg:pt-16"
    >
      <div
        class="hero-art-panel pointer-events-none absolute inset-0 opacity-45"
        aria-hidden="true"
      >
      </div>

      <div
        class="relative mx-auto grid w-full max-w-[82rem] min-w-0 items-center gap-9 px-[var(--container-gutter)] pb-3 lg:grid-cols-[minmax(0,0.9fr)_minmax(25rem,1.1fr)] lg:gap-6"
      >
        <div class="relative z-10 min-w-0 max-w-[42rem]">
          <p class="text-eyebrow text-[var(--color-accent)]">
            Exterior cleaning made easy
          </p>
          <h1
            class="mt-4 max-w-[10ch] text-[clamp(3.2rem,6.7vw,6.35rem)] font-semibold leading-[0.93] tracking-[-0.058em] text-[var(--color-text)]"
          >
            Curb Appeal You Can See<span
              class="text-[var(--color-accent)]"
              aria-hidden="true">.</span
            >
          </h1>
          <p
            class="hero-mobile-measure mt-6 text-base leading-7 text-[var(--color-text-muted)] sm:text-lg sm:leading-8"
          >
            Exterior concrete cleaning for homes across Central Florida. Start
            with the driveway, sidewalk, walkway, curb, or front approach that
            needs attention most.
          </p>

          <div class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-3">
            {
              heroBenefits.map((benefit) => (
                <div class="flex items-center gap-2.5 sm:border-r sm:border-[var(--color-border)] sm:pr-2 sm:last:border-r-0">
                  <IconBadge
                    icon={benefit.icon}
                    tone="default"
                    size="sm"
                    class="theme-shadow-xs shrink-0 text-[var(--color-action)]"
                  />
                  <p class="text-[0.72rem] font-semibold leading-4 text-[var(--color-text)]">
                    {benefit.title}
                  </p>
                </div>
              ))
            }
          </div>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <Button
              href="/request-quote"
              variant="accent"
              size="lg"
              fullWidth
              class="sm:w-auto"
              data-cta="quote"
              data-cta-location="home-hero"
            >
              Get a Free Quote
              <ArrowRight
                slot="endIcon"
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
            </Button>
            <Button
              href="/services"
              variant="light"
              size="lg"
              fullWidth
              class="sm:w-auto"
            >
              View Services
            </Button>
          </div>

          <p
            class="mt-7 flex items-center gap-2 text-sm font-semibold text-[var(--color-text)]"
          >
            <MapPin
              class="h-4 w-4 text-[var(--color-action)]"
              aria-hidden="true"
              stroke-width="1.8"
            />
            Proudly serving Central Florida
          </p>
        </div>

        <div
          class="relative z-10 mx-auto w-full max-w-full min-w-0 lg:-mb-6 lg:max-w-[39rem]"
        >
          <div
            class="hero-art-glow absolute inset-x-[12%] bottom-[4%] top-[12%] rounded-[45%]"
            aria-hidden="true"
          >
          </div>
          <img
            src="/images/brand/badge-illustrated.png"
            alt="CFL Wash Co. illustrated Central Florida exterior cleaning badge"
            width="1024"
            height="1024"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            class="hero-art-image relative mx-auto max-h-[39rem] w-full object-contain"
            data-media-id="brand-illustrated-badge"
            data-media-role="brand-artwork"
            data-proof-status="not-proof"
          />
        </div>
      </div>

      <WaterWaveDivider />
    </section>

    <section
      class="bg-[var(--color-surface-inverse)] text-[var(--color-text-inverse)]"
    >
      <div
        class="mx-auto grid w-full max-w-[82rem] px-[var(--container-gutter)] pb-10 pt-1 sm:grid-cols-2 lg:grid-cols-4 lg:pb-12"
      >
        {
          trustItems.map((item, index) => (
            <article
              class:list={[
                'flex flex-col items-center border-[var(--color-inverse-border)] px-5 py-6 text-center',
                index > 0 && 'border-t sm:border-t-0',
                index % 2 === 1 && 'sm:border-l',
                index > 1 && 'sm:border-t lg:border-t-0',
                index > 0 && 'lg:border-l',
              ]}
            >
              <IconBadge
                icon={item.icon}
                tone="inverse"
                size="lg"
                class="text-[var(--color-accent)]"
              />
              <h2 class="mt-4 text-sm font-semibold text-[var(--color-accent)]">
                {item.title}
              </h2>
              <p class="mt-2 max-w-[15rem] text-xs leading-5 text-[var(--color-inverse-muted)]">
                {item.description}
              </p>
            </article>
          ))
        }
      </div>
    </section>

    <section id="services" class="bg-[var(--color-page)] py-16 sm:py-20">
      <div class="mx-auto w-full max-w-[90rem] px-[var(--container-gutter)]">
        <div class="mx-auto max-w-2xl text-center">
          <p class="text-eyebrow text-[var(--color-accent)]">Our services</p>
          <h2 class="mt-3 text-section-title text-[var(--color-text)]">
            Exterior cleaning that makes a difference
          </h2>
          <p class="mt-4 text-base leading-7 text-[var(--color-text-muted)]">
            Choose the surface or situation that best matches the property.
            These illustrative visuals support the service categories and are
            not presented as photos of completed CFL Wash Co. projects.
          </p>
        </div>

        <div
          class="mt-10 grid grid-cols-2 gap-3 md:grid-cols-3 lg:gap-4 xl:grid-cols-6"
        >
          {serviceCards.map((card) => <HomeServiceCard {...card} />)}
        </div>

        <div class="mt-9 flex justify-center">
          <Button href="/services" variant="secondary" size="lg">
            Explore All Services
            <ArrowRight
              slot="endIcon"
              class="h-5 w-5"
              aria-hidden="true"
              stroke-width="1.8"
            />
          </Button>
        </div>
      </div>
    </section>

    <section
      id="why-cfl-wash"
      class="scroll-mt-20 overflow-hidden bg-[var(--color-surface-inverse)] text-[var(--color-text-inverse)]"
    >
      <div
        class="mx-auto grid w-full max-w-[90rem] lg:grid-cols-[minmax(0,0.78fr)_minmax(0,1.22fr)]"
      >
        <div
          class="flex flex-col justify-center px-[var(--container-gutter)] py-14 lg:px-12 lg:py-16 xl:px-16"
        >
          <p class="text-eyebrow text-[var(--color-accent)]">
            Why homeowners choose us
          </p>
          <h2 class="mt-4 text-section-title text-[var(--color-text-inverse)]">
            More than clean. It is confidence in the next step.
          </h2>
          <p class="mt-5 text-base leading-7 text-[var(--color-inverse-muted)]">
            The launch offer stays focused on visible hard surfaces around the
            home. The request is reviewed first so the proposed scope is clear
            before scheduling.
          </p>

          <ul class="mt-7 space-y-3">
            {
              reasons.map((reason) => (
                <li class="flex items-start gap-3 text-sm leading-6 text-[var(--color-text-inverse)]">
                  <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-[var(--color-accent)] text-[var(--color-accent)]">
                    <Check
                      class="h-3.5 w-3.5"
                      aria-hidden="true"
                      stroke-width="2"
                    />
                  </span>
                  {reason}
                </li>
              ))
            }
          </ul>

          <div class="mt-8">
            <Button href="/service-areas" variant="light" size="lg">
              Explore Service Areas
            </Button>
          </div>
        </div>

        <div
          class="relative min-h-[25rem] lg:min-h-[37rem]"
          data-media-id={publicMedia.brandResidentialContext.id}
          data-media-role={publicMedia.brandResidentialContext.role}
          data-proof-status={publicMedia.brandResidentialContext.proofStatus}
        >
          <img
            src={publicMedia.brandResidentialContext.image.src}
            srcset={publicMedia.brandResidentialContext.image.sources
              .map(({ src, width }) => `${src} ${width}w`)
              .join(', ')}
            sizes="(min-width: 1024px) 55vw, 100vw"
            alt={publicMedia.brandResidentialContext.alt}
            width={publicMedia.brandResidentialContext.image.width}
            height={publicMedia.brandResidentialContext.image.height}
            loading="lazy"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover"
          />
          <div class="hero-media-overlay absolute inset-0" aria-hidden="true">
          </div>
        </div>
      </div>
    </section>

    <section class="bg-[var(--color-surface-warm)] py-7">
      <div
        class="mx-auto flex w-full max-w-[var(--container-width)] flex-wrap items-center justify-center gap-x-3 gap-y-2 px-[var(--container-gutter)] text-center"
      >
        <MapPin
          class="h-5 w-5 text-[var(--color-action)]"
          aria-hidden="true"
          stroke-width="1.8"
        />
        <p class="text-sm font-semibold text-[var(--color-text)]">
          Current service areas:
        </p>
        {
          serviceAreas.map((area, index) => (
            <Fragment>
              <a
                href={`/service-areas/${area.slug}`}
                class="rounded-[var(--radius-sm)] text-sm font-semibold text-[var(--color-action)] hover:text-[var(--color-action-hover)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring)]"
              >
                {area.name}
              </a>
              {index < serviceAreas.length - 1 && (
                <span class="text-[var(--color-border-strong)]">/</span>
              )}
            </Fragment>
          ))
        }
      </div>
    </section>

    <section
      id="our-process"
      class="scroll-mt-20 bg-[var(--color-surface-raised)] py-12 sm:py-14"
    >
      <div
        class="mx-auto grid w-full max-w-[82rem] items-center gap-9 px-[var(--container-gutter)] lg:grid-cols-[minmax(0,0.92fr)_minmax(0,1.08fr)]"
      >
        <div>
          <div class="flex items-start gap-4">
            <IconBadge
              icon={CalendarCheck2}
              tone="warm"
              size="lg"
              class="shrink-0 text-[var(--color-accent)]"
            />
            <div>
              <p class="text-eyebrow text-[var(--color-accent)]">
                Ready for a cleaner property?
              </p>
              <h2
                class="mt-2 text-3xl font-semibold leading-tight text-[var(--color-text)] sm:text-4xl"
              >
                A clear quote starts with a few details.
              </h2>
            </div>
          </div>
          <p
            class="mt-4 max-w-xl text-sm leading-6 text-[var(--color-text-muted)]"
          >
            Include the city, surfaces, photos, access notes, and any HOA
            wording that helps explain the request.
          </p>
          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <Button
              href="/request-quote"
              variant="accent"
              size="lg"
              fullWidth
              class="sm:w-auto"
              data-cta="quote"
              data-cta-location="home-final"
            >
              Get Your Free Quote
              <ArrowRight
                slot="endIcon"
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
            </Button>
            {
              hasPhone && (
                <Button
                  href={site.phoneHref}
                  variant="secondary"
                  size="lg"
                  fullWidth
                  class="sm:w-auto"
                  data-cta="call"
                  data-cta-location="home-final"
                >
                  Call {site.phoneDisplay}
                </Button>
              )
            }
          </div>
        </div>

        <div class="grid gap-5 sm:grid-cols-3">
          {
            processFeatures.map((feature) => (
              <article class="border-t border-[var(--color-border)] pt-5 sm:border-l sm:border-t-0 sm:pl-5 sm:pt-0">
                <IconBadge
                  icon={feature.icon}
                  tone="warm"
                  size="lg"
                  class="text-[var(--color-action)]"
                />
                <h3 class="mt-4 text-sm font-semibold text-[var(--color-text)]">
                  {feature.title}
                </h3>
                <p class="mt-2 text-xs leading-5 text-[var(--color-text-muted)]">
                  {feature.description}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Layout>
