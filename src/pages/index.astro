---
import Button from '../components/ui/Button.astro'
import CTASection from '../components/patterns/CTASection.astro'
import Card from '../components/ui/Card.astro'
import HeroSection from '../components/patterns/HeroSection.astro'
import IconBadge from '../components/ui/IconBadge.astro'
import LinkGrid from '../components/patterns/LinkGrid.astro'
import ProcessSteps from '../components/patterns/ProcessSteps.astro'
import Section from '../components/ui/Section.astro'
import SplitFeature from '../components/patterns/SplitFeature.astro'
import Layout from '../layouts/Layout.astro'
import { services } from '../data/services'
import { serviceAreas } from '../data/serviceAreas'
import { site } from '../data/site'
import {
  Blocks,
  CarFront,
  ClipboardCheck,
  ClipboardList,
  Footprints,
  Mail,
  MapPin,
  MessageSquareText,
  Phone,
} from '@lucide/astro'

const hasPhone = Boolean(site.phoneDisplay && site.phoneHref)
const secondaryHeroHref = hasPhone ? site.phoneHref : `mailto:${site.email}`
const secondaryHeroLabel = hasPhone
  ? `Call ${site.phoneDisplay}`
  : 'Email CFL Wash Co.'

const trustCues = [
  {
    icon: MapPin,
    label: 'Central Florida based',
    detail: 'Serving homeowners across the local area',
  },
  {
    icon: Blocks,
    label: 'Driveways, sidewalks, and concrete',
    detail: 'Focused curb appeal cleaning for hard surfaces',
  },
  {
    icon: ClipboardCheck,
    label: 'HOA notice cleanup',
    detail: 'Quote-first help for visible concrete buildup',
  },
  {
    icon: MessageSquareText,
    label: 'Simple quote path',
    detail: 'Request a quote before any work is scheduled',
  },
]

const processSteps = [
  {
    title: 'Request a quote',
    description:
      'Share the surface, city, and a few details about the driveway, sidewalk, walkway, or concrete area.',
  },
  {
    title: 'Confirm the scope',
    description:
      'CFL Wash Co. reviews the job details and confirms the best cleaning plan before work begins.',
  },
  {
    title: 'Clean the concrete',
    description:
      'The work stays focused on cleaner-looking concrete and practical curb appeal for the property.',
  },
]

const unlinkedServiceAreas = ['DeLand', 'Sanford', 'Lake Mary']
const serviceAreaLinks = [
  ...serviceAreas.map((area) => ({
    label: area.name,
    href: `/service-areas/${area.slug}`,
  })),
  ...unlinkedServiceAreas.map((area) => ({
    label: area,
    status: 'inactive' as const,
  })),
]

const serviceIcons = {
  'driveway-pressure-washing': CarFront,
  'sidewalk-walkway-cleaning': Footprints,
  'concrete-cleaning': Blocks,
} as const
---

<Layout
  title="Driveway, Sidewalk, and Concrete Cleaning in Central Florida | CFL Wash Co."
  description="Request a simple quote for driveway, walkway, sidewalk, and concrete cleaning across Central Florida."
  canonicalPath="/"
>
  <main>
    <HeroSection
      variant="split"
      tone="soft"
      eyebrow="Serving Central Florida"
      title="Driveway, Sidewalk, and Concrete Cleaning in Central Florida"
      description="Simple quotes for driveway, walkway, sidewalk, and concrete cleaning across Central Florida. Built for curb appeal, HOA notices, and cleaner-looking concrete."
    >
      <Fragment slot="actions">
        <Button
          href="/request-quote"
          size="lg"
          fullWidth
          data-cta="quote"
          data-cta-location="home-hero"
          class="sm:w-auto"
        >
          <ClipboardList
            slot="startIcon"
            class="h-5 w-5"
            aria-hidden="true"
            stroke-width="1.8"
          />
          Request a Quote
        </Button>
        {
          secondaryHeroHref && (
            <Button
              href={secondaryHeroHref}
              variant="secondary"
              size="lg"
              fullWidth
              data-cta={hasPhone ? 'call' : 'email'}
              data-cta-location="home-hero"
              class="sm:w-auto"
            >
              {!hasPhone && (
                <Mail
                  slot="startIcon"
                  class="h-5 w-5"
                  aria-hidden="true"
                  stroke-width="1.8"
                />
              )}
              {secondaryHeroLabel}
            </Button>
          )
        }
      </Fragment>

      <div
        slot="media"
        class="relative aspect-[16/13] overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-white shadow-[var(--shadow-media)] sm:aspect-[16/10] lg:aspect-[11/12]"
        aria-hidden="true"
      >
        <img
          src="/images/brand/hero-homepage.webp"
          alt=""
          width="1280"
          height="675"
          class="h-full w-full object-cover object-center"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>
    </HeroSection>

    <section
      class="border-y border-[var(--color-border)] bg-[var(--color-page)]"
    >
      <div
        class="mx-auto grid w-full max-w-[var(--container-width)] gap-4 px-[var(--container-gutter)] py-6 sm:grid-cols-2 lg:grid-cols-4"
      >
        {
          trustCues.map((cue) => (
            <Card tone="soft" padding="sm" class="flex gap-3">
              <IconBadge icon={cue.icon} tone="warm" size="sm" />
              <div>
                <p class="text-sm font-semibold text-[var(--color-text)]">
                  {cue.label}
                </p>
                <p class="mt-1 text-sm leading-6 text-[var(--color-text-muted)]">
                  {cue.detail}
                </p>
              </div>
            </Card>
          ))
        }
      </div>
    </section>

    <Section
      id="services"
      eyebrow="Services"
      title="Concrete-focused exterior cleaning"
      description="Start with the surfaces homeowners notice first: driveways, sidewalks, walkways, and concrete around the property."
      tone="soft"
      class="scroll-mt-24"
    >
      <div class="grid gap-4 md:grid-cols-3">
        {
          services.map((service) => (
            <Card
              tone="default"
              padding="lg"
              elevated
              class="flex h-full flex-col"
            >
              <IconBadge
                icon={serviceIcons[service.slug]}
                tone="soft"
                size="lg"
              />
              <h3 class="mt-5 text-section-subtitle text-[var(--color-text)]">
                {service.name}
              </h3>
              <p class="mt-3 flex-1 text-sm leading-7 text-[var(--color-text-muted)]">
                {service.summary}
              </p>
              <a
                href={`/${service.slug}`}
                class="mt-6 inline-flex text-sm font-semibold text-[var(--color-action)] transition-colors duration-[var(--duration-fast)] hover:text-[var(--color-action-hover)] focus:outline-none focus-visible:rounded-[var(--radius-sm)] focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-page)]"
              >
                View service
              </a>
            </Card>
          ))
        }
      </div>
    </Section>

    <SplitFeature
      eyebrow="HOA and curb appeal"
      title="A practical cleanup path for visible concrete."
      description="HOA notices and curb appeal projects usually start with the surfaces closest to the street. CFL Wash Co. keeps the service focus on driveway, walkway, sidewalk, and concrete cleaning so the quote stays clear."
      columns="media-heavy"
      align="center"
      titleSize="section"
      descriptionSize="lead"
    >
      <Button
        slot="actions"
        href="/request-quote"
        size="lg"
        data-cta="quote"
        data-cta-location="home-hoa"
      >
        <ClipboardList
          slot="startIcon"
          class="h-5 w-5"
          aria-hidden="true"
          stroke-width="1.8"
        />
        Request a Quote
      </Button>

      <div class="grid gap-3 sm:grid-cols-2">
        {
          [
            'Driveway and front walk refreshes',
            'Sidewalk cleaning for neighborhood presentation',
            'Concrete patios, pads, aprons, and entry areas',
            'Quote-first scope before work is scheduled',
          ].map((item) => (
            <div class="rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-page)] p-5">
              <span class="block h-1 w-10 rounded-full bg-[var(--color-accent)]" />
              <p class="mt-4 text-sm font-semibold leading-6 text-[var(--color-text)]">
                {item}
              </p>
            </div>
          ))
        }
      </div>
    </SplitFeature>

    <Section
      eyebrow="Process"
      title="Simple quote-first process"
      description="Request a quote, confirm the scope, and move forward with the concrete cleaning that fits the property."
    >
      <ProcessSteps steps={processSteps} variant="featured" cardTone="soft" />
    </Section>

    <section
      id="service-areas"
      class="scroll-mt-24 border-y border-[var(--color-border)] bg-[var(--color-surface)]"
    >
      <div
        class="mx-auto grid w-full max-w-[var(--container-width)] gap-8 px-[var(--container-gutter)] py-[var(--section-space)] lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]"
      >
        <div>
          <p class="text-eyebrow text-[var(--color-action)]">Service areas</p>
          <h2 class="mt-3 text-section-title text-[var(--color-text)]">
            Serving Central Florida homeowners.
          </h2>
          <p class="mt-3 text-lead text-[var(--color-text-muted)]">
            Explore the current service area pages below. Additional nearby
            cities are listed as part of the broader Central Florida service
            area.
          </p>
        </div>

        <LinkGrid items={serviceAreaLinks} variant="cards" columns="two" />
      </div>
    </section>

    <CTASection
      eyebrow="Ready for a cleaner-looking driveway?"
      title="Request a simple Central Florida concrete cleaning quote."
      description="Tell CFL Wash Co. what needs attention and get a clear next step for driveway, walkway, sidewalk, or concrete cleaning."
      surface="elevated"
    >
      <Fragment slot="actions">
        <Button
          href="/request-quote"
          variant="secondary"
          size="lg"
          fullWidth
          class="bg-white text-[var(--color-action)] hover:bg-[var(--color-surface)] sm:w-auto"
          data-cta="quote"
          data-cta-location="home-final"
        >
          <ClipboardList
            slot="startIcon"
            class="h-5 w-5"
            aria-hidden="true"
            stroke-width="1.8"
          />
          Request a Quote
        </Button>
        <Button
          href={secondaryHeroHref}
          variant="ghost"
          size="lg"
          fullWidth
          class="text-white ring-1 ring-inset ring-white/35 hover:bg-white/10 sm:w-auto"
          data-cta={hasPhone ? 'call' : 'email'}
          data-cta-location="home-final"
        >
          {
            hasPhone ? (
              <Phone
                slot="startIcon"
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
            ) : (
              <Mail
                slot="startIcon"
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
            )
          }
          {secondaryHeroLabel}
        </Button>
      </Fragment>
    </CTASection>
  </main>
</Layout>
