---
import Layout from '../layouts/Layout.astro'
import { site } from '../data/site'
---

<Layout canonicalPath="/">
  <main class="min-h-screen bg-slate-50">
    <section class="mx-auto flex min-h-screen max-w-6xl flex-col justify-center px-6 py-20">
      <p class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-blue-700">
        {site.name}
      </p>

      <h1 class="max-w-3xl text-4xl font-bold tracking-tight text-slate-950 sm:text-6xl">
        Driveway, sidewalk, and exterior cleaning in Central Florida.
      </h1>

      <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-700">
        {site.tagline} Starting with driveway, walkway, sidewalk, and concrete
        cleaning for curb appeal and HOA notices.
      </p>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <a
          href="/request-quote"
          class="rounded-2xl bg-blue-700 px-6 py-4 text-center font-semibold text-white shadow-sm hover:bg-blue-800"
        >
          Request a Quote
        </a>

        <a
          href={site.phoneHref}
          class="rounded-2xl border border-slate-300 bg-white px-6 py-4 text-center font-semibold text-slate-950 shadow-sm hover:bg-slate-100"
        >
          Call {site.phoneDisplay}
        </a>
      </div>
    </section>
  </main>
</Layout>
