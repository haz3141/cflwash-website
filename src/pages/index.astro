---
import Button from '../components/ui/Button.astro'
import CTASection from '../components/patterns/CTASection.astro'
import Card from '../components/ui/Card.astro'
import HeroSection from '../components/patterns/HeroSection.astro'
import IconBadge from '../components/ui/IconBadge.astro'
import LinkGrid from '../components/patterns/LinkGrid.astro'
import ProcessSteps from '../components/patterns/ProcessSteps.astro'
import OrganizationSchema from '../components/site/OrganizationSchema.astro'
import Section from '../components/ui/Section.astro'
import SplitFeature from '../components/patterns/SplitFeature.astro'
import Layout from '../layouts/Layout.astro'
import { services } from '../data/services'
import { serviceAreas } from '../data/serviceAreas'
import { site } from '../data/site'
import {
  Blocks,
  CarFront,
  ClipboardCheck,
  ClipboardList,
  Footprints,
  Mail,
  MapPin,
  MessageSquareText,
  Phone,
} from '@lucide/astro'

const hasPhone = Boolean(site.phoneDisplay && site.phoneHref)
const secondaryHeroHref = hasPhone ? site.phoneHref : `mailto:${site.email}`
const secondaryHeroLabel = hasPhone
  ? `Call ${site.phoneDisplay}`
  : 'Email CFL Wash Co.'

const trustCues = [
  {
    icon: MapPin,
    label: 'Local service area',
    detail:
      'Focused on Central Florida homes, starting with published city pages',
  },
  {
    icon: MessageSquareText,
    label: 'Quote before scheduling',
    detail:
      'Share the city, surface, and job notes so the request can be reviewed',
  },
  {
    icon: ClipboardCheck,
    label: 'Concrete-first scope',
    detail:
      'Built around driveways, sidewalks, walkways, and similar hard surfaces',
  },
]

const processSteps = [
  {
    title: 'Send the basics',
    description:
      'Include the city, surface type, and what prompted the cleanup, such as buildup, curb appeal, or an HOA notice.',
  },
  {
    title: 'Review the request',
    description:
      'CFL Wash Co. reviews the details before scheduling so the scope stays clear for the property.',
  },
  {
    title: 'Plan the cleaning',
    description:
      'If the job is a fit, the next step is focused concrete cleaning for the agreed surfaces.',
  },
]

const serviceAreaLinks = serviceAreas.map((area) => ({
  label: area.name,
  href: `/service-areas/${area.slug}`,
  description: 'View city page',
}))

const serviceIcons = {
  'driveway-pressure-washing': CarFront,
  'sidewalk-walkway-cleaning': Footprints,
  'concrete-cleaning': Blocks,
} as const

const serviceHighlights = {
  'driveway-pressure-washing':
    'Best fit when the front approach is the first thing visitors or neighbors notice.',
  'sidewalk-walkway-cleaning':
    'Best fit for pedestrian paths, entry walks, and neighborhood-facing concrete.',
  'concrete-cleaning':
    'Best fit for patios, pads, aprons, curbs, and other appropriate hard surfaces.',
} as const
---

<Layout
  title="Driveway, Sidewalk, and Concrete Cleaning in Central Florida | CFL Wash Co."
  description="Request a simple quote for driveway, walkway, sidewalk, and concrete cleaning across Central Florida."
  canonicalPath="/"
>
  <OrganizationSchema slot="head" />
  <main>
    <HeroSection
      variant="split"
      tone="soft"
      eyebrow="Driveway, sidewalk, walkway, and concrete cleaning"
      title="Central Florida concrete cleaning starts with a clear quote."
      description="CFL Wash Co. helps homeowners handle visible buildup on driveways, sidewalks, walkways, and similar concrete surfaces. Send the city, surface, and job notes; requests are reviewed before scheduling."
    >
      <Fragment slot="actions">
        <Button
          href="/request-quote"
          size="lg"
          fullWidth
          data-cta="quote"
          data-cta-location="home-hero"
          class="sm:w-auto"
        >
          <ClipboardList
            slot="startIcon"
            class="h-5 w-5"
            aria-hidden="true"
            stroke-width="1.8"
          />
          Request a Quote
        </Button>
        {
          secondaryHeroHref && (
            <Button
              href={secondaryHeroHref}
              variant="secondary"
              size="lg"
              fullWidth
              data-cta={hasPhone ? 'call' : 'email'}
              data-cta-location="home-hero"
              class="sm:w-auto"
            >
              {!hasPhone && (
                <Mail
                  slot="startIcon"
                  class="h-5 w-5"
                  aria-hidden="true"
                  stroke-width="1.8"
                />
              )}
              {secondaryHeroLabel}
            </Button>
          )
        }
      </Fragment>

      <div
        slot="media"
        class="relative aspect-[16/13] overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-white shadow-[var(--shadow-media)] sm:aspect-[16/10] lg:aspect-[11/12]"
        aria-hidden="true"
      >
        <picture>
          <source
            media="(max-width: 639px)"
            srcset="
              /images/brand/responsive/hero-homepage-480.webp 1x,
              /images/brand/responsive/hero-homepage-768.webp 2x
            "
          />
          <source
            media="(max-width: 1023px)"
            srcset="
              /images/brand/responsive/hero-homepage-768.webp 1x,
              /images/brand/responsive/hero-homepage-1024.webp 2x
            "
          />
          <source
            media="(min-width: 1024px)"
            srcset="
              /images/brand/responsive/hero-homepage-1024.webp 1x,
              /images/brand/responsive/hero-homepage-1280.webp 2x
            "
          />
          <img
            src="/images/brand/responsive/hero-homepage-1024.webp"
            alt=""
            width="1024"
            height="540"
            class="h-full w-full object-cover object-center"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </picture>
      </div>
    </HeroSection>

    <section
      class="border-y border-[var(--color-border)] bg-[var(--color-page)]"
    >
      <div
        class="mx-auto grid w-full max-w-[var(--container-width)] gap-4 px-[var(--container-gutter)] py-6 md:grid-cols-3"
      >
        {
          trustCues.map((cue) => (
            <Card tone="soft" padding="sm" class="flex gap-3">
              <IconBadge icon={cue.icon} tone="warm" size="sm" />
              <div>
                <p class="text-sm font-semibold text-[var(--color-text)]">
                  {cue.label}
                </p>
                <p class="mt-1 text-sm leading-6 text-[var(--color-text-muted)]">
                  {cue.detail}
                </p>
              </div>
            </Card>
          ))
        }
      </div>
    </section>

    <Section
      id="services"
      eyebrow="Services"
      title="Choose the surface that needs attention"
      description="The launch offer stays focused on the hard surfaces that shape curb appeal and everyday arrival."
      tone="soft"
      class="scroll-mt-24"
    >
      <div class="grid gap-4 md:grid-cols-3">
        {
          services.map((service) => (
            <Card
              tone="default"
              padding="lg"
              elevated
              class="flex h-full flex-col"
            >
              <IconBadge
                icon={serviceIcons[service.slug]}
                tone="soft"
                size="lg"
              />
              <h3 class="mt-5 text-section-subtitle text-[var(--color-text)]">
                {service.name}
              </h3>
              <p class="mt-3 flex-1 text-sm leading-7 text-[var(--color-text-muted)]">
                {serviceHighlights[service.slug]}
              </p>
              <a
                href={`/${service.slug}`}
                aria-label={`View ${service.name}`}
                class="mt-6 inline-flex text-sm font-semibold text-[var(--color-action)] transition-colors duration-[var(--duration-fast)] hover:text-[var(--color-action-hover)] focus:outline-none focus-visible:rounded-[var(--radius-sm)] focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-page)]"
              >
                View {service.name}
              </a>
            </Card>
          ))
        }
      </div>
    </Section>

    <SplitFeature
      eyebrow="HOA and curb appeal"
      title="When the front approach needs attention."
      description="Some requests start with an HOA notice. Others start with a driveway, entry path, or sidewalk that no longer matches the rest of the home. Either way, the first step is describing the surface and the reason for the cleanup."
      columns="media-heavy"
      align="center"
      titleSize="section"
      descriptionSize="lead"
    >
      <Button
        slot="actions"
        href="/request-quote"
        size="lg"
        data-cta="quote"
        data-cta-location="home-hoa"
      >
        <ClipboardList
          slot="startIcon"
          class="h-5 w-5"
          aria-hidden="true"
          stroke-width="1.8"
        />
        Request a Quote
      </Button>

      <div class="grid gap-3 sm:grid-cols-2">
        {
          [
            'Driveway and front-walk areas that shape the first impression',
            'Sidewalk panels and entry paths affected by everyday buildup',
            'Concrete patios, pads, aprons, curbs, and entry areas',
            'Quote details reviewed before any scheduling step',
          ].map((item) => (
            <div class="rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-page)] p-5">
              <span class="block h-1 w-10 rounded-full bg-[var(--color-accent)]" />
              <p class="mt-4 text-sm font-semibold leading-6 text-[var(--color-text)]">
                {item}
              </p>
            </div>
          ))
        }
      </div>
    </SplitFeature>

    <Section
      eyebrow="Process"
      title="What happens after you reach out"
      description="The request starts a review of the surface, location, and job details before any scheduling step."
    >
      <ProcessSteps steps={processSteps} variant="featured" cardTone="soft" />
    </Section>

    <section
      id="service-areas"
      class="scroll-mt-24 border-y border-[var(--color-border)] bg-[var(--color-surface)]"
    >
      <div
        class="mx-auto grid w-full max-w-[var(--container-width)] gap-8 px-[var(--container-gutter)] py-[var(--section-space)] lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]"
      >
        <div>
          <p class="text-eyebrow text-[var(--color-action)]">Service areas</p>
          <h2 class="mt-3 text-section-title text-[var(--color-text)]">
            Serving Central Florida homeowners.
          </h2>
          <p class="mt-3 text-lead text-[var(--color-text-muted)]">
            Explore the current city pages below. These are the published local
            pages available now.
          </p>
        </div>

        <LinkGrid
          items={serviceAreaLinks}
          variant="cards"
          columns="two"
          density="comfortable"
        />
      </div>
    </section>

    <CTASection
      eyebrow="Ready to start the quote?"
      title="Send the details for your Central Florida concrete cleaning request."
      description="Include the city, the surface that needs attention, and any useful notes about buildup, staining, curb appeal, or an HOA notice."
      surface="elevated"
      titleWidth="wide"
    >
      <Fragment slot="actions">
        <Button
          href="/request-quote"
          variant="secondary"
          size="lg"
          fullWidth
          class="bg-white text-[var(--color-action)] hover:bg-[var(--color-surface)] sm:w-auto"
          data-cta="quote"
          data-cta-location="home-final"
        >
          <ClipboardList
            slot="startIcon"
            class="h-5 w-5"
            aria-hidden="true"
            stroke-width="1.8"
          />
          Request a Quote
        </Button>
        <Button
          href={secondaryHeroHref}
          variant="ghost"
          size="lg"
          fullWidth
          class="text-white ring-1 ring-inset ring-white/35 hover:bg-white/10 sm:w-auto"
          data-cta={hasPhone ? 'call' : 'email'}
          data-cta-location="home-final"
        >
          {
            hasPhone ? (
              <Phone
                slot="startIcon"
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
            ) : (
              <Mail
                slot="startIcon"
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
            )
          }
          {secondaryHeroLabel}
        </Button>
      </Fragment>
    </CTASection>
  </main>
</Layout>
