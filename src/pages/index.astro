---
import Button from '../components/ui/Button.astro'
import Card from '../components/ui/Card.astro'
import IconBadge from '../components/ui/IconBadge.astro'
import Section from '../components/ui/Section.astro'
import Layout from '../layouts/Layout.astro'
import { services } from '../data/services'
import { serviceAreas } from '../data/serviceAreas'
import { site } from '../data/site'
import {
  Blocks,
  CarFront,
  ClipboardCheck,
  ClipboardList,
  Footprints,
  Mail,
  MapPin,
  MessageSquareText,
  Phone,
} from '@lucide/astro'

const hasPhone = Boolean(site.phoneDisplay && site.phoneHref)
const secondaryHeroHref = hasPhone ? site.phoneHref : `mailto:${site.email}`
const secondaryHeroLabel = hasPhone
  ? `Call ${site.phoneDisplay}`
  : 'Email CFL Wash Co.'

const trustCues = [
  {
    icon: MapPin,
    label: 'Central Florida based',
    detail: 'Serving homeowners across the local area',
  },
  {
    icon: Blocks,
    label: 'Driveways, sidewalks, and concrete',
    detail: 'Focused curb appeal cleaning for hard surfaces',
  },
  {
    icon: ClipboardCheck,
    label: 'HOA notice cleanup',
    detail: 'Quote-first help for visible concrete buildup',
  },
  {
    icon: MessageSquareText,
    label: 'Simple quote path',
    detail: 'Request a quote before any work is scheduled',
  },
]

const processSteps = [
  {
    title: 'Request a quote',
    description:
      'Share the surface, city, and a few details about the driveway, sidewalk, walkway, or concrete area.',
  },
  {
    title: 'Confirm the scope',
    description:
      'CFL Wash Co. reviews the job details and confirms the best cleaning plan before work begins.',
  },
  {
    title: 'Clean the concrete',
    description:
      'The work stays focused on cleaner-looking concrete and practical curb appeal for the property.',
  },
]

const unlinkedServiceAreas = ['DeLand', 'Sanford', 'Lake Mary']

const serviceIcons = {
  'driveway-pressure-washing': CarFront,
  'sidewalk-walkway-cleaning': Footprints,
  'concrete-cleaning': Blocks,
} as const
---

<Layout
  title="Driveway, Sidewalk, and Concrete Cleaning in Central Florida | CFL Wash Co."
  description="Request a simple quote for driveway, walkway, sidewalk, and concrete cleaning across Central Florida."
  canonicalPath="/"
>
  <main>
    <section class="overflow-hidden bg-[var(--color-surface)]">
      <div
        class="mx-auto grid w-full max-w-[var(--container-width)] gap-12 px-[var(--container-gutter)] py-[var(--section-space)] lg:grid-cols-[minmax(0,1fr)_minmax(22rem,0.92fr)] lg:items-center lg:py-[var(--section-space-spacious)]"
      >
        <div>
          <p class="text-eyebrow text-[var(--color-action)]">
            Serving Central Florida
          </p>
          <h1 class="measure-copy mt-4 text-display text-[var(--color-text)]">
            Driveway, Sidewalk, and Concrete Cleaning in Central Florida
          </h1>
          <p class="measure-copy mt-5 text-lead text-[var(--color-text-muted)]">
            Simple quotes for driveway, walkway, sidewalk, and concrete cleaning
            across Central Florida. Built for curb appeal, HOA notices, and
            cleaner-looking concrete.
          </p>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <Button
              href="/request-quote"
              size="lg"
              fullWidth
              data-cta="quote"
              data-cta-location="home-hero"
              class="sm:w-auto"
            >
              <ClipboardList
                slot="startIcon"
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
              Request a Quote
            </Button>
            {
              secondaryHeroHref && (
                <Button
                  href={secondaryHeroHref}
                  variant="secondary"
                  size="lg"
                  fullWidth
                  data-cta={hasPhone ? 'call' : 'email'}
                  data-cta-location="home-hero"
                  class="sm:w-auto"
                >
                  {!hasPhone && (
                    <Mail
                      slot="startIcon"
                      class="h-5 w-5"
                      aria-hidden="true"
                      stroke-width="1.8"
                    />
                  )}
                  {secondaryHeroLabel}
                </Button>
              )
            }
          </div>
        </div>

        <div
          class="relative aspect-[16/13] overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-white shadow-[var(--shadow-media)] sm:aspect-[16/10] lg:aspect-[11/12]"
          aria-hidden="true"
        >
          <img
            src="/images/brand/hero-homepage.webp"
            alt=""
            width="1280"
            height="675"
            class="h-full w-full object-cover object-center"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
      </div>
    </section>

    <section
      class="border-y border-[var(--color-border)] bg-[var(--color-page)]"
    >
      <div
        class="mx-auto grid w-full max-w-[var(--container-width)] gap-4 px-[var(--container-gutter)] py-6 sm:grid-cols-2 lg:grid-cols-4"
      >
        {
          trustCues.map((cue) => (
            <Card tone="soft" padding="sm" class="flex gap-3">
              <IconBadge icon={cue.icon} tone="warm" size="sm" />
              <div>
                <p class="text-sm font-semibold text-[var(--color-text)]">
                  {cue.label}
                </p>
                <p class="mt-1 text-sm leading-6 text-[var(--color-text-muted)]">
                  {cue.detail}
                </p>
              </div>
            </Card>
          ))
        }
      </div>
    </section>

    <Section
      id="services"
      eyebrow="Services"
      title="Concrete-focused exterior cleaning"
      description="Start with the surfaces homeowners notice first: driveways, sidewalks, walkways, and concrete around the property."
      tone="soft"
      class="scroll-mt-24"
    >
      <div class="grid gap-4 md:grid-cols-3">
        {
          services.map((service) => (
            <Card
              tone="default"
              padding="lg"
              elevated
              class="flex h-full flex-col"
            >
              <IconBadge
                icon={serviceIcons[service.slug]}
                tone="soft"
                size="lg"
              />
              <h3 class="mt-5 text-section-subtitle text-[var(--color-text)]">
                {service.name}
              </h3>
              <p class="mt-3 flex-1 text-sm leading-7 text-[var(--color-text-muted)]">
                {service.summary}
              </p>
              <a
                href={`/${service.slug}`}
                class="mt-6 inline-flex text-sm font-semibold text-[var(--color-action)] transition-colors duration-[var(--duration-fast)] hover:text-[var(--color-action-hover)] focus:outline-none focus-visible:rounded-[var(--radius-sm)] focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-page)]"
              >
                View service
              </a>
            </Card>
          ))
        }
      </div>
    </Section>

    <section class="bg-[var(--color-surface)]">
      <div
        class="mx-auto grid w-full max-w-[var(--container-width)] gap-8 px-[var(--container-gutter)] py-[var(--section-space)] lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:items-center"
      >
        <div>
          <p class="text-eyebrow text-[var(--color-action)]">
            HOA and curb appeal
          </p>
          <h2 class="mt-3 text-section-title text-[var(--color-text)]">
            A practical cleanup path for visible concrete.
          </h2>
          <p class="mt-4 text-lead text-[var(--color-text-muted)]">
            HOA notices and curb appeal projects usually start with the surfaces
            closest to the street. CFL Wash Co. keeps the service focus on
            driveway, walkway, sidewalk, and concrete cleaning so the quote
            stays clear.
          </p>
          <div class="mt-7">
            <Button
              href="/request-quote"
              size="lg"
              data-cta="quote"
              data-cta-location="home-hoa"
            >
              <ClipboardList
                slot="startIcon"
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
              Request a Quote
            </Button>
          </div>
        </div>

        <div class="grid gap-3 sm:grid-cols-2">
          {
            [
              'Driveway and front walk refreshes',
              'Sidewalk cleaning for neighborhood presentation',
              'Concrete patios, pads, aprons, and entry areas',
              'Quote-first scope before work is scheduled',
            ].map((item) => (
              <div class="rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-page)] p-5">
                <span class="block h-1 w-10 rounded-full bg-[var(--color-accent)]" />
                <p class="mt-4 text-sm font-semibold leading-6 text-[var(--color-text)]">
                  {item}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <Section
      eyebrow="Process"
      title="Simple quote-first process"
      description="Request a quote, confirm the scope, and move forward with the concrete cleaning that fits the property."
    >
      <ol class="grid list-none gap-4 p-0 m-0 md:grid-cols-3">
        {
          processSteps.map((step, index) => (
            <li class="min-w-0">
              <Card tone="soft" padding="lg" class="flex h-full flex-col">
                <div class="flex items-center">
                  <span class="flex h-12 w-12 items-center justify-center rounded-full bg-[var(--color-action)] text-base font-semibold text-white shadow-[var(--shadow-xs)] ring-4 ring-[var(--color-surface)] md:h-14 md:w-14 md:text-lg">
                    {index + 1}
                  </span>
                </div>
                <h3 class="mt-5 text-section-subtitle text-[var(--color-text)]">
                  {step.title}
                </h3>
                <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
                  {step.description}
                </p>
              </Card>
            </li>
          ))
        }
      </ol>
    </Section>

    <section
      id="service-areas"
      class="scroll-mt-24 border-y border-[var(--color-border)] bg-[var(--color-surface)]"
    >
      <div
        class="mx-auto grid w-full max-w-[var(--container-width)] gap-8 px-[var(--container-gutter)] py-[var(--section-space)] lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]"
      >
        <div>
          <p class="text-eyebrow text-[var(--color-action)]">Service areas</p>
          <h2 class="mt-3 text-section-title text-[var(--color-text)]">
            Serving Central Florida homeowners.
          </h2>
          <p class="mt-3 text-lead text-[var(--color-text-muted)]">
            Explore the current service area pages below. Additional nearby
            cities are listed as part of the broader Central Florida service
            area.
          </p>
        </div>

        <div class="grid gap-3 sm:grid-cols-2">
          {
            serviceAreas.map((area) => (
              <a
                href={`/service-areas/${area.slug}`}
                class="rounded-[var(--radius-md)] border border-[var(--color-border)] bg-[var(--color-page)] p-4 text-sm font-semibold text-[var(--color-text)] transition-colors duration-[var(--duration-fast)] hover:border-[var(--color-action)] hover:text-[var(--color-action)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-page)]"
              >
                {area.name}
              </a>
            ))
          }
          {
            unlinkedServiceAreas.map((area) => (
              <p class="rounded-[var(--radius-md)] border border-dashed border-[var(--color-border)] bg-[var(--color-page)]/70 p-4 text-sm font-semibold text-[var(--color-text-muted)]">
                {area}
              </p>
            ))
          }
        </div>
      </div>
    </section>

    <section class="px-[var(--container-gutter)] py-[var(--section-space)]">
      <div
        class="mx-auto max-w-[var(--container-width)] overflow-hidden rounded-[var(--radius-lg)] bg-[var(--color-action)] px-[var(--container-gutter)] py-[var(--space-12)] text-center text-white shadow-[var(--shadow-sm)] sm:px-[var(--space-10)]"
      >
        <p class="text-eyebrow text-white/75">
          Ready for a cleaner-looking driveway?
        </p>
        <h2 class="mx-auto mt-3 max-w-2xl text-section-title text-white">
          Request a simple Central Florida concrete cleaning quote.
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-lead text-white/85">
          Tell CFL Wash Co. what needs attention and get a clear next step for
          driveway, walkway, sidewalk, or concrete cleaning.
        </p>
        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
          <Button
            href="/request-quote"
            variant="secondary"
            size="lg"
            fullWidth
            class="bg-white text-[var(--color-action)] hover:bg-[var(--color-surface)] sm:w-auto"
            data-cta="quote"
            data-cta-location="home-final"
          >
            <ClipboardList
              slot="startIcon"
              class="h-5 w-5"
              aria-hidden="true"
              stroke-width="1.8"
            />
            Request a Quote
          </Button>
          <Button
            href={secondaryHeroHref}
            variant="ghost"
            size="lg"
            fullWidth
            class="text-white ring-1 ring-inset ring-white/35 hover:bg-white/10 sm:w-auto"
            data-cta={hasPhone ? 'call' : 'email'}
            data-cta-location="home-final"
          >
            {
              hasPhone ? (
                <Phone
                  slot="startIcon"
                  class="h-5 w-5"
                  aria-hidden="true"
                  stroke-width="1.8"
                />
              ) : (
                <Mail
                  slot="startIcon"
                  class="h-5 w-5"
                  aria-hidden="true"
                  stroke-width="1.8"
                />
              )
            }
            {secondaryHeroLabel}
          </Button>
        </div>
      </div>
    </section>
  </main>
</Layout>
