---
import Button from '../components/ui/Button.astro'
import BreadcrumbSchema from '../components/site/BreadcrumbSchema.astro'
import Breadcrumbs from '../components/site/Breadcrumbs.astro'
import CTASection from '../components/patterns/CTASection.astro'
import Card from '../components/ui/Card.astro'
import FAQList from '../components/patterns/FAQList.astro'
import HeroSection from '../components/patterns/HeroSection.astro'
import LinkGrid from '../components/patterns/LinkGrid.astro'
import ProcessSteps from '../components/patterns/ProcessSteps.astro'
import Section from '../components/ui/Section.astro'
import SplitFeature from '../components/patterns/SplitFeature.astro'
import Layout from '../layouts/Layout.astro'
import { serviceAreas } from '../data/serviceAreas'
import { site } from '../data/site'
import { services } from '../data/services'
import { Mail, Phone } from '@lucide/astro'

const service = services.find(
  (item) => item.slug === 'sidewalk-walkway-cleaning',
)!

const relatedServices = services.filter((item) => item.slug !== service.slug)
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: service.name, href: `/${service.slug}` },
]
const relatedServiceLinks = relatedServices.map((item) => ({
  label: item.name,
  href: `/${item.slug}`,
}))
const activeServiceAreaLinks = serviceAreas.map((area) => ({
  label: area.name,
  href: `/service-areas/${area.slug}`,
}))
const hasPhone = Boolean(site.phoneDisplay && site.phoneHref)

const seoTitle =
  'Sidewalk and Walkway Cleaning in Central Florida | CFL Wash Co.'
const seoDescription =
  'Sidewalk, walkway, and entry path cleaning in Central Florida. Request a quote for concrete pedestrian areas, curb appeal cleanup, and HOA notice support.'

const inclusions = [
  'Cleaning for appropriate concrete sidewalk panels, front walks, entry paths, and connected pedestrian areas',
  'Attention to edges, corners, and transition areas where buildup is visible and reachable',
  'Review of drainage, nearby doors, landscape beds, and access before cleaning begins',
  'Quote-first scope for the paths and panels that need attention',
]

const considerations = [
  {
    title: 'Pedestrian surfaces',
    description:
      'Sidewalks and walkways often have different panels, slopes, seams, and edges that can clean at different rates.',
  },
  {
    title: 'Drainage near entries',
    description:
      'Water movement around doors, garage entries, porch steps, and low walkway areas can affect the cleaning approach.',
  },
  {
    title: 'Access and obstructions',
    description:
      'Planters, furniture, parked vehicles, gates, and narrow side paths can limit reach or change the quoted scope.',
  },
  {
    title: 'Organic and irrigation staining',
    description:
      'Algae-like buildup, leaf staining, rust, and irrigation marks can improve, but older or deeper staining may remain.',
  },
]

const prepItems = [
  'Move porch mats, planters, patio chairs, toys, and loose decor away from the walking path.',
  'Unlock gates if side walkways or rear paths are included in the quote.',
  'Mention nearby door thresholds, damaged edges, loose pavers, or trip concerns before cleaning.',
  'Keep foot traffic off the active work area until the cleaning visit is complete.',
]

const processSteps = [
  {
    title: 'Share the path details',
    description:
      'Use the quote form to describe the sidewalk, front walk, entry path, or connected panels that need cleaning.',
  },
  {
    title: 'Review conditions',
    description:
      'CFL Wash Co. checks the surface type, drainage, staining, and access notes before confirming the scope.',
  },
  {
    title: 'Clean reachable areas',
    description:
      'The visit focuses on appropriate concrete walking surfaces included in the agreed quote.',
  },
]

const faqs = [
  {
    question:
      'Can you clean both public sidewalk panels and the front walkway?',
    answer:
      'The quote can include reachable concrete sidewalk panels and private walkways when they fit the current service scope. Share which areas need attention when requesting a quote.',
  },
  {
    question: 'Will cleaning remove black or green buildup on walkways?',
    answer:
      'Cleaning can help with visible organic buildup and everyday grime, but the final result depends on the surface condition, staining depth, drainage, and prior wear.',
  },
  {
    question: 'Do I need to be home for sidewalk or walkway cleaning?',
    answer:
      'The quote details and access needs should be confirmed first. If gates, pets, or entry areas are involved, include that information in the request.',
  },
]
---

<Layout
  title={seoTitle}
  description={seoDescription}
  canonicalPath="/sidewalk-walkway-cleaning"
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />
  <main>
    <Breadcrumbs items={breadcrumbs} />

    <HeroSection
      eyebrow="Service"
      title="Sidewalk and walkway cleaning for the paths people notice."
      description="Front walks, entry paths, sidewalk panels, and routes from the driveway to the door can collect organic buildup, tracked dirt, leaf marks, and irrigation staining. CFL Wash Co. keeps this service focused on cleaner pedestrian concrete with expectations based on the surface condition, age, drainage, and staining involved."
    >
      <Fragment slot="actions">
        <Button
          href="/request-quote"
          data-cta="quote"
          data-cta-location={`service-${service.slug}`}
        >
          Request a Quote
        </Button>
        <Button
          href={`mailto:${site.email}`}
          variant="secondary"
          data-cta="email"
          data-cta-location={`service-${service.slug}`}
        >
          Email CFL Wash Co.
        </Button>
      </Fragment>
    </HeroSection>

    <Section
      eyebrow="What is included"
      title="Cleaning for concrete paths, walks, and entry areas"
      description="This service is built around the pedestrian surfaces that shape curb appeal and daily use."
      class="border-t border-[var(--color-border)]"
    >
      <div class="grid gap-4 md:grid-cols-2">
        {
          inclusions.map((item) => (
            <Card tone="raised">
              <p class="text-sm font-semibold leading-7 text-[var(--color-text)]">
                {item}
              </p>
            </Card>
          ))
        }
      </div>
    </Section>

    <SplitFeature
      eyebrow="Quote considerations"
      title="Walkway cleaning depends on layout and nearby conditions."
      description="Sidewalks and walks sit close to doors, lawns, beds, curbs, and driveways. The best quote starts with what needs cleaning, how the area drains, and whether staining is surface-level or more set in."
    >
      <div class="grid gap-4 sm:grid-cols-2">
        {
          considerations.map((item) => (
            <Card tone="raised">
              <h3 class="text-base font-semibold text-[var(--color-text)]">
                {item.title}
              </h3>
              <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
                {item.description}
              </p>
            </Card>
          ))
        }
      </div>
    </SplitFeature>

    <Section
      eyebrow="Before the visit"
      title="Preparation for sidewalk and walkway cleaning"
      description="Small access details can make a meaningful difference for pedestrian-area cleaning."
    >
      <ul class="grid gap-3 md:grid-cols-2">
        {
          prepItems.map((item) => (
            <li class="feature-panel text-sm leading-7">{item}</li>
          ))
        }
      </ul>
    </Section>

    <Section
      eyebrow="Process"
      title="A clear path from quote to cleaning"
      description="The quote comes first so the surface, access, and requested walking areas are understood before work begins."
      class="border-y border-[var(--color-border)] bg-[var(--color-surface)]"
    >
      <ProcessSteps steps={processSteps} />
    </Section>

    <Section
      eyebrow="Related pages"
      title="Connect walkway cleaning with the rest of the concrete scope"
      description="Many homes pair walkway cleaning with a driveway or other concrete area so visible front-of-home surfaces are addressed together."
    >
      <div class="grid gap-8 lg:grid-cols-2">
        <div>
          <h3 class="text-lg font-semibold text-[var(--color-text)]">
            Related services
          </h3>
          <LinkGrid items={relatedServiceLinks} class="mt-4" />
        </div>

        <div>
          <h3 class="text-lg font-semibold text-[var(--color-text)]">
            Active service areas
          </h3>
          <LinkGrid items={activeServiceAreaLinks} class="mt-4" />
        </div>
      </div>
    </Section>

    <Section
      eyebrow="FAQ"
      title="Sidewalk and walkway cleaning questions"
      class="border-y border-[var(--color-border)] bg-[var(--color-surface)]"
    >
      <FAQList faqs={faqs} />
    </Section>

    <CTASection
      title="Request a sidewalk or walkway cleaning quote."
      description="Tell CFL Wash Co. which paths, panels, entry areas, or connected concrete surfaces need attention."
    >
      <Fragment slot="actions">
        <Button
          href="/request-quote"
          variant="light"
          data-cta="quote"
          data-cta-location={`service-${service.slug}-final`}
        >
          Request a Quote
        </Button>
        {
          hasPhone ? (
            <Button
              href={site.phoneHref!}
              variant="inverseGhost"
              data-cta="call"
              data-cta-location={`service-${service.slug}-final`}
            >
              <Phone
                slot="startIcon"
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
              Call {site.phoneDisplay}
            </Button>
          ) : (
            <Button
              href={`mailto:${site.email}`}
              variant="inverseGhost"
              data-cta="email"
              data-cta-location={`service-${service.slug}-final`}
            >
              <Mail
                slot="startIcon"
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
              Email CFL Wash Co.
            </Button>
          )
        }
      </Fragment>
    </CTASection>
  </main>
</Layout>
