---
import Button from '../components/ui/Button.astro'
import BreadcrumbSchema from '../components/site/BreadcrumbSchema.astro'
import Breadcrumbs from '../components/site/Breadcrumbs.astro'
import CTASection from '../components/patterns/CTASection.astro'
import HeroSection from '../components/patterns/HeroSection.astro'
import LinkGrid from '../components/patterns/LinkGrid.astro'
import MediaFrame from '../components/patterns/MediaFrame.astro'
import Section from '../components/ui/Section.astro'
import Layout from '../layouts/Layout.astro'
import { publicMedia } from '../data/publicMedia'
import { serviceAreas } from '../data/serviceAreas'
import { services } from '../data/services'
import { site } from '../data/site'
import { ArrowRight, ClipboardList, Mail, MapPin, Phone } from '@lucide/astro'

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas' },
]
const hasPhone = Boolean(site.phoneDisplay && site.phoneHref)
const serviceLinks = services.map((service) => ({
  label: service.name,
  href: `/${service.slug}`,
  description: service.summary,
}))
---

<Layout
  title="Pressure Washing Service Areas in Central Florida | CFL Wash Co."
  description="Explore CFL Wash Co. pressure washing service areas in Deltona, Orange City, DeBary, DeLand, Sanford, and Lake Mary, Florida."
  canonicalPath="/service-areas"
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />
  <main>
    <Breadcrumbs items={breadcrumbs} />

    <HeroSection
      variant="split"
      tone="soft"
      eyebrow="Central Florida service areas"
      title="Pressure washing across six Central Florida cities"
      description="CFL Wash Co. provides driveway, sidewalk, walkway, and concrete cleaning in Deltona, Orange City, DeBary, DeLand, Sanford, and Lake Mary."
    >
      <Fragment slot="actions">
        <Button
          href="/request-quote"
          size="lg"
          fullWidth
          class="sm:w-auto"
          data-cta="quote"
          data-cta-location="service-areas-hub-hero"
        >
          <ClipboardList
            slot="startIcon"
            class="h-5 w-5"
            aria-hidden="true"
            stroke-width="1.8"
          />
          Request a Quote
        </Button>
        {
          hasPhone ? (
            <Button
              href={site.phoneHref!}
              variant="secondary"
              size="lg"
              fullWidth
              class="sm:w-auto"
              data-cta="call"
              data-cta-location="service-areas-hub-hero"
            >
              <Phone
                slot="startIcon"
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
              Call {site.phoneDisplay}
            </Button>
          ) : (
            <Button
              href={`mailto:${site.email}`}
              variant="secondary"
              size="lg"
              fullWidth
              class="sm:w-auto"
              data-cta="email"
              data-cta-location="service-areas-hub-hero"
            >
              <Mail
                slot="startIcon"
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
              Email CFL Wash Co.
            </Button>
          )
        }
      </Fragment>

      <MediaFrame
        slot="media"
        media={publicMedia.brandResidentialContext}
        imageClass="aspect-[16/10] lg:aspect-[4/3]"
        loading="eager"
        fetchpriority="high"
      />
    </HeroSection>

    <Section
      eyebrow="Current city pages"
      title="Choose the service address"
      description="Select the city that matches the property. Each page keeps active services, practical local context, quote guidance, and nearby coverage easy to find."
      class="border-t border-[var(--color-border)]"
    >
      <ul
        class="grid border-y border-[var(--color-border)] md:grid-cols-2"
        data-service-area-menu
      >
        {
          serviceAreas.map((area, index) => (
            <li
              class:list={[
                'min-w-0 border-b border-[var(--color-border)]',
                index % 2 === 0 && 'md:pr-8',
                index % 2 === 1 && 'md:border-l md:pl-8',
              ]}
              data-service-area-menu-item
            >
              <a
                href={`/service-areas/${area.slug}`}
                class="group grid min-h-32 grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-4 py-6 focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[var(--color-focus-ring)]"
              >
                <MapPin
                  class="h-6 w-6 text-[var(--color-action)]"
                  aria-hidden="true"
                  stroke-width="1.8"
                />
                <span class="min-w-0">
                  <span class="block text-lg font-semibold text-[var(--color-text)] transition-colors duration-[var(--duration-fast)] group-hover:text-[var(--color-action)]">
                    {area.name}, Florida
                  </span>
                  <span class="mt-2 block text-sm leading-7 text-[var(--color-text-muted)]">
                    {area.description}
                  </span>
                </span>
                <ArrowRight
                  class="h-5 w-5 text-[var(--color-action)]"
                  aria-hidden="true"
                  stroke-width="1.9"
                />
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-sm leading-7 text-[var(--color-text-muted)]">
        Property outside a listed city? Include the exact service address in the
        quote request so current coverage can be confirmed.
      </p>
    </Section>

    <Section
      eyebrow="Available across current city pages"
      title="Start with the concrete surface"
      description="Go directly to the service that best matches the driveway, walkway, or other residential concrete in the request."
      tone="water"
    >
      <div data-service-area-services>
        <LinkGrid items={serviceLinks} columns="three" density="comfortable" />
      </div>
    </Section>

    <CTASection
      eyebrow="Property outside a listed city?"
      title="Send the exact service address for a coverage review."
      description="Include the requested concrete surfaces and clear photos. CFL Wash Co. will review whether the property and scope fit the current service area before scheduling."
      tone="inverse"
      titleWidth="wide"
    >
      <Fragment slot="actions">
        <Button
          href="/request-quote"
          variant="light"
          size="lg"
          fullWidth
          class="sm:w-auto"
          data-cta="quote"
          data-cta-location="service-areas-hub-final"
        >
          Request a Quote
        </Button>
        {
          hasPhone && (
            <Button
              href={site.phoneHref!}
              variant="inverseGhost"
              size="lg"
              fullWidth
              class="sm:w-auto"
              data-cta="call"
              data-cta-location="service-areas-hub-final"
            >
              <Phone
                slot="startIcon"
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
              Call {site.phoneDisplay}
            </Button>
          )
        }
      </Fragment>
    </CTASection>
  </main>
</Layout>
