---
import Button from '../components/ui/Button.astro'
import BreadcrumbSchema from '../components/site/BreadcrumbSchema.astro'
import Breadcrumbs from '../components/site/Breadcrumbs.astro'
import Card from '../components/ui/Card.astro'
import CTASection from '../components/patterns/CTASection.astro'
import HeroSection from '../components/patterns/HeroSection.astro'
import IconBadge from '../components/ui/IconBadge.astro'
import MediaFrame from '../components/patterns/MediaFrame.astro'
import Section from '../components/ui/Section.astro'
import Layout from '../layouts/Layout.astro'
import { publicMedia } from '../data/publicMedia'
import { serviceAreas } from '../data/serviceAreas'
import { services } from '../data/services'
import { site } from '../data/site'
import { ArrowRight, ClipboardList, MapPin, Phone } from '@lucide/astro'

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Service Areas', href: '/service-areas' },
]
const hasPhone = Boolean(site.phoneDisplay && site.phoneHref)
---

<Layout
  title="Pressure Washing Service Areas in Central Florida | CFL Wash Co."
  description="Explore CFL Wash Co. pressure washing service areas in Deltona, Orange City, DeBary, DeLand, Sanford, and Lake Mary, Florida."
  canonicalPath="/service-areas"
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />
  <main>
    <Breadcrumbs items={breadcrumbs} />

    <HeroSection
      tone="soft"
      eyebrow="Central Florida service areas"
      title="Find the pressure washing page for your city."
      description="CFL Wash Co. currently publishes local service pages for six Central Florida cities. Choose the page that matches the service address for local context, active services, quote guidance, and nearby areas."
    >
      <Fragment slot="actions">
        <Button
          href="/request-quote"
          size="lg"
          fullWidth
          class="sm:w-auto"
          data-cta="quote"
          data-cta-location="service-areas-hub-hero"
        >
          <ClipboardList
            slot="startIcon"
            class="h-5 w-5"
            aria-hidden="true"
            stroke-width="1.8"
          />
          Request a Quote
        </Button>
        <Button
          href="/services"
          variant="secondary"
          size="lg"
          fullWidth
          class="sm:w-auto"
        >
          View Services
        </Button>
      </Fragment>

      <Card
        slot="aside"
        tone="raised"
        elevated
        aria-label="Current service-area coverage"
      >
        <div class="flex items-center gap-3">
          <IconBadge icon={MapPin} tone="action" size="lg" />
          <div>
            <p class="text-sm font-semibold text-[var(--color-text)]">
              Published coverage
            </p>
            <p class="text-sm text-[var(--color-text-muted)]">
              {serviceAreas.length} active city pages
            </p>
          </div>
        </div>
        <p class="mt-4 text-sm leading-7 text-[var(--color-text-muted)]">
          Do not see the exact city? Send the service address or nearest cross
          streets. CFL Wash Co. can review whether the property fits the current
          coverage area without implying service everywhere in Central Florida.
        </p>
      </Card>
    </HeroSection>

    <Section
      eyebrow="Current city pages"
      title="Choose the service address"
      description="Each city page is written for homeowners first and includes active service links, common reasons to request cleaning, quote preparation, FAQs, and nearby published cities."
      class="border-t border-[var(--color-border)]"
      contentWidth="full"
    >
      <div
        class="grid gap-8 lg:grid-cols-[minmax(18rem,0.72fr)_minmax(0,1.28fr)] lg:items-start"
      >
        <MediaFrame
          media={publicMedia.brandResidentialContext}
          sizes="(min-width: 1024px) 36vw, 100vw"
          imageClass="aspect-[16/10] lg:aspect-[4/5]"
          class="lg:sticky lg:top-24"
        />

        <div class="grid gap-4 sm:grid-cols-2">
          {
            serviceAreas.map((area) => (
              <article class="theme-shadow-xs flex h-full flex-col rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-surface-raised)] p-6">
                <IconBadge icon={MapPin} tone="soft" size="md" />
                <p class="eyebrow-action mt-5">Service area</p>
                <h2 class="mt-2 text-section-subtitle text-[var(--color-text)]">
                  {area.name}, Florida
                </h2>
                <p class="mt-3 flex-1 text-sm leading-7 text-[var(--color-text-muted)]">
                  {area.description}
                </p>
                <a href={`/service-areas/${area.slug}`} class="text-link mt-5">
                  View {area.name} service page
                  <ArrowRight
                    class="h-4 w-4"
                    aria-hidden="true"
                    stroke-width="1.9"
                  />
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </Section>

    <Section
      eyebrow="Available across current city pages"
      title="The same concrete-focused services are linked from every city"
      description="Use a city page for local context or go directly to the service that best matches the requested surface."
      tone="soft"
    >
      <div class="grid gap-4 md:grid-cols-3">
        {
          services.map((service) => (
            <a href={`/${service.slug}`} class="card-link group p-6">
              <h2 class="text-lg font-semibold text-[var(--color-text)] group-hover:text-[var(--color-action)]">
                {service.name}
              </h2>
              <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
                {service.summary}
              </p>
              <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-action)]">
                View service
                <ArrowRight
                  class="h-4 w-4"
                  aria-hidden="true"
                  stroke-width="1.9"
                />
              </span>
            </a>
          ))
        }
      </div>
    </Section>

    <CTASection
      eyebrow="Property outside a listed city?"
      title="Send the exact service address for a coverage review."
      description="Include the requested concrete surfaces and clear photos. CFL Wash Co. will review whether the property and scope fit the current service area before scheduling."
      surface="elevated"
      titleWidth="wide"
    >
      <Fragment slot="actions">
        <Button
          href="/request-quote"
          variant="light"
          data-cta="quote"
          data-cta-location="service-areas-hub-final"
        >
          Request a Quote
        </Button>
        {
          hasPhone && (
            <Button
              href={site.phoneHref!}
              variant="inverseGhost"
              data-cta="call"
              data-cta-location="service-areas-hub-final"
            >
              <Phone
                slot="startIcon"
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
              Call {site.phoneDisplay}
            </Button>
          )
        }
      </Fragment>
    </CTASection>
  </main>
</Layout>
