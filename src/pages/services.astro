---
import Button from '../components/ui/Button.astro'
import BreadcrumbSchema from '../components/site/BreadcrumbSchema.astro'
import Breadcrumbs from '../components/site/Breadcrumbs.astro'
import CTASection from '../components/patterns/CTASection.astro'
import HeroSection from '../components/patterns/HeroSection.astro'
import MediaFrame from '../components/patterns/MediaFrame.astro'
import ServiceMenu from '../components/patterns/ServiceMenu.astro'
import Section from '../components/ui/Section.astro'
import Layout from '../layouts/Layout.astro'
import { publicMedia } from '../data/publicMedia'
import { serviceAreas } from '../data/serviceAreas'
import { services } from '../data/services'
import { site } from '../data/site'
import {
  ArrowRight,
  Blocks,
  CarFront,
  ClipboardList,
  Footprints,
  MapPin,
  Phone,
} from '@lucide/astro'

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services' },
]
const hasPhone = Boolean(site.phoneDisplay && site.phoneHref)
const serviceIcons = {
  'driveway-pressure-washing': CarFront,
  'sidewalk-walkway-cleaning': Footprints,
  'concrete-cleaning': Blocks,
} as const
const serviceFits = {
  'driveway-pressure-washing':
    'Choose this when the driveway and front approach are the main visible concern.',
  'sidewalk-walkway-cleaning':
    'Choose this for front walks, entry paths, sidewalk panels, and pedestrian concrete.',
  'concrete-cleaning':
    'Choose this for patios, pads, aprons, curbs, and other appropriate concrete areas.',
} as const
const serviceMedia = {
  'driveway-pressure-washing': publicMedia.serviceDriveway,
  'sidewalk-walkway-cleaning': publicMedia.serviceWalkway,
  'concrete-cleaning': publicMedia.serviceConcrete,
} as const
const serviceMenuItems = services.map((service) => ({
  slug: service.slug,
  name: service.name,
  summary: service.summary,
  fit: serviceFits[service.slug],
  media: serviceMedia[service.slug],
  icon: serviceIcons[service.slug],
}))
---

<Layout
  title="Pressure Washing Services in Central Florida | CFL Wash Co."
  description="Explore driveway pressure washing, sidewalk and walkway cleaning, and concrete cleaning services from CFL Wash Co. in Central Florida."
  canonicalPath="/services"
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />
  <main>
    <Breadcrumbs items={breadcrumbs} />

    <HeroSection
      variant="split"
      tone="soft"
      eyebrow="Pressure washing services"
      title="Concrete cleaning services for Central Florida homes."
      description="CFL Wash Co. keeps the current service offer focused on driveways, sidewalks, walkways, entries, patios, pads, curbs, and similar hard surfaces. Choose the closest service below, then share the property and surface details for review."
    >
      <Fragment slot="actions">
        <Button
          href="/request-quote"
          size="lg"
          fullWidth
          class="sm:w-auto"
          data-cta="quote"
          data-cta-location="services-hub-hero"
        >
          <ClipboardList
            slot="startIcon"
            class="h-5 w-5"
            aria-hidden="true"
            stroke-width="1.8"
          />
          Request a Quote
        </Button>
        {
          hasPhone && (
            <Button
              href={site.phoneHref!}
              variant="secondary"
              size="lg"
              fullWidth
              class="sm:w-auto"
              data-cta="call"
              data-cta-location="services-hub-hero"
            >
              <Phone
                slot="startIcon"
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
              Call {site.phoneDisplay}
            </Button>
          )
        }
      </Fragment>

      <MediaFrame
        slot="media"
        media={publicMedia.serviceConcrete}
        imageClass="aspect-[16/11] lg:aspect-[11/10]"
        loading="eager"
        fetchpriority="high"
      />
    </HeroSection>

    <Section
      eyebrow="Current services"
      title="Choose the surface that needs attention"
      description="Each page explains the active scope, quote considerations, preparation, and common homeowner questions for that service."
      class="border-t border-[var(--color-border)]"
    >
      <ServiceMenu items={serviceMenuItems} />
    </Section>

    <Section
      eyebrow="Choosing a service"
      title="One quote can include connected concrete areas"
      description="You do not need to submit separate requests when the driveway, front walk, sidewalk, entry, or patio are part of one property cleanup. List every area you want considered and include wide and close photos."
      tone="soft"
    >
      <div class="grid gap-8 md:grid-cols-3 md:gap-0">
        <div class="md:pr-8">
          <h2 class="text-lg font-semibold text-[var(--color-text)]">
            Start with the main concern
          </h2>
          <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
            Choose the service page that most closely matches the surface
            driving the request.
          </p>
        </div>
        <div
          class="border-t border-[var(--color-border)] pt-8 md:border-l md:border-t-0 md:px-8 md:pt-0"
        >
          <h2 class="text-lg font-semibold text-[var(--color-text)]">
            Add connected surfaces
          </h2>
          <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
            Include nearby concrete areas when they should be reviewed as one
            proposed scope.
          </p>
        </div>
        <div
          class="border-t border-[var(--color-border)] pt-8 md:border-l md:border-t-0 md:pl-8 md:pt-0"
        >
          <h2 class="text-lg font-semibold text-[var(--color-text)]">
            Identify specialty finishes
          </h2>
          <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
            Mention pavers, coatings, sealers, paint, decorative finishes, or
            exposed aggregate before expectations are set.
          </p>
        </div>
      </div>
    </Section>

    <Section
      eyebrow="Where we work"
      title="Explore the current Central Florida service areas"
      description={`CFL Wash Co. currently publishes ${serviceAreas.length} city pages with local quote guidance and active service links.`}
      spacing="compact"
      class="border-y border-[var(--color-border)]"
    >
      <a href="/service-areas" class="text-link">
        <MapPin class="h-5 w-5" aria-hidden="true" stroke-width="1.8" />
        View all service areas
        <ArrowRight class="h-4 w-4" aria-hidden="true" stroke-width="1.9" />
      </a>
    </Section>

    <CTASection
      eyebrow="Request a quote"
      title="Tell us which concrete surfaces need attention."
      description="Share the service address, requested areas, clear photos, access details, and any HOA notice wording so CFL Wash Co. can review the request."
      surface="elevated"
      titleWidth="wide"
    >
      <Fragment slot="actions">
        <Button
          href="/request-quote"
          variant="light"
          data-cta="quote"
          data-cta-location="services-hub-final"
        >
          Request a Quote
        </Button>
        {
          hasPhone && (
            <Button
              href={site.phoneHref!}
              variant="inverseGhost"
              data-cta="call"
              data-cta-location="services-hub-final"
            >
              <Phone
                slot="startIcon"
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
              Call {site.phoneDisplay}
            </Button>
          )
        }
      </Fragment>
    </CTASection>
  </main>
</Layout>
