---
import Button from '../components/ui/Button.astro'
import BreadcrumbSchema from '../components/site/BreadcrumbSchema.astro'
import Breadcrumbs from '../components/site/Breadcrumbs.astro'
import CTASection from '../components/patterns/CTASection.astro'
import HeroSection from '../components/patterns/HeroSection.astro'
import MediaFrame from '../components/patterns/MediaFrame.astro'
import ServiceMenu from '../components/patterns/ServiceMenu.astro'
import Section from '../components/ui/Section.astro'
import Layout from '../layouts/Layout.astro'
import { publicMedia } from '../data/publicMedia'
import { serviceAreas } from '../data/serviceAreas'
import { services } from '../data/services'
import { site } from '../data/site'
import {
  ArrowRight,
  Blocks,
  CarFront,
  ClipboardList,
  Footprints,
  MapPin,
  Phone,
} from '@lucide/astro'

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services' },
]
const hasPhone = Boolean(site.phoneDisplay && site.phoneHref)
const serviceIcons = {
  'driveway-pressure-washing': CarFront,
  'sidewalk-walkway-cleaning': Footprints,
  'concrete-cleaning': Blocks,
} as const
const serviceFits = {
  'driveway-pressure-washing':
    'Best when the driveway and front approach are the biggest visible priority.',
  'sidewalk-walkway-cleaning':
    'Best for front walks, entry paths, sidewalk panels, and connected pedestrian concrete.',
  'concrete-cleaning':
    'Best for patios, pads, aprons, curbs, and entry slabs that do not fit the first two services.',
} as const
const serviceMedia = {
  'driveway-pressure-washing': publicMedia.serviceDriveway,
  'sidewalk-walkway-cleaning': publicMedia.serviceWalkway,
  'concrete-cleaning': publicMedia.serviceConcrete,
} as const
const serviceMenuItems = services.map((service) => ({
  slug: service.slug,
  name: service.name,
  summary: service.summary,
  fit: serviceFits[service.slug],
  media: serviceMedia[service.slug],
  icon: serviceIcons[service.slug],
}))
---

<Layout
  title="Pressure Washing Services in Central Florida | CFL Wash Co."
  description="Compare CFL Wash Co. driveway, sidewalk, walkway, and concrete cleaning services for Central Florida homes, then request a quote."
  canonicalPath="/services"
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />
  <main>
    <Breadcrumbs items={breadcrumbs} />

    <HeroSection
      variant="split"
      tone="soft"
      eyebrow="Pressure washing services"
      title="Concrete cleaning for the surfaces around your home."
      description="Compare three concrete-focused services for Central Florida homes. Start with the surface that matters most; connected concrete can be included in the same request."
    >
      <Fragment slot="actions">
        <Button
          href="/request-quote"
          size="lg"
          fullWidth
          class="sm:w-auto"
          data-cta="quote"
          data-cta-location="services-hub-hero"
        >
          <ClipboardList
            slot="startIcon"
            class="h-5 w-5"
            aria-hidden="true"
            stroke-width="1.8"
          />
          Request a Quote
        </Button>
        {
          hasPhone && (
            <Button
              href={site.phoneHref!}
              variant="secondary"
              size="lg"
              fullWidth
              class="sm:w-auto"
              data-cta="call"
              data-cta-location="services-hub-hero"
            >
              <Phone
                slot="startIcon"
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
              Call {site.phoneDisplay}
            </Button>
          )
        }
      </Fragment>

      <MediaFrame
        slot="media"
        media={publicMedia.serviceConcrete}
        imageClass="aspect-[16/11] lg:aspect-[11/10]"
        loading="eager"
        fetchpriority="high"
      />
    </HeroSection>

    <Section
      eyebrow="Current services"
      title="Start with the concrete that needs attention"
      description="Choose driveway cleaning, walking-surface cleaning, or another concrete area. Each page explains where the service fits, what can affect the work, and what to send."
      class="border-t border-[var(--color-border)]"
    >
      <ServiceMenu items={serviceMenuItems} />
    </Section>

    <Section
      eyebrow="Choosing a service"
      title="Include connected concrete in one request"
      description="If the driveway, front walk, sidewalk, entry, or patio all need attention, list them together. Wide photos show how the areas connect; close photos show stains, finishes, and wear."
      tone="soft"
    >
      <div class="grid gap-8 md:grid-cols-3 md:gap-0">
        <div class="md:pr-8">
          <h2 class="text-lg font-semibold text-[var(--color-text)]">
            Lead with the main surface
          </h2>
          <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
            Choose the service that best matches the area driving the cleanup.
          </p>
        </div>
        <div
          class="border-t border-[var(--color-border)] pt-8 md:border-l md:border-t-0 md:px-8 md:pt-0"
        >
          <h2 class="text-lg font-semibold text-[var(--color-text)]">
            Add nearby concrete
          </h2>
          <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
            Include connected areas you want considered at the same property.
          </p>
        </div>
        <div
          class="border-t border-[var(--color-border)] pt-8 md:border-l md:border-t-0 md:pl-8 md:pt-0"
        >
          <h2 class="text-lg font-semibold text-[var(--color-text)]">
            Flag specialty finishes
          </h2>
          <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
            Point out pavers, coatings, sealers, paint, decorative finishes, or
            exposed aggregate.
          </p>
        </div>
      </div>
    </Section>

    <Section
      eyebrow="Where we work"
      title="Explore the current Central Florida service areas"
      description={`See the ${serviceAreas.length} published cities currently served and find the page for your location.`}
      spacing="compact"
      class="border-y border-[var(--color-border)]"
    >
      <a href="/service-areas" class="text-link">
        <MapPin class="h-5 w-5" aria-hidden="true" stroke-width="1.8" />
        View all service areas
        <ArrowRight class="h-4 w-4" aria-hidden="true" stroke-width="1.9" />
      </a>
    </Section>

    <CTASection
      eyebrow="Request a quote"
      title="Show us the concrete you want cleaned."
      description="Send the service address, wide and close photos, access notes, and any HOA wording that applies. Start with one area or include connected concrete in the same request."
      surface="elevated"
      titleWidth="wide"
    >
      <Fragment slot="actions">
        <Button
          href="/request-quote"
          variant="light"
          data-cta="quote"
          data-cta-location="services-hub-final"
        >
          Request a Quote
        </Button>
        {
          hasPhone && (
            <Button
              href={site.phoneHref!}
              variant="inverseGhost"
              data-cta="call"
              data-cta-location="services-hub-final"
            >
              <Phone
                slot="startIcon"
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
              Call {site.phoneDisplay}
            </Button>
          )
        }
      </Fragment>
    </CTASection>
  </main>
</Layout>
