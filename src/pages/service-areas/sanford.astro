---
import Button from '../../components/ui/Button.astro'
import BreadcrumbSchema from '../../components/site/BreadcrumbSchema.astro'
import Breadcrumbs from '../../components/site/Breadcrumbs.astro'
import CTASection from '../../components/patterns/CTASection.astro'
import Card from '../../components/ui/Card.astro'
import CityContextMedia from '../../components/patterns/CityContextMedia.astro'
import FAQList from '../../components/patterns/FAQList.astro'
import HeroSection from '../../components/patterns/HeroSection.astro'
import LinkGrid from '../../components/patterns/LinkGrid.astro'
import Section from '../../components/ui/Section.astro'
import Layout from '../../layouts/Layout.astro'
import { cityContextImages } from '../../data/cityContextImages'
import { site } from '../../data/site'
import { serviceAreas } from '../../data/serviceAreas'
import { services } from '../../data/services'
import { ClipboardCheck, FileText, MapPinned, Phone } from '@lucide/astro'

const area = serviceAreas.find((item) => item.slug === 'sanford')!
const cityContextImage = cityContextImages.sanford
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: area.name, href: `/service-areas/${area.slug}` },
]
const nearbyAreas = serviceAreas.filter((item) =>
  ['debary', 'deltona'].includes(item.slug),
)
const hasPhone = Boolean(site.phoneDisplay && site.phoneHref)

const seoTitle =
  'Pressure Washing in Sanford for Historic Entries and Concrete | CFL Wash Co.'
const seoDescription =
  'Sanford residential pressure washing quotes for driveways, front walks, curbs, and entry concrete with historic-district, alley-access, and waterfront-drainage notes.'

const serviceLinks = services.map((service) => ({
  label: service.name,
  href: `/${service.slug}`,
  description: service.summary,
}))
const nearbyAreaLinks = nearbyAreas.map((nearbyArea) => ({
  label: nearbyArea.name,
  href: `/service-areas/${nearbyArea.slug}`,
}))

const localContexts = [
  {
    title: 'Historic residential blocks can mix older concrete and brick edges',
    description:
      'Sanford Residential and Georgetown historic-district context means a driveway or front walk may sit beside brick, painted edges, older slabs, or mixed-material frontage that should be disclosed before the quote is reviewed.',
  },
  {
    title: 'Downtown-adjacent access can be tighter than the Volusia pages',
    description:
      'Near downtown Sanford, the Park Avenue corridor, or the 2nd Street streetscape area, on-street parking, alleys, curb lines, and public-versus-private frontage need to be separated early.',
  },
  {
    title: 'Waterfront-influenced runoff deserves a direct note',
    description:
      'Lake Monroe and Sanford stormwater context make slope, drains, inlets, and runoff direction more relevant here than generic curb-appeal language.',
  },
]

const homeownerScenarios = [
  {
    title:
      'Historic-district driveway and entry concrete beside brick or mixed materials',
    description:
      'A Sanford homeowner may need the driveway, front walk, or entry pad reviewed where visible concrete meets brick streetscape edges, painted sections, or older mixed-material frontage.',
  },
  {
    title:
      'Downtown-adjacent frontage with alley access or curbside parking limits',
    description:
      'Some requests need a service window, alley note, and a clear public/private split because the visible concrete sits near reconstructed sidewalks, curbs, or on-street parking patterns.',
  },
  {
    title: 'Waterfront-adjacent entry concrete with drain or runoff concerns',
    description:
      'Where the front approach sheds toward an inlet, curb line, or low spot, the quote should include slope notes and close photos instead of assuming the buildup is a standard flat-slab cleanup.',
  },
]

const quoteDetails = [
  'Surface type: say whether the request involves plain concrete, sidewalk panels, curbs, aprons, entry pads, patio slabs, or a painted, sealed, decorative, coated, exposed-aggregate, or brick-adjacent surface.',
  'Scope: list the driveway, front walk, curb edge, apron, entry slab, sidewalk-adjacent panels, or other homeowner-controlled concrete included in the request.',
  'Photos: send one wide photo that shows the full frontage plus close photos of buildup, edges, drains, older sections, and any place where concrete meets brick or another finish.',
  'Access: mention alleys, curbside parking, gates, downtown detours, vehicles, planters, bins, furniture, or tight side-yard access.',
  'Condition notes: call out dark organic buildup, tire marks, rust or mineral staining, oil, leaf staining, older discoloration, or visibly sensitive edge conditions.',
  'Drainage notes: include slope, inlet locations, curb flow, ponding, runoff direction, and whether the concrete sits near a garage, entry threshold, or waterfront-influenced drainage path.',
  'HOA or property-maintenance notice details: share the exact wording, deadline, named surface, and any parking or access constraint that affects the cited concrete.',
]

const faqs = [
  {
    question:
      'Does Sanford include homes where brick streets, reconstructed sidewalks, and residential concrete sit close together?',
    answer:
      'Yes. That mix shows up more often in Sanford than on the current Volusia pages, so it helps to describe exactly which concrete sections belong to the homeowner request.',
  },
  {
    question:
      'What should I mention if the requested Sanford surface is near a curb, alley, or public sidewalk?',
    answer:
      'Say which surfaces are private, whether alley or curbside access is needed, and whether parking or reconstructed sidewalk conditions affect the approach.',
  },
  {
    question:
      "Can CFL Wash Co. review driveway and walkway cleaning for homes in Sanford's older historic districts?",
    answer:
      'Yes, as long as the request stays tied to the actual residential concrete and notes whether the surface is older, mixed-material, painted, sealed, decorative, or otherwise non-standard.',
  },
  {
    question:
      'What if the concrete is next to brick, painted concrete, sealed surfaces, or decorative finishes?',
    answer:
      'Include that in the quote request up front. Brick-adjacent and specialty surfaces should be identified before the scope is reviewed so expectations stay narrow.',
  },
  {
    question:
      'Can a Sanford quote include visible entry concrete tied to an HOA or property-maintenance notice?',
    answer:
      'Yes. Send the exact notice wording, due date, named surface, and current photos so the request stays document-based without implying HOA approval or private-rule advice.',
  },
  {
    question:
      'What drainage details matter more for Sanford properties near inlets, slopes, or waterfront-influenced areas?',
    answer:
      'Slope, runoff direction, ponding, inlet locations, and how close the concrete sits to a garage, door threshold, or curb line all help explain the layout and visible buildup.',
  },
]
---

<Layout
  title={seoTitle}
  description={seoDescription}
  canonicalPath="/service-areas/sanford"
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />
  <main>
    <Breadcrumbs items={breadcrumbs} />

    <HeroSection
      variant="split"
      eyebrow="Sanford service area"
      title="Pressure washing in Sanford for historic entries, alley-access driveways, and visible concrete"
      description="CFL Wash Co. serves Sanford homeowners with concrete-focused quotes for driveways, front walks, sidewalk-adjacent panels, curbs, aprons, entry pads, and other appropriate residential concrete where historic frontage, downtown access, and drainage conditions can change the scope."
    >
      <Fragment slot="actions">
        <Button
          href="/request-quote"
          data-cta="quote"
          data-cta-location={`service-area-${area.slug}`}
        >
          Request a Quote
        </Button>
        {
          hasPhone ? (
            <Button
              href={site.phoneHref!}
              variant="secondary"
              data-cta="call"
              data-cta-location={`service-area-${area.slug}`}
            >
              <Phone
                slot="startIcon"
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
              Call {site.phoneDisplay}
            </Button>
          ) : (
            <Button
              href={`mailto:${site.email}`}
              variant="secondary"
              data-cta="email"
              data-cta-location={`service-area-${area.slug}`}
            >
              Email CFL Wash Co.
            </Button>
          )
        }
      </Fragment>

      <Fragment slot="media">
        <CityContextMedia
          image={{ ...cityContextImage.image, alt: cityContextImage.alt }}
          caption={cityContextImage.caption}
          attribution={cityContextImage.attribution}
          loading="eager"
          class="max-w-xl justify-self-end"
        />
      </Fragment>
    </HeroSection>

    <Section
      eyebrow="City context"
      title="Sanford requests need frontage, access, and drainage details that do not show up the same way on the Volusia pages"
      description="The local value here is the mix of historic residential districts, downtown-adjacent infrastructure, and waterfront-aware drainage conditions that change how visible concrete should be described."
      class="border-t border-[var(--color-border)]"
      contentWidth="full"
    >
      <div class="grid gap-8 lg:grid-cols-[minmax(260px,0.72fr)_minmax(0,1fr)]">
        <Card tone="soft" padding="lg">
          <div class="flex items-center gap-3">
            <span
              class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-[var(--color-primary)] text-white"
            >
              <MapPinned
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
            </span>
            <h2 class="text-lg font-semibold text-[var(--color-text)]">
              Three Sanford notes worth putting in the first message
            </h2>
          </div>
          <p class="mt-4 text-sm leading-7 text-[var(--color-text-muted)]">
            Mention the historic-residential setting only when it changes the
            quote. The same goes for alley access, curbside parking, brick
            adjacency, reconstructed sidewalks, or runoff moving toward an inlet
            or curb line.
          </p>
        </Card>

        <div class="grid gap-4 md:grid-cols-3">
          {
            localContexts.map((item) => (
              <Card class="bg-white">
                <h3 class="text-base font-semibold text-[var(--color-text)]">
                  {item.title}
                </h3>
                <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
                  {item.description}
                </p>
              </Card>
            ))
          }
        </div>
      </div>
    </Section>

    <Section
      eyebrow="Common situations"
      title="Three Sanford quote patterns that should not be handled like a city-name swap"
      description="These are the homeowner situations that justify a dedicated Sanford page instead of reused suburban service-area copy."
    >
      <div class="grid gap-4 lg:grid-cols-3">
        {
          homeownerScenarios.map((item) => (
            <Card class="bg-white">
              <h3 class="text-lg font-semibold text-[var(--color-text)]">
                {item.title}
              </h3>
              <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
                {item.description}
              </p>
            </Card>
          ))
        }
      </div>
    </Section>

    <Section
      eyebrow="Services and scope"
      title="Use the active service pages, then add the Sanford-specific layout notes"
      description="The launch scope remains concrete-focused. What changes in Sanford is the need to identify brick adjacency, public/private frontage splits, alleys, and drainage conditions before the quote is reviewed."
      tone="soft"
      contentWidth="full"
    >
      <div
        class="grid gap-8 lg:grid-cols-[minmax(0,1.05fr)_minmax(280px,0.8fr)] lg:items-start"
      >
        <LinkGrid items={serviceLinks} density="comfortable" class="gap-4" />

        <div class="grid gap-4">
          <Card tone="soft" class="border-dashed">
            <h3 class="text-base font-semibold text-[var(--color-text)]">
              Keep city-owned and homeowner-controlled surfaces separate
            </h3>
            <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
              A Sanford request can mention reconstructed sidewalks, curb lines,
              or alley conditions, but it should still identify which concrete
              sections belong to the homeowner scope.
            </p>
          </Card>

          <Card class="bg-white">
            <h3 class="text-base font-semibold text-[var(--color-text)]">
              Specialty surfaces stay conditional
            </h3>
            <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
              Painted concrete, sealed concrete, decorative finishes, exposed
              aggregate, and brick-adjacent areas should all be disclosed before
              the request is reviewed.
            </p>
          </Card>
        </div>
      </div>
    </Section>

    <Section
      eyebrow="Quote preparation"
      title="What to send with a Sanford quote for driveways, walks, curbs, and entry concrete"
      description="A better Sanford request starts with the actual layout and access variables, then adds specialty-surface and drainage notes where they matter."
      class="border-y border-[var(--color-border)]"
    >
      <div class="grid gap-6 lg:grid-cols-[minmax(260px,0.52fr)_minmax(0,1fr)]">
        <div
          class="rounded-[var(--radius-lg)] bg-[var(--color-primary)] p-6 text-white"
        >
          <FileText class="h-7 w-7" aria-hidden="true" stroke-width="1.8" />
          <h3 class="mt-4 text-xl font-semibold">
            Sanford photos should show frontage, access, and runoff clues
          </h3>
          <p class="mt-3 text-sm leading-7 text-white/85">
            One wide photo should show the full approach from the street,
            parking edge, or alley. Close photos should capture brick or mixed
            material edges, drains, older sections, and any visible slope or
            ponding that affects the concrete.
          </p>
        </div>

        <ul class="grid gap-3 sm:grid-cols-2">
          {
            quoteDetails.map((item) => (
              <li class="rounded-[var(--radius-md)] border border-[var(--color-border)] bg-white p-4 text-sm leading-7 text-[var(--color-text-muted)]">
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </Section>

    <Section
      eyebrow="HOA and nearby areas"
      title="Keep HOA notices practical, and use the nearest active page when the address lands outside Sanford"
      description="The page can support HOA-notice cleanup and older-frontage review without implying HOA approval, municipal authority, or knowledge of Sanford-edge addresses that still need a different city page."
      tone="warm"
      contentWidth="full"
    >
      <div
        class="grid gap-8 lg:grid-cols-[minmax(0,0.95fr)_minmax(260px,0.75fr)] lg:items-start"
      >
        <div class="grid gap-4">
          <Card class="bg-white">
            <div class="flex items-center gap-3">
              <ClipboardCheck
                class="h-6 w-6 text-[var(--color-primary)]"
                aria-hidden="true"
                stroke-width="1.8"
              />
              <h3 class="text-lg font-semibold text-[var(--color-text)]">
                HOA notice support stays document-based
              </h3>
            </div>
            <p class="mt-4 text-sm leading-7 text-[var(--color-text-muted)]">
              Send the exact wording, deadline, named surface, and current
              photos. CFL Wash Co. can review the concrete-focused request
              without claiming HOA approval, preferred-vendor status, or
              private-rule interpretation.
            </p>
          </Card>

          <Card class="bg-white">
            <h3 class="text-lg font-semibold text-[var(--color-text)]">
              Historic or downtown context is not a blanket claim
            </h3>
            <p class="mt-4 text-sm leading-7 text-[var(--color-text-muted)]">
              Only mention Georgetown, downtown-adjacent frontage, or
              waterfront-influenced drainage when those details actually change
              the layout, access, or surface conditions at the home.
            </p>
          </Card>
        </div>

        <div class="grid gap-4">
          <Card tone="soft" class="border-dashed">
            <h3 class="text-base font-semibold text-[var(--color-text)]">
              Nearby active areas
            </h3>
            <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
              Use the actual service address or nearest cross streets when the
              property sits closer to another active page than to Sanford city
              limits.
            </p>
          </Card>
          <LinkGrid items={nearbyAreaLinks} columns="two" class="gap-4" />
        </div>
      </div>
    </Section>

    <Section eyebrow="FAQ" title="Sanford pressure washing questions">
      <FAQList faqs={faqs} columns="two" />
    </Section>

    <CTASection
      title="Request a Sanford driveway, walkway, or concrete cleaning quote."
      description="Share the surface type, photos, historic or access context, drainage notes, and any HOA notice wording so the Sanford request can be reviewed on the right scope."
      titleWidth="wide"
    >
      <Fragment slot="actions">
        <Button
          href="/request-quote"
          variant="secondary"
          class="bg-white text-[var(--color-primary)] hover:bg-[var(--color-surface)]"
          data-cta="quote"
          data-cta-location={`service-area-${area.slug}-final`}
        >
          Request a Quote
        </Button>
        {
          hasPhone ? (
            <Button
              href={site.phoneHref!}
              variant="ghost"
              class="text-white ring-1 ring-inset ring-white/35 hover:bg-white/10"
              data-cta="call"
              data-cta-location={`service-area-${area.slug}-final`}
            >
              <Phone
                slot="startIcon"
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
              Call {site.phoneDisplay}
            </Button>
          ) : (
            <Button
              href={`mailto:${site.email}`}
              variant="ghost"
              class="text-white ring-1 ring-inset ring-white/35 hover:bg-white/10"
              data-cta="email"
              data-cta-location={`service-area-${area.slug}-final`}
            >
              Email CFL Wash Co.
            </Button>
          )
        }
      </Fragment>
    </CTASection>
  </main>
</Layout>
