---
import Button from '../../components/ui/Button.astro'
import BreadcrumbSchema from '../../components/site/BreadcrumbSchema.astro'
import Breadcrumbs from '../../components/site/Breadcrumbs.astro'
import CTASection from '../../components/patterns/CTASection.astro'
import Card from '../../components/ui/Card.astro'
import CityContextMedia from '../../components/patterns/CityContextMedia.astro'
import FAQList from '../../components/patterns/FAQList.astro'
import HeroSection from '../../components/patterns/HeroSection.astro'
import LinkGrid from '../../components/patterns/LinkGrid.astro'
import Section from '../../components/ui/Section.astro'
import SplitFeature from '../../components/patterns/SplitFeature.astro'
import Layout from '../../layouts/Layout.astro'
import { cityContextImages } from '../../data/cityContextImages'
import { site } from '../../data/site'
import { serviceAreas } from '../../data/serviceAreas'
import { services } from '../../data/services'
import { ClipboardCheck, FileText, MapPinned, Phone } from '@lucide/astro'

const area = serviceAreas.find((item) => item.slug === 'debary')!
const cityContextImage = cityContextImages.debary
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: area.name, href: `/service-areas/${area.slug}` },
]
const nearbyAreas = serviceAreas.filter((item) =>
  ['deltona', 'orange-city'].includes(item.slug),
)
const hasPhone = Boolean(site.phoneDisplay && site.phoneHref)

const seoTitle =
  'Pressure Washing in DeBary for Driveways, Walkways, and Concrete | CFL Wash Co.'
const seoDescription =
  'DeBary residential pressure washing quotes for driveways, sidewalk-adjacent concrete, compact entry areas, and HOA-notice cleanup with drainage and access notes.'

const serviceLinks = services.map((service) => ({
  label: service.name,
  href: `/${service.slug}`,
  description: service.summary,
}))
const nearbyAreaLinks = nearbyAreas.map((nearbyArea) => ({
  label: nearbyArea.name,
  href: `/service-areas/${nearbyArea.slug}`,
}))

const debaryContexts = [
  {
    title: 'Older-residential streets need drainage context',
    description:
      'Some older DeBary streets still deal with drainage problems tied to minimal stormwater infrastructure, so low spots and wash-over patterns can matter in a quote.',
  },
  {
    title: 'Sidewalk and trail access can affect the request',
    description:
      'DeBary Public Works maintains sidewalks and rights-of-way, and some travel patterns push golf carts onto adjacent sidewalks and trails, so access notes should separate homeowner scope from nearby public concrete.',
  },
  {
    title: 'Compact entries are part of the city mix',
    description:
      'DeBary Main Street and the SunRail area add smaller townhome-style and TOD-edge entry layouts where a short apron, entry pad, or front walk can matter more than a large driveway.',
  },
]

const homeownerScenarios = [
  {
    title: 'Older-street driveway quote with drainage disclosure',
    description:
      'If stormwater crosses the driveway or sediment settles after rain, describe where water collects and include a full approach photo from the street to the entry.',
  },
  {
    title: 'Sidewalk- or trail-adjacent frontage scope review',
    description:
      'Some requests need to clarify whether the quote covers only homeowner-controlled concrete or also includes highly visible sections near sidewalks, curb edges, or trail-adjacent approaches.',
  },
  {
    title: 'Compact townhome or TOD-edge entry bundle',
    description:
      'Short front walks, garage aprons, and smaller entry pads near newer Main Street and transit-oriented growth areas can still be good fits when the surface and access are clearly defined.',
  },
]

const quoteDetails = [
  'Surface type: say whether the area is plain concrete or a surface such as decorative, sealed, painted, coated, or paver-adjacent concrete.',
  'Scope: list the driveway, front walk, sidewalk-adjacent panels, curb edge, apron, patio slab, or entry pad included in the request.',
  'Access: mention vehicles, side-yard gates, bikes, golf carts, shared drives, narrow paths, or other layout constraints.',
  'Condition notes: describe storm-related debris, dark buildup, irrigation staining, organic staining, or older discoloration.',
  'Drainage or grade: note low spots, runoff direction, or places where sediment settles after heavy rain.',
  'HOA notice details: include the exact wording, deadline, named surface, and photos if an association notice is involved.',
]

const faqs = [
  {
    question: 'Why should I mention drainage when I request a DeBary quote?',
    answer:
      'Some older DeBary residential streets still deal with drainage issues, so slope and water-flow context can help explain the layout and buildup pattern.',
  },
  {
    question:
      'Can a DeBary quote include driveway and sidewalk-adjacent concrete together?',
    answer:
      'Yes, if the request clearly identifies which concrete sections are part of the homeowner-controlled scope.',
  },
  {
    question: 'Why does access matter more in some DeBary neighborhoods?',
    answer:
      'Trail, sidewalk, golf-cart, shared-drive, or compact-entry conditions can change how reachable the concrete is and what details belong in the quote.',
  },
  {
    question:
      'Can a smaller townhome-style entry area still be a good fit for a DeBary quote?',
    answer:
      'Yes. A smaller entry bundle can still be reviewed when the surfaces are appropriate residential concrete and the scope is clearly defined.',
  },
  {
    question:
      'What if my DeBary surface is sealed, painted, decorative, or previously coated?',
    answer:
      'Call that out in the quote request before expectations are set so the surface can be reviewed correctly.',
  },
  {
    question:
      'What should I send if an HOA notice names driveway or entry concrete in DeBary?',
    answer:
      'Send the exact wording, deadline, named surface, and photos of the area cited so the quote stays tied to the actual request.',
  },
]
---

<Layout
  title={seoTitle}
  description={seoDescription}
  canonicalPath="/service-areas/debary"
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />
  <main>
    <Breadcrumbs items={breadcrumbs} />

    <HeroSection
      variant="split"
      eyebrow="DeBary service area"
      title="Residential pressure washing in DeBary for driveways, walkways, sidewalks, and entry concrete"
      description="CFL Wash Co. serves DeBary homeowners with concrete-focused quotes for driveways, walkways, sidewalk-adjacent sections, curbs, aprons, entry pads, and other appropriate residential concrete where drainage and access notes can change the scope."
    >
      <Fragment slot="actions">
        <Button
          href="/request-quote"
          data-cta="quote"
          data-cta-location={`service-area-${area.slug}`}
        >
          Request a Quote
        </Button>
        {
          hasPhone ? (
            <Button
              href={site.phoneHref!}
              variant="secondary"
              data-cta="call"
              data-cta-location={`service-area-${area.slug}`}
            >
              <Phone
                slot="startIcon"
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
              Call {site.phoneDisplay}
            </Button>
          ) : (
            <Button
              href={`mailto:${site.email}`}
              variant="secondary"
              data-cta="email"
              data-cta-location={`service-area-${area.slug}`}
            >
              Email CFL Wash Co.
            </Button>
          )
        }
      </Fragment>

      <Fragment slot="media">
        <CityContextMedia
          image={{ ...cityContextImage.image, alt: cityContextImage.alt }}
          caption={cityContextImage.caption}
          attribution={cityContextImage.attribution}
          loading="eager"
          class="max-w-xl justify-self-end"
        />
      </Fragment>
    </HeroSection>

    <Section
      eyebrow="Residential context"
      title="DeBary requests need more access and drainage detail than a generic driveway page"
      description="The city mixes older residential streets, trail-connected frontage, and newer Main Street growth areas, so the right quote depends on layout, reach, and homeowner-controlled scope."
      class="border-t border-[var(--color-border)]"
    >
      <div
        class="grid gap-6 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:items-start"
      >
        <Card tone="soft" padding="lg">
          <div class="flex items-center gap-3">
            <span
              class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-[var(--color-primary)] text-white"
            >
              <MapPinned
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
            </span>
            <h3 class="text-lg font-semibold text-[var(--color-text)]">
              Three DeBary layouts worth calling out
            </h3>
          </div>
          <p class="mt-4 text-sm leading-7 text-[var(--color-text-muted)]">
            A better request starts with what makes the property different:
            older drainage-sensitive frontage, sidewalk or trail access
            constraints, or a compact DeBary Main Street or SunRail-adjacent
            entry setup.
          </p>
        </Card>

        <div class="grid gap-4 md:grid-cols-3">
          {
            debaryContexts.map((item) => (
              <Card class="bg-white">
                <h3 class="text-base font-semibold text-[var(--color-text)]">
                  {item.title}
                </h3>
                <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
                  {item.description}
                </p>
              </Card>
            ))
          }
        </div>
      </div>
    </Section>

    <SplitFeature
      eyebrow="Available services"
      title="Use the active service pages, then add the DeBary-specific layout notes"
      description="The launch scope is still concrete-focused, but the quote should also explain whether the request sits near older drainage issues, trail visibility, or compact entry geometry."
      columns="content-heavy"
      titleSize="section"
      descriptionSize="lead"
    >
      <LinkGrid items={serviceLinks} class="gap-4" density="comfortable" />
    </SplitFeature>

    <Section
      eyebrow="Common situations"
      title="Three DeBary quote patterns that do not transfer cleanly to another city"
      description="These are the local cases that justify a DeBary-specific page instead of recycled service-area copy."
    >
      <div class="grid gap-4 lg:grid-cols-3">
        {
          homeownerScenarios.map((item) => (
            <Card class="bg-white">
              <h3 class="text-lg font-semibold text-[var(--color-text)]">
                {item.title}
              </h3>
              <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
                {item.description}
              </p>
            </Card>
          ))
        }
      </div>
    </Section>

    <Section
      eyebrow="Quote preparation"
      title="What to send with a DeBary concrete cleaning request"
      description="Access constraints, drainage behavior, and specialty-surface notes matter more here than a generic before-and-after description."
      class="border-y border-[var(--color-border)]"
    >
      <div class="grid gap-6 lg:grid-cols-[minmax(260px,0.52fr)_minmax(0,1fr)]">
        <div
          class="rounded-[var(--radius-lg)] bg-[var(--color-primary)] p-6 text-white"
        >
          <FileText class="h-7 w-7" aria-hidden="true" stroke-width="1.8" />
          <h3 class="mt-4 text-xl font-semibold">
            Photos should show approach, access, and edge conditions
          </h3>
          <p class="mt-3 text-sm leading-7 text-white/85">
            For DeBary, one wide photo should show the full path from street to
            entry. Close photos should capture surface type, buildup, drainage
            edges, and anything that makes the concrete harder to access near
            sidewalks, trails, or shared drives.
          </p>
        </div>

        <ul class="grid gap-3 sm:grid-cols-2">
          {
            quoteDetails.map((item) => (
              <li class="rounded-[var(--radius-md)] border border-[var(--color-border)] bg-white p-4 text-sm leading-7 text-[var(--color-text-muted)]">
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </Section>

    <Section
      eyebrow="HOA and specialty surfaces"
      title="Keep HOA notices and specialty-surface disclosures practical"
      description="The page can support HOA-notice cleanup and compact-entry quoting without implying association approval, public-trail work, or commercial coverage."
      tone="warm"
    >
      <div class="grid gap-4 lg:grid-cols-2">
        <Card class="bg-white">
          <div class="flex items-center gap-3">
            <ClipboardCheck
              class="h-6 w-6 text-[var(--color-primary)]"
              aria-hidden="true"
              stroke-width="1.8"
            />
            <h3 class="text-lg font-semibold text-[var(--color-text)]">
              HOA notice support stays document-based
            </h3>
          </div>
          <p class="mt-4 text-sm leading-7 text-[var(--color-text-muted)]">
            Send the exact wording, deadline, named surface, and photos. CFL
            Wash Co. does not claim HOA approval, private-rule expertise, or
            preferred-vendor status.
          </p>
        </Card>

        <Card class="bg-white">
          <h3 class="text-lg font-semibold text-[var(--color-text)]">
            Call out compact entries and non-standard concrete early
          </h3>
          <p class="mt-4 text-sm leading-7 text-[var(--color-text-muted)]">
            Smaller aprons, short entry walks, decorative concrete, or
            previously coated sections should all be identified before the
            request is reviewed so the residential scope stays clear.
          </p>
        </Card>
      </div>
    </Section>

    <Section
      eyebrow="Nearby active areas"
      title="Use the matching nearby page when the address falls closer to Orange City or Deltona"
      description="DeBary shares edges with other active West Volusia pages, so the actual service address or nearest cross streets still matter."
      tone="soft"
    >
      <LinkGrid items={nearbyAreaLinks} columns="two" />
    </Section>

    <Section eyebrow="FAQ" title="DeBary pressure washing questions">
      <FAQList faqs={faqs} columns="two" />
    </Section>

    <CTASection
      title="Request a DeBary driveway, walkway, sidewalk, or concrete cleaning quote."
      description="Share the surface type, layout photos, access notes, drainage details, and any HOA notice wording so the DeBary request can be reviewed on the right scope."
      titleWidth="wide"
    >
      <Fragment slot="actions">
        <Button
          href="/request-quote"
          variant="secondary"
          class="bg-white text-[var(--color-primary)] hover:bg-[var(--color-surface)]"
          data-cta="quote"
          data-cta-location={`service-area-${area.slug}-final`}
        >
          Request a Quote
        </Button>
        {
          hasPhone ? (
            <Button
              href={site.phoneHref!}
              variant="ghost"
              class="text-white ring-1 ring-inset ring-white/35 hover:bg-white/10"
              data-cta="call"
              data-cta-location={`service-area-${area.slug}-final`}
            >
              <Phone
                slot="startIcon"
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
              Call {site.phoneDisplay}
            </Button>
          ) : (
            <Button
              href={`mailto:${site.email}`}
              variant="ghost"
              class="text-white ring-1 ring-inset ring-white/35 hover:bg-white/10"
              data-cta="email"
              data-cta-location={`service-area-${area.slug}-final`}
            >
              Email CFL Wash Co.
            </Button>
          )
        }
      </Fragment>
    </CTASection>
  </main>
</Layout>
