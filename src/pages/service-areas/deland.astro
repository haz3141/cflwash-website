---
import Button from '../../components/ui/Button.astro'
import BreadcrumbSchema from '../../components/site/BreadcrumbSchema.astro'
import Breadcrumbs from '../../components/site/Breadcrumbs.astro'
import CTASection from '../../components/patterns/CTASection.astro'
import Card from '../../components/ui/Card.astro'
import CityContextMedia from '../../components/patterns/CityContextMedia.astro'
import FAQList from '../../components/patterns/FAQList.astro'
import HeroSection from '../../components/patterns/HeroSection.astro'
import LinkGrid from '../../components/patterns/LinkGrid.astro'
import Section from '../../components/ui/Section.astro'
import SplitFeature from '../../components/patterns/SplitFeature.astro'
import Layout from '../../layouts/Layout.astro'
import { cityContextImages } from '../../data/cityContextImages'
import { site } from '../../data/site'
import { serviceAreas } from '../../data/serviceAreas'
import { services } from '../../data/services'
import { ClipboardCheck, FileText, MapPinned, Phone } from '@lucide/astro'

const area = serviceAreas.find((item) => item.slug === 'deland')!
const cityContextImage = cityContextImages.deland
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: area.name, href: `/service-areas/${area.slug}` },
]
const nearbyAreas = serviceAreas.filter((item) =>
  ['orange-city', 'deltona', 'debary'].includes(item.slug),
)
const hasPhone = Boolean(site.phoneDisplay && site.phoneHref)

const seoTitle =
  'Pressure Washing in DeLand for Driveways, Walkways, and Concrete | CFL Wash Co.'
const seoDescription =
  'DeLand residential pressure washing quotes for driveways, entry concrete, sidewalk-adjacent surfaces, and HOA-notice cleanup with historic-district, downtown, and school-link context.'

const serviceLinks = services.map((service) => ({
  label: service.name,
  href: `/${service.slug}`,
  description: service.summary,
}))
const nearbyAreaLinks = nearbyAreas.map((nearbyArea) => ({
  label: nearbyArea.name,
  href: `/service-areas/${nearbyArea.slug}`,
}))

const localContexts = [
  {
    title: 'Historic districts are real context, not a blanket assumption',
    description:
      'DeLand has multiple historic districts, so a quote should say when an entry, walk, or driveway sits near that kind of setting without pretending every DeLand home has the same surface conditions.',
  },
  {
    title: 'School-link sidewalks can change the scope notes',
    description:
      'The city promotes school-link sidewalks between neighborhoods, schools, parks, shopping, and downtown, so a useful request separates private concrete from any nearby city-maintained panels.',
  },
  {
    title: 'Downtown-adjacent visibility comes with access and drainage notes',
    description:
      'Older slabs, curb parking, narrow approaches, or ponding around visible concrete should be identified early when the property sits close to downtown activity.',
  },
]

const homeownerScenarios = [
  {
    title: 'Historic-district-adjacent entry and walkway review',
    description:
      'A DeLand quote may center on older front walks, porch-adjacent slabs, stairs, or short entry concrete where appearance matters but restoration claims have to stay restrained.',
  },
  {
    title: 'Driveway-plus-walk quote near school-link sidewalks',
    description:
      'Some homeowners want the driveway, front walk, and sidewalk-adjacent concrete reviewed together while still making it clear which sections are part of the homeowner-controlled scope.',
  },
  {
    title:
      'Downtown-adjacent visible concrete with parking or drainage constraints',
    description:
      'Near downtown, the key notes may be where vehicles normally sit, whether the approach is narrow, and whether runoff or ponding changes how the concrete presents.',
  },
]

const quoteDetails = [
  'Surface type: say whether the area is plain concrete or an older, decorative, painted, sealed, coated, or otherwise non-standard surface.',
  'Scope: list the driveway, front walk, entry slab, sidewalk-adjacent sections, curb edge, apron, patio slab, or other homeowner-controlled concrete in the request.',
  'Photos: send one wide photo that shows the full approach, plus close photos of buildup, edges, cracks, coatings, and any visibly older sections.',
  'Access: mention parked vehicles, alley or side access, gates, stairs, planters, narrow approaches, or anything else that affects reach.',
  'Condition notes: call out dark buildup, leaf staining, irrigation discoloration, age-related wear, mixed materials, or places where the surface looks especially sensitive.',
  'Drainage: include ponding, runoff direction, low spots, curb flow, or stormwater edge conditions if water movement affects the concrete.',
  'Location and notice context: mention whether the home sits near the downtown historic district, near school-link sidewalks, or under an HOA notice naming the concrete.',
]

const faqs = [
  {
    question:
      'Why should I mention if my DeLand property is near downtown or a historic district?',
    answer:
      'That context can change access, surface condition, and how visible the concrete is, especially around older entry walks or downtown-adjacent frontage.',
  },
  {
    question: 'Does every DeLand neighborhood have the same sidewalk setup?',
    answer:
      'No. DeLand promotes sidewalk links across neighborhoods, but conditions vary by area, so it helps to describe the actual layout at the property.',
  },
  {
    question:
      'Can one DeLand quote include the driveway, front walk, and sidewalk-adjacent concrete?',
    answer:
      'Yes, as long as the request clearly identifies which concrete sections are part of the homeowner-controlled scope.',
  },
  {
    question:
      'Why should I mention older, coated, or decorative concrete in a DeLand quote?',
    answer:
      'Older-looking or specialty surfaces may need a more careful fit review, so calling them out early keeps expectations narrow.',
  },
  {
    question:
      'What if my DeLand property has drainage or ponding around the concrete?',
    answer:
      'Include that in the request. Ponding, runoff, and low spots can help explain how the surface presents and what the quote needs to review.',
  },
  {
    question:
      'What should I send if an HOA notice names driveway or walkway concrete in DeLand?',
    answer:
      'Send the exact wording, due date, named surface, and photos of the cited area so the request stays tied to the actual scope.',
  },
]
---

<Layout
  title={seoTitle}
  description={seoDescription}
  canonicalPath="/service-areas/deland"
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />
  <main>
    <Breadcrumbs items={breadcrumbs} />

    <HeroSection
      eyebrow="DeLand service area"
      title="Pressure washing in DeLand for historic-district entries, connected walks, and visible concrete"
      description="CFL Wash Co. serves DeLand homeowners with concrete-focused quotes for driveways, front walks, entry slabs, sidewalk-adjacent sections, curbs, aprons, and other appropriate residential concrete where neighborhood context can change the scope."
    >
      <Fragment slot="actions">
        <Button
          href="/request-quote"
          data-cta="quote"
          data-cta-location={`service-area-${area.slug}`}
        >
          Request a Quote
        </Button>
        {
          hasPhone ? (
            <Button
              href={site.phoneHref!}
              variant="secondary"
              data-cta="call"
              data-cta-location={`service-area-${area.slug}`}
            >
              <Phone
                slot="startIcon"
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
              Call {site.phoneDisplay}
            </Button>
          ) : (
            <Button
              href={`mailto:${site.email}`}
              variant="secondary"
              data-cta="email"
              data-cta-location={`service-area-${area.slug}`}
            >
              Email CFL Wash Co.
            </Button>
          )
        }
      </Fragment>

      <aside
        slot="aside"
        aria-label="DeLand quote priorities"
        class="rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6"
      >
        <div class="flex items-center gap-3">
          <span
            class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-[var(--color-primary)] text-white"
          >
            <MapPinned class="h-5 w-5" aria-hidden="true" stroke-width="1.8" />
          </span>
          <h2 class="text-lg font-semibold text-[var(--color-text)]">
            DeLand requests need location notes, not generic curb-appeal copy
          </h2>
        </div>
        <p class="mt-4 text-sm leading-7 text-[var(--color-text-muted)]">
          Say if the property sits near the downtown historic district, near
          school-link sidewalks, or on a downtown-adjacent block where parking
          and drainage affect the approach. Those details keep the quote tied to
          the actual layout.
        </p>
      </aside>
    </HeroSection>

    <Section
      eyebrow="City context"
      title="DeLand quote prep changes when the concrete sits near historic, connected, or downtown-adjacent blocks"
      description="The local value here is not city history for its own sake. It is the practical context that changes access, scope wording, and how visible the concrete is at the home."
      class="border-t border-[var(--color-border)]"
      contentWidth="full"
    >
      <div
        class="grid gap-8 lg:grid-cols-[minmax(280px,0.78fr)_minmax(0,1fr)] lg:items-start"
      >
        <CityContextMedia
          image={{ ...cityContextImage.image, alt: cityContextImage.alt }}
          caption={cityContextImage.caption}
          attribution={cityContextImage.attribution}
          loading="eager"
        />

        <div class="grid gap-4">
          <Card tone="soft" padding="lg">
            <div class="flex items-center gap-3">
              <MapPinned
                class="h-6 w-6 text-[var(--color-primary)]"
                aria-hidden="true"
                stroke-width="1.8"
              />
              <h3 class="text-lg font-semibold text-[var(--color-text)]">
                Three DeLand clues worth putting in the first message
              </h3>
            </div>
            <p class="mt-4 text-sm leading-7 text-[var(--color-text-muted)]">
              Mention the neighborhood context only when it changes the quote:
              older or more visible entry concrete, nearby school-link
              sidewalks, or downtown-adjacent access and drainage conditions.
            </p>
          </Card>

          <div class="grid gap-4 md:grid-cols-3">
            {
              localContexts.map((item) => (
                <Card class="bg-white">
                  <h3 class="text-base font-semibold text-[var(--color-text)]">
                    {item.title}
                  </h3>
                  <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
                    {item.description}
                  </p>
                </Card>
              ))
            }
          </div>
        </div>
      </div>
    </Section>

    <Section
      eyebrow="Common situations"
      title="Three DeLand quote patterns that do not transfer cleanly to another city"
      description="These are the homeowner situations that justify a dedicated DeLand page instead of recycled service-area copy."
    >
      <div class="grid gap-4 lg:grid-cols-3">
        {
          homeownerScenarios.map((item) => (
            <Card class="bg-white">
              <h3 class="text-lg font-semibold text-[var(--color-text)]">
                {item.title}
              </h3>
              <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
                {item.description}
              </p>
            </Card>
          ))
        }
      </div>
    </Section>

    <SplitFeature
      eyebrow="Available services"
      title="Use the active service pages, then add the DeLand-specific scope notes"
      description="The launch scope stays concrete-focused. What changes in DeLand is the need to call out older entry surfaces, school-link sidewalk context, and downtown-adjacent access before the quote is reviewed."
      columns="content-heavy"
      titleSize="section"
      descriptionSize="lead"
    >
      <div class="grid gap-4">
        <LinkGrid items={serviceLinks} density="comfortable" class="gap-4" />

        <Card tone="soft" class="border-dashed">
          <h3 class="text-base font-semibold text-[var(--color-text)]">
            Keep public and private scope separate
          </h3>
          <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
            A DeLand quote can mention sidewalk-adjacent concrete, but it should
            still identify which surfaces belong to the homeowner request rather
            than implying city sidewalk work or downtown-affiliated cleanup.
          </p>
        </Card>
      </div>
    </SplitFeature>

    <Section
      eyebrow="Quote preparation"
      title="What to send with a DeLand quote for driveways, walks, and entry concrete"
      description="Older-looking slabs, location context, and drainage notes matter here more than generic before-and-after language."
      class="border-y border-[var(--color-border)]"
    >
      <div class="grid gap-6 lg:grid-cols-[minmax(260px,0.56fr)_minmax(0,1fr)]">
        <div
          class="rounded-[var(--radius-lg)] bg-[var(--color-primary)] p-6 text-white"
        >
          <FileText class="h-7 w-7" aria-hidden="true" stroke-width="1.8" />
          <h3 class="mt-4 text-xl font-semibold">
            Older slabs and location context belong in the first message
          </h3>
          <p class="mt-3 text-sm leading-7 text-white/85">
            One wide photo should show the full approach. Close photos should
            show buildup, edges, surface type, and anything that makes the
            concrete look older, coated, narrow, or drainage-sensitive near the
            downtown historic district or connected neighborhood walks.
          </p>
        </div>

        <ul class="grid gap-3 sm:grid-cols-2">
          {
            quoteDetails.map((item) => (
              <li class="rounded-[var(--radius-md)] border border-[var(--color-border)] bg-white p-4 text-sm leading-7 text-[var(--color-text-muted)]">
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </Section>

    <Section
      eyebrow="HOA and specialty surfaces"
      title="Keep HOA notices, older concrete, and specialty-surface disclosures practical"
      description="The page can support HOA-notice cleanup and older-surface review without implying association approval, historic-restoration expertise, or city affiliation."
      tone="warm"
    >
      <div class="grid gap-4 lg:grid-cols-2">
        <Card class="bg-white">
          <div class="flex items-center gap-3">
            <ClipboardCheck
              class="h-6 w-6 text-[var(--color-primary)]"
              aria-hidden="true"
              stroke-width="1.8"
            />
            <h3 class="text-lg font-semibold text-[var(--color-text)]">
              HOA notice support stays document-based
            </h3>
          </div>
          <p class="mt-4 text-sm leading-7 text-[var(--color-text-muted)]">
            Send the exact wording, deadline, named surface, and photos. CFL
            Wash Co. reviews the request without claiming HOA approval,
            preferred-vendor status, or private-rule expertise.
          </p>
        </Card>

        <Card class="bg-white">
          <h3 class="text-lg font-semibold text-[var(--color-text)]">
            Say when the concrete is older, coated, decorative, or mixed
          </h3>
          <p class="mt-4 text-sm leading-7 text-[var(--color-text-muted)]">
            Historic-district-adjacent entries, coated slabs, painted concrete,
            decorative finishes, and mixed-material layouts should all be
            identified early so the scope and expectations stay narrow.
          </p>
        </Card>
      </div>
    </Section>

    <Section
      eyebrow="Nearby active areas"
      title="Use the matching nearby page when the address falls outside DeLand city limits"
      description="DeLand homeowners should use the actual service address or nearest cross streets when the property sits closer to another active West Volusia page."
      tone="soft"
    >
      <LinkGrid items={nearbyAreaLinks} columns="two" class="gap-4" />
    </Section>

    <Section eyebrow="FAQ" title="DeLand pressure washing questions">
      <FAQList faqs={faqs} columns="two" />
    </Section>

    <CTASection
      title="Request a DeLand driveway, walkway, or concrete cleaning quote."
      description="Share the surface type, photos, access notes, drainage details, neighborhood context, and any HOA notice wording so the DeLand request can be reviewed on the right scope."
      titleWidth="wide"
    >
      <Fragment slot="actions">
        <Button
          href="/request-quote"
          variant="secondary"
          class="bg-white text-[var(--color-primary)] hover:bg-[var(--color-surface)]"
          data-cta="quote"
          data-cta-location={`service-area-${area.slug}-final`}
        >
          Request a Quote
        </Button>
        {
          hasPhone ? (
            <Button
              href={site.phoneHref!}
              variant="ghost"
              class="text-white ring-1 ring-inset ring-white/35 hover:bg-white/10"
              data-cta="call"
              data-cta-location={`service-area-${area.slug}-final`}
            >
              <Phone
                slot="startIcon"
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
              Call {site.phoneDisplay}
            </Button>
          ) : (
            <Button
              href={`mailto:${site.email}`}
              variant="ghost"
              class="text-white ring-1 ring-inset ring-white/35 hover:bg-white/10"
              data-cta="email"
              data-cta-location={`service-area-${area.slug}-final`}
            >
              Email CFL Wash Co.
            </Button>
          )
        }
      </Fragment>
    </CTASection>
  </main>
</Layout>
