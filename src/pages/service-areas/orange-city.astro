---
import Button from '../../components/ui/Button.astro'
import BreadcrumbSchema from '../../components/site/BreadcrumbSchema.astro'
import Breadcrumbs from '../../components/site/Breadcrumbs.astro'
import CTASection from '../../components/patterns/CTASection.astro'
import Card from '../../components/ui/Card.astro'
import CityContextMedia from '../../components/patterns/CityContextMedia.astro'
import FAQList from '../../components/patterns/FAQList.astro'
import HeroSection from '../../components/patterns/HeroSection.astro'
import LinkGrid from '../../components/patterns/LinkGrid.astro'
import Section from '../../components/ui/Section.astro'
import Layout from '../../layouts/Layout.astro'
import { cityContextImages } from '../../data/cityContextImages'
import { site } from '../../data/site'
import { serviceAreas } from '../../data/serviceAreas'
import { services } from '../../data/services'
import { ClipboardCheck, FileText, MapPinned, Phone } from '@lucide/astro'

const area = serviceAreas.find((item) => item.slug === 'orange-city')!
const cityContextImage = cityContextImages['orange-city']
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: area.name, href: `/service-areas/${area.slug}` },
]
const nearbyAreas = serviceAreas.filter((item) =>
  ['deltona', 'debary'].includes(item.slug),
)
const hasPhone = Boolean(site.phoneDisplay && site.phoneHref)

const seoTitle =
  'Pressure Washing in Orange City for Driveways and Entry Concrete | CFL Wash Co.'
const seoDescription =
  'Orange City residential pressure washing quotes for driveways, front walks, sidewalk-adjacent concrete, and HOA-notice cleanup with historic-core and drainage-aware scope notes.'

const serviceLinks = services.map((service) => ({
  label: service.name,
  href: `/${service.slug}`,
  description: service.summary,
}))
const nearbyAreaLinks = nearbyAreas.map((nearbyArea) => ({
  label: nearbyArea.name,
  href: `/service-areas/${nearbyArea.slug}`,
}))

const localContexts = [
  {
    title: 'Historic-core frontage can be compact',
    description:
      'Near Graves Avenue and the surrounding historic core, curb appeal can hinge on a shorter driveway approach, front walk, porch-adjacent slab, or curb-edge section instead of a large suburban layout.',
  },
  {
    title: 'Sidewalk scope changes by block',
    description:
      'Orange City supports sidewalk reporting and active core improvements, but the presence of frontage panels and the line between private scope and public concrete still vary by location.',
  },
  {
    title: 'Drainage notes belong in the first message',
    description:
      'The Rhode Island and Graves Avenue basin has documented recurring flooding, so slope, runoff, swales, and low spots are useful quote details when buildup keeps returning.',
  },
]

const homeownerScenarios = [
  {
    title: 'Historic-core frontage cleanup',
    description:
      'A request may center on a short driveway approach, entry walk, curb edge, or porch-adjacent slab where several small concrete sections create the full front-of-home view.',
  },
  {
    title: 'Drainage-sensitive driveway quote',
    description:
      'If runoff crosses the driveway or sediment settles after storms, mention where water collects and whether darker buildup returns in the same low spots.',
  },
  {
    title: 'Sidewalk-plus-entry scope review',
    description:
      'Some homeowners want driveway, front walk, and sidewalk-adjacent concrete reviewed together while keeping the homeowner-controlled scope separate from nearby public frontage.',
  },
]

const quoteDetails = [
  'Surface type: say whether the area is plain concrete or a specialty surface such as sealed, painted, decorative, coated, or paver-adjacent concrete.',
  'Scope: note whether the request covers the driveway, front walk, curb edge, apron, porch-adjacent slab, or sidewalk-adjacent sections.',
  'Photos: send one wide photo that shows layout plus close photos of buildup, edges, stains, and any older discoloration.',
  'Access: include gates, parked vehicles, planters, porch furniture, or narrow side clearance that could affect reach.',
  'Condition notes: mention leaf marks, dark buildup, irrigation staining, tire marks, or sediment left behind after wet weather.',
  'Drainage notes: call out swales, runoff direction, low spots, or stormwater edges if the surface sits near recurring basin flooding.',
]

const faqs = [
  {
    question:
      'Does every Orange City home have public sidewalk panels in front?',
    answer:
      'No. Orange City has a walkable core and public sidewalk reporting, but frontage sidewalks are not universal across the city.',
  },
  {
    question:
      'Why should I mention drainage or low spots in an Orange City quote?',
    answer:
      'The Rhode Island and Graves Avenue basin has documented recurring flooding, so slope and runoff details can help explain why buildup settles or returns.',
  },
  {
    question:
      'Can a short front walk and entry slab still be worth quoting in Orange City?',
    answer:
      'Yes. In the historic core and nearby neighborhoods, compact concrete areas can still define the visible front-of-home appearance.',
  },
  {
    question:
      'Can I ask for driveway and sidewalk-adjacent concrete in one Orange City quote?',
    answer:
      'Yes, as long as the request clearly identifies which sections are part of the homeowner-controlled scope.',
  },
  {
    question:
      'What should I include if an HOA notice names concrete at my Orange City home?',
    answer:
      'Send the exact wording, deadline, named surface, and photos of the cited concrete so the request stays tied to the actual scope.',
  },
  {
    question:
      'What if my Orange City surface is coated, painted, decorative, or older concrete?',
    answer:
      'Include that in the quote request up front so the surface can be reviewed before expectations are set.',
  },
]
---

<Layout
  title={seoTitle}
  description={seoDescription}
  canonicalPath="/service-areas/orange-city"
>
  <BreadcrumbSchema slot="head" items={breadcrumbs} />
  <main>
    <Breadcrumbs items={breadcrumbs} />

    <HeroSection
      variant="split"
      eyebrow="Orange City service area"
      title="Residential pressure washing in Orange City for driveways, front walks, and entry concrete"
      description="CFL Wash Co. serves Orange City homeowners with concrete-focused quotes for driveways, front walks, curb edges, aprons, sidewalk-adjacent sections, and other appropriate residential concrete where historic-core layout and drainage notes can change the scope."
    >
      <Fragment slot="actions">
        <Button
          href="/request-quote"
          data-cta="quote"
          data-cta-location={`service-area-${area.slug}`}
        >
          Request a Quote
        </Button>
        {
          hasPhone ? (
            <Button
              href={site.phoneHref!}
              variant="secondary"
              data-cta="call"
              data-cta-location={`service-area-${area.slug}`}
            >
              <Phone
                slot="startIcon"
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
              Call {site.phoneDisplay}
            </Button>
          ) : (
            <Button
              href={`mailto:${site.email}`}
              variant="secondary"
              data-cta="email"
              data-cta-location={`service-area-${area.slug}`}
            >
              Email CFL Wash Co.
            </Button>
          )
        }
      </Fragment>

      <aside
        slot="aside"
        aria-label="Orange City quote priorities"
        class="rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6"
      >
        <div class="flex items-center gap-3">
          <span
            class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-[var(--color-primary)] text-white"
          >
            <MapPinned class="h-5 w-5" aria-hidden="true" stroke-width="1.8" />
          </span>
          <h2 class="text-lg font-semibold text-[var(--color-text)]">
            Orange City quotes work better with context
          </h2>
        </div>
        <p class="mt-4 text-sm leading-7 text-[var(--color-text-muted)]">
          Mention whether the request sits near Graves Avenue, includes
          sidewalk-adjacent concrete, or needs drainage notes from the Rhode
          Island basin area. Those details help keep the quote city-specific
          without overreaching.
        </p>
      </aside>

      <Fragment slot="media">
        <CityContextMedia
          image={{ ...cityContextImage.image, alt: cityContextImage.alt }}
          caption={cityContextImage.caption}
          attribution={cityContextImage.attribution}
          loading="eager"
          class="max-w-xl justify-self-end"
        />
      </Fragment>
    </HeroSection>

    <Section
      eyebrow="Residential context"
      title="Orange City homeowner requests change shape between the historic core and adjacent neighborhoods"
      description="A useful quote starts with the concrete that is actually visible, then adds drainage, access, and sidewalk-scope notes where the local layout calls for them."
      class="border-t border-[var(--color-border)]"
    >
      <div class="grid gap-4 md:grid-cols-3">
        {
          localContexts.map((item) => (
            <Card class="bg-white">
              <h3 class="text-base font-semibold text-[var(--color-text)]">
                {item.title}
              </h3>
              <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
                {item.description}
              </p>
            </Card>
          ))
        }
      </div>
    </Section>

    <Section
      eyebrow="Services and scenarios"
      title="Orange City situations that should not be handled like a generic city page"
      description="The available services stay the same, but the quote details change when the property sits near the historic core, falls into a drainage-sensitive pocket, or needs private-versus-public scope clarity."
      contentWidth="full"
    >
      <div
        class="grid gap-8 lg:grid-cols-[minmax(0,1.05fr)_minmax(280px,0.8fr)] lg:items-start"
      >
        <div class="grid gap-4">
          {
            homeownerScenarios.map((item) => (
              <Card class="bg-white">
                <h3 class="text-lg font-semibold text-[var(--color-text)]">
                  {item.title}
                </h3>
                <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
                  {item.description}
                </p>
              </Card>
            ))
          }
        </div>

        <div class="grid gap-4">
          <Card tone="soft" class="border-dashed">
            <h3 class="text-base font-semibold text-[var(--color-text)]">
              Active concrete-focused services
            </h3>
            <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
              Choose the closest fit below, or use the quote form to describe
              multiple concrete sections in one Orange City request.
            </p>
          </Card>
          <LinkGrid items={serviceLinks} density="comfortable" />
        </div>
      </div>
    </Section>

    <Section
      eyebrow="Quote preparation"
      title="What to send with an Orange City quote request"
      description="Short, specific notes help separate actual homeowner scope from assumptions about sidewalks, drainage, or specialty surfaces."
      class="border-y border-[var(--color-border)]"
    >
      <div class="grid gap-6 lg:grid-cols-[minmax(260px,0.56fr)_minmax(0,1fr)]">
        <div
          class="rounded-[var(--radius-lg)] bg-[var(--color-primary)] p-6 text-white"
        >
          <FileText class="h-7 w-7" aria-hidden="true" stroke-width="1.8" />
          <h3 class="mt-4 text-xl font-semibold">
            Historic-core and basin notes belong up front
          </h3>
          <p class="mt-3 text-sm leading-7 text-white/85">
            If the property sits near Graves Avenue or in an area affected by
            Rhode Island basin flooding, say so in the first message. That keeps
            the request anchored to real surface layout and visible drainage
            conditions rather than generic curb-appeal wording.
          </p>
        </div>

        <ul class="grid gap-3 sm:grid-cols-2">
          {
            quoteDetails.map((item) => (
              <li class="rounded-[var(--radius-md)] border border-[var(--color-border)] bg-white p-4 text-sm leading-7 text-[var(--color-text-muted)]">
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </Section>

    <Section
      eyebrow="HOA and specialty surfaces"
      title="Keep HOA wording and surface disclosures separate from city claims"
      description="Orange City homeowners can still use one quote request for HOA-notice cleanup support and specialty-surface review without implying association approval or public-right-of-way work."
      tone="warm"
    >
      <div class="grid gap-4 lg:grid-cols-2">
        <Card class="bg-white">
          <div class="flex items-center gap-3">
            <ClipboardCheck
              class="h-6 w-6 text-[var(--color-primary)]"
              aria-hidden="true"
              stroke-width="1.8"
            />
            <h3 class="text-lg font-semibold text-[var(--color-text)]">
              If an HOA notice names the concrete
            </h3>
          </div>
          <p class="mt-4 text-sm leading-7 text-[var(--color-text-muted)]">
            Send the exact notice wording, deadline, named surface, and photos.
            CFL Wash Co. reviews the request; the HOA still sets its own rules
            and deadlines.
          </p>
        </Card>

        <Card class="bg-white">
          <h3 class="text-lg font-semibold text-[var(--color-text)]">
            Tell us when the surface is not standard poured concrete
          </h3>
          <p class="mt-4 text-sm leading-7 text-[var(--color-text-muted)]">
            Coated, painted, decorative, sealed, older, or paver-adjacent
            concrete should be identified before the quote is reviewed so the
            scope and expectations stay narrow.
          </p>
        </Card>
      </div>
    </Section>

    <Section eyebrow="FAQ" title="Orange City pressure washing questions">
      <FAQList faqs={faqs} columns="two" />
    </Section>

    <Section
      eyebrow="Nearby active areas"
      title="If the property falls outside Orange City city limits, use the matching nearby page"
      description="City boundaries matter around West Volusia. Use the actual service address or nearest cross streets when the home sits closer to Deltona or DeBary."
      tone="soft"
    >
      <LinkGrid items={nearbyAreaLinks} columns="two" />
    </Section>

    <CTASection
      title="Request an Orange City driveway, walkway, or concrete cleaning quote."
      description="Share the surface type, photos, drainage notes, access details, and any HOA notice wording so the Orange City request can be reviewed on the right scope."
      titleWidth="wide"
    >
      <Fragment slot="actions">
        <Button
          href="/request-quote"
          variant="secondary"
          class="bg-white text-[var(--color-primary)] hover:bg-[var(--color-surface)]"
          data-cta="quote"
          data-cta-location={`service-area-${area.slug}-final`}
        >
          Request a Quote
        </Button>
        {
          hasPhone ? (
            <Button
              href={site.phoneHref!}
              variant="ghost"
              class="text-white ring-1 ring-inset ring-white/35 hover:bg-white/10"
              data-cta="call"
              data-cta-location={`service-area-${area.slug}-final`}
            >
              <Phone
                slot="startIcon"
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
              Call {site.phoneDisplay}
            </Button>
          ) : (
            <Button
              href={`mailto:${site.email}`}
              variant="ghost"
              class="text-white ring-1 ring-inset ring-white/35 hover:bg-white/10"
              data-cta="email"
              data-cta-location={`service-area-${area.slug}-final`}
            >
              Email CFL Wash Co.
            </Button>
          )
        }
      </Fragment>
    </CTASection>
  </main>
</Layout>
