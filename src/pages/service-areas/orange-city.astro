---
import Button from '../../components/ui/Button.astro'
import CTASection from '../../components/patterns/CTASection.astro'
import Card from '../../components/ui/Card.astro'
import FAQList from '../../components/patterns/FAQList.astro'
import HeroSection from '../../components/patterns/HeroSection.astro'
import LinkGrid from '../../components/patterns/LinkGrid.astro'
import Section from '../../components/ui/Section.astro'
import SplitFeature from '../../components/patterns/SplitFeature.astro'
import Layout from '../../layouts/Layout.astro'
import { site } from '../../data/site'
import { serviceAreas } from '../../data/serviceAreas'
import { services } from '../../data/services'
import { Mail, Phone } from '@lucide/astro'

const area = serviceAreas.find((item) => item.slug === 'orange-city')!
const otherAreas = serviceAreas.filter((item) => item.slug !== area.slug)
const serviceLinks = services.map((service) => ({
  label: service.name,
  href: `/${service.slug}`,
  description: service.summary,
}))
const otherAreaLinks = otherAreas.map((otherArea) => ({
  label: otherArea.name,
  href: `/service-areas/${otherArea.slug}`,
}))
const hasPhone = Boolean(site.phoneDisplay && site.phoneHref)

const seoTitle =
  'Orange City Driveway, Walkway, and Concrete Cleaning | CFL Wash Co.'
const seoDescription =
  'Request a quote for Orange City driveway pressure washing, walkway cleaning, sidewalk cleaning, and appropriate concrete surface cleaning from CFL Wash Co.'

const localContexts = [
  {
    title: 'Entry-focused curb appeal',
    description:
      'Orange City quote requests often make the most sense when the driveway, front walk, porch-adjacent concrete, and entry area are described together.',
  },
  {
    title: 'Small areas still matter',
    description:
      'A short walkway, curb strip, trash-bin pad, or entry slab can stand out when the surrounding concrete is cleaner or more visible.',
  },
  {
    title: 'Scope before scheduling',
    description:
      'A quote-first process helps connect the requested driveway, walkway, sidewalk, curb, or entry-area cleaning to the right concrete-focused scope.',
  },
]

const quoteNotes = [
  'List each concrete area you want reviewed instead of using a general exterior-cleaning request.',
  'Mention gates, parked vehicles, porch furniture, planters, drainage concerns, or door-adjacent areas.',
  'If the work is connected to an HOA notice, include the wording and which concrete surface is named.',
]

const faqs = [
  {
    question: 'What concrete cleaning can I request in Orange City?',
    answer:
      'You can request a quote for driveway pressure washing, sidewalk and walkway cleaning, and other appropriate concrete cleaning such as entry slabs, curbs, pads, and aprons.',
  },
  {
    question: 'How specific should my Orange City quote request be?',
    answer:
      'List each concrete surface you want reviewed, mention access or drainage concerns, and note any staining or HOA notice details that matter.',
  },
  {
    question: 'Can I include several small concrete areas in one quote?',
    answer:
      'Yes. Describe each area in the quote request so CFL Wash Co. can review the full concrete-focused scope.',
  },
]
---

<Layout
  title={seoTitle}
  description={seoDescription}
  canonicalPath="/service-areas/orange-city"
>
  <main>
    <HeroSection
      eyebrow="Service Area"
      title="Orange City driveway, walkway, sidewalk, and concrete cleaning"
      description="CFL Wash Co. provides Orange City homeowners with a concrete-focused quote path for driveways, walkways, sidewalks, entry slabs, curbs, and other appropriate hard surfaces that affect curb appeal."
    >
      <Fragment slot="actions">
        <Button
          href="/request-quote"
          data-cta="quote"
          data-cta-location={`service-area-${area.slug}`}
        >
          Request a Quote
        </Button>
        <Button
          href={`mailto:${site.email}`}
          variant="secondary"
          data-cta="email"
          data-cta-location={`service-area-${area.slug}`}
        >
          Email CFL Wash Co.
        </Button>
      </Fragment>
    </HeroSection>

    <Section
      eyebrow="Residential context"
      title="Concrete touchpoints around Orange City homes"
      description="This page is for homeowners who want practical cleanup help for the visible hard surfaces around the property."
      class="border-t border-[var(--color-border)]"
    >
      <div class="grid gap-4 md:grid-cols-3">
        {
          localContexts.map((item) => (
            <Card class="bg-white">
              <h3 class="text-base font-semibold text-[var(--color-text)]">
                {item.title}
              </h3>
              <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
                {item.description}
              </p>
            </Card>
          ))
        }
      </div>
    </Section>

    <SplitFeature
      eyebrow="Available services"
      title="Orange City launch services"
      description="Each service page explains a different concrete-focused request. Choose the closest fit, or describe multiple surfaces on the quote form."
    >
      <LinkGrid items={serviceLinks} class="gap-4" />
    </SplitFeature>

    <Section
      eyebrow="Quote guidance"
      title="What to include in an Orange City concrete cleaning request"
      description="The best quote request is specific about the surface, condition, and access instead of asking for broad exterior cleaning."
    >
      <ul class="grid gap-3 md:grid-cols-3">
        {
          quoteNotes.map((item) => (
            <li class="rounded-[var(--radius-md)] border border-[var(--color-border)] bg-white p-4 text-sm leading-7 text-[var(--color-text-muted)]">
              {item}
            </li>
          ))
        }
      </ul>
    </Section>

    <Section
      eyebrow="Nearby active areas"
      title="Other active service-area pages"
      description="Review nearby active pages if the property is outside Orange City or the request covers another Central Florida area."
      class="border-y border-[var(--color-border)] bg-[var(--color-surface)]"
    >
      <LinkGrid items={otherAreaLinks} columns="two" />
    </Section>

    <Section eyebrow="FAQ" title="Orange City service-area questions">
      <FAQList faqs={faqs} />
    </Section>

    <CTASection
      title="Request an Orange City concrete cleaning quote."
      description="Share the Orange City surface details and whether the request is for a driveway, walkway, sidewalk, entry area, or other concrete surface."
    >
      <Fragment slot="actions">
        <Button
          href="/request-quote"
          variant="secondary"
          class="bg-white text-[var(--color-primary)] hover:bg-[var(--color-surface)]"
          data-cta="quote"
          data-cta-location={`service-area-${area.slug}-final`}
        >
          Request a Quote
        </Button>
        {
          hasPhone ? (
            <Button
              href={site.phoneHref!}
              variant="ghost"
              class="text-white ring-1 ring-inset ring-white/35 hover:bg-white/10"
              data-cta="call"
              data-cta-location={`service-area-${area.slug}-final`}
            >
              <Phone
                slot="startIcon"
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
              Call {site.phoneDisplay}
            </Button>
          ) : (
            <Button
              href={`mailto:${site.email}`}
              variant="ghost"
              class="text-white ring-1 ring-inset ring-white/35 hover:bg-white/10"
              data-cta="email"
              data-cta-location={`service-area-${area.slug}-final`}
            >
              <Mail
                slot="startIcon"
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
              Email CFL Wash Co.
            </Button>
          )
        }
      </Fragment>
    </CTASection>
  </main>
</Layout>
