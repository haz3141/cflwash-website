---
import Button from '../../components/ui/Button.astro'
import CTASection from '../../components/patterns/CTASection.astro'
import Card from '../../components/ui/Card.astro'
import FAQList from '../../components/patterns/FAQList.astro'
import HeroSection from '../../components/patterns/HeroSection.astro'
import LinkGrid from '../../components/patterns/LinkGrid.astro'
import Section from '../../components/ui/Section.astro'
import Layout from '../../layouts/Layout.astro'
import { site } from '../../data/site'
import { serviceAreas } from '../../data/serviceAreas'
import { services } from '../../data/services'
import { ClipboardCheck, FileText, MapPinned, Phone } from '@lucide/astro'

const area = serviceAreas.find((item) => item.slug === 'deltona')!
const nearbyAreas = serviceAreas.filter((item) =>
  ['orange-city', 'debary'].includes(item.slug),
)
const hasPhone = Boolean(site.phoneDisplay && site.phoneHref)

const seoTitle =
  'Pressure Washing in Deltona for Driveways and Concrete | CFL Wash Co.'
const seoDescription =
  'Deltona residential pressure washing quotes for driveways, sidewalks, walkways, curbs, aprons, entry concrete, and HOA-notice cleanup support.'

const serviceLinks = services.map((service) => ({
  label: service.name,
  href: `/${service.slug}`,
  description: service.summary,
}))
const nearbyAreaLinks = nearbyAreas.map((nearbyArea) => ({
  label: nearbyArea.name,
  href: `/service-areas/${nearbyArea.slug}`,
}))

const deltonaContexts = [
  {
    title: 'Driveway-first layouts',
    description:
      'Many Deltona homes present the driveway, apron, and front walk as the main visible concrete. Include the surfaces that matter from the street or front entry.',
  },
  {
    title: 'Sidewalk coverage varies',
    description:
      'Some streets have sidewalk panels at the frontage and others do not. Tell us exactly which concrete areas are present so the review starts on the right scope.',
  },
  {
    title: 'Drainage still matters',
    description:
      'Swales, slopes, low spots, and nearby drains can affect how a concrete cleaning request is reviewed and what details belong in the quote.',
  },
]

const homeownerScenarios = [
  {
    title: 'HOA notice names a concrete surface',
    description:
      'Share the wording, deadline, and the named surface if the notice points to driveway, sidewalk, curb, or entry concrete.',
  },
  {
    title: 'Driveway and front walk need to match',
    description:
      'If the driveway, apron, and entry walk read as one front-of-home view, describe them together so the request reflects the connected area.',
  },
  {
    title: 'Sidewalk panels are part of the request',
    description:
      'If your frontage includes sidewalk panels, note how many you want reviewed and anything that blocks access.',
  },
  {
    title: 'Move-in or curb-appeal cleanup',
    description:
      'For sale prep or a fresh start, include photos from the street and closeups of visible buildup, stains, and edges.',
  },
]

const quoteDetails = [
  'Surface type: tell us whether the area is plain concrete or a non-standard surface such as paver, sealed, painted, decorative, or exposed aggregate.',
  'Approximate scope: driveway only, driveway plus front walk, sidewalk panels, curb, apron, entry, pad, or patio slab.',
  'Photos: one wide photo for layout and close photos for staining, buildup, edges, and any surface condition that stands out.',
  'Access: gates, locked areas, vehicles, trailers, planters, trash bins, furniture, or tight side yards.',
  'Condition: oil, rust or irrigation marks, leaf staining, tire marks, dark buildup, worn concrete, cracks, or prior coatings.',
  'Water movement: slope, swale, drainage, low spots, door thresholds, nearby storm drains, or runoff concerns.',
  'Notice details: wording, deadline, and the named surface if an HOA notice is involved.',
]

const faqs = [
  {
    question: 'Do all Deltona homes have sidewalk panels to clean?',
    answer:
      'No. Sidewalk coverage varies by street. Include only the surfaces present at your home.',
  },
  {
    question:
      'Can I request driveway pressure washing and walkway cleaning together?',
    answer:
      'Yes. If the driveway, apron, and front walk are all part of the request, send them together so the scope is clear.',
  },
  {
    question: 'Can CFL Wash Co. help with a Deltona HOA notice?',
    answer:
      'Yes. Send the wording and deadline, and mention the driveway, sidewalk, curb, or entry concrete named in the notice.',
  },
  {
    question: 'What if my driveway is paver, sealed, painted, or decorative?',
    answer:
      'Include the surface type and photos. Pavers, sealed, painted, decorative, exposed aggregate, and previously coated surfaces are reviewed separately from plain poured concrete.',
  },
  {
    question: 'Is power washing the same request as pressure washing here?',
    answer:
      'Homeowners often use both terms. The request still comes down to the concrete surfaces you want cleaned.',
  },
  {
    question: 'What if the property is near Orange City or DeBary?',
    answer:
      'Use the actual service address or nearest cross streets so the request lands on the right city page.',
  },
]
---

<Layout
  title={seoTitle}
  description={seoDescription}
  canonicalPath="/service-areas/deltona"
>
  <main>
    <HeroSection
      eyebrow="Deltona service area"
      title="Residential pressure washing in Deltona for driveways, sidewalks, walkways, and concrete"
      description="CFL Wash Co. serves Deltona homeowners with concrete cleaning for the surfaces that shape curb appeal: driveways, sidewalk panels, front walks, curbs, aprons, entry areas, and other appropriate residential concrete."
    >
      <Fragment slot="actions">
        <Button
          href="/request-quote"
          data-cta="quote"
          data-cta-location={`service-area-${area.slug}`}
        >
          Request a Quote
        </Button>
        {
          hasPhone ? (
            <Button
              href={site.phoneHref!}
              variant="secondary"
              data-cta="call"
              data-cta-location={`service-area-${area.slug}`}
            >
              <Phone
                slot="startIcon"
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
              Call {site.phoneDisplay}
            </Button>
          ) : (
            <Button
              href={`mailto:${site.email}`}
              variant="secondary"
              data-cta="email"
              data-cta-location={`service-area-${area.slug}`}
            >
              Email CFL Wash Co.
            </Button>
          )
        }
      </Fragment>

      <aside
        slot="aside"
        aria-label="Deltona quote priorities"
        class="rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6"
      >
        <div class="flex items-center gap-3">
          <span
            class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-[var(--color-primary)] text-white"
          >
            <MapPinned class="h-5 w-5" aria-hidden="true" stroke-width="1.8" />
          </span>
          <h2 class="text-lg font-semibold text-[var(--color-text)]">
            Start with the concrete that is actually visible
          </h2>
        </div>
        <p class="mt-4 text-sm leading-7 text-[var(--color-text-muted)]">
          Send the surfaces you can see from the street or front entry, plus
          photos and any notice wording. That gives the review the right layout
          from the start.
        </p>
      </aside>
    </HeroSection>

    <Section
      eyebrow="Residential context"
      title="Deltona homes often present different front-of-home concrete layouts"
      description="Some properties have sidewalk panels, others do not. Drainage, swales, and the way the driveway meets the front walk can change what needs to be included in the quote."
      class="border-t border-[var(--color-border)]"
    >
      <div class="grid gap-4 md:grid-cols-3">
        {
          deltonaContexts.map((item) => (
            <Card class="bg-white">
              <h3 class="text-base font-semibold text-[var(--color-text)]">
                {item.title}
              </h3>
              <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
                {item.description}
              </p>
            </Card>
          ))
        }
      </div>
    </Section>

    <section>
      <div
        class="mx-auto w-full max-w-[var(--container-width)] px-6 py-[var(--section-space)] sm:px-10"
      >
        <div
          class="grid gap-8 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:items-start"
        >
          <div>
            <p class="text-eyebrow text-[var(--color-action)]">
              Services and situations
            </p>
            <h2 class="mt-3 text-section-title text-[var(--color-text)]">
              Available services and common Deltona quote requests
            </h2>
            <p
              class="mt-3 text-sm leading-7 text-[var(--color-text-muted)] sm:text-base"
            >
              Use the service links below for the available concrete-focused
              services, then describe how the surfaces are laid out at your
              property.
            </p>
            <LinkGrid
              items={serviceLinks}
              density="comfortable"
              class="mt-6 gap-4"
            />
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            {
              homeownerScenarios.map((item) => (
                <Card class="bg-white">
                  <h3 class="text-base font-semibold text-[var(--color-text)]">
                    {item.title}
                  </h3>
                  <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
                    {item.description}
                  </p>
                </Card>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <Section
      eyebrow="HOA notice guidance"
      title="When a notice names driveway, sidewalk, curb, or entry concrete"
      description="Send the wording and deadline. CFL Wash Co. reviews the named concrete scope, and you provide the notice requirements."
      tone="warm"
    >
      <Card class="bg-white">
        <div class="flex items-center gap-3">
          <ClipboardCheck
            class="h-6 w-6 text-[var(--color-primary)]"
            aria-hidden="true"
            stroke-width="1.8"
          />
          <h3 class="text-lg font-semibold text-[var(--color-text)]">
            What to include
          </h3>
        </div>
        <p class="mt-4 text-sm leading-7 text-[var(--color-text-muted)]">
          Share the wording, due date, named surface, and any photos or
          attachments. That keeps the review focused on the concrete that needs
          attention.
        </p>
      </Card>
    </Section>

    <Section
      eyebrow="Quote preparation"
      title="What to send with a Deltona concrete cleaning request"
      description="Short, specific details help confirm whether the surface fits the available scope and let CFL Wash Co. review the right layout."
      class="border-y border-[var(--color-border)]"
    >
      <div class="grid gap-6 lg:grid-cols-[minmax(260px,0.55fr)_minmax(0,1fr)]">
        <div
          class="rounded-[var(--radius-lg)] bg-[var(--color-primary)] p-6 text-white"
        >
          <FileText class="h-7 w-7" aria-hidden="true" stroke-width="1.8" />
          <h3 class="mt-4 text-xl font-semibold">Photos matter most</h3>
          <p class="mt-3 text-sm leading-7 text-white/85">
            One wide photo shows the layout. Close photos show staining,
            buildup, edges, drainage, and surface type. If the surface is paver,
            sealed, painted, decorative, or exposed aggregate, include that in
            the photo set so it can be reviewed correctly.
          </p>
        </div>

        <ul class="grid gap-3 sm:grid-cols-2">
          {
            quoteDetails.map((item) => (
              <li class="rounded-[var(--radius-md)] border border-[var(--color-border)] bg-white p-4 text-sm leading-7 text-[var(--color-text-muted)]">
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </Section>

    <Section eyebrow="FAQ" title="Deltona pressure washing questions">
      <FAQList faqs={faqs} columns="two" />
    </Section>

    <Section
      eyebrow="Nearby active areas"
      title="If the property is closer to another current service area, use the matching page"
      description="Use the actual service address or nearest cross streets when the home sits near a city boundary."
      tone="soft"
    >
      <div
        class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(280px,0.55fr)] lg:items-start"
      >
        <div class="prose prose-sm max-w-none text-[var(--color-text-muted)]">
          <p class="leading-7">
            Deltona sits near other West Volusia service areas. If the address
            is closer to Orange City or DeBary, use the matching page so the
            request lands in the right place.
          </p>
        </div>

        <LinkGrid items={nearbyAreaLinks} />
      </div>
    </Section>

    <CTASection
      title="Request a Deltona driveway, sidewalk, or concrete cleaning quote."
      description="Share the surface type, photos, access details, staining, drainage, prior coatings, and any HOA notice wording so CFL Wash Co. can review the scope."
      titleWidth="wide"
    >
      <Fragment slot="actions">
        <Button
          href="/request-quote"
          variant="secondary"
          class="bg-white text-[var(--color-primary)] hover:bg-[var(--color-surface)]"
          data-cta="quote"
          data-cta-location={`service-area-${area.slug}-final`}
        >
          Request a Quote
        </Button>
        {
          hasPhone ? (
            <Button
              href={site.phoneHref!}
              variant="ghost"
              class="text-white ring-1 ring-inset ring-white/35 hover:bg-white/10"
              data-cta="call"
              data-cta-location={`service-area-${area.slug}-final`}
            >
              <Phone
                slot="startIcon"
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
              Call {site.phoneDisplay}
            </Button>
          ) : (
            <Button
              href={`mailto:${site.email}`}
              variant="ghost"
              class="text-white ring-1 ring-inset ring-white/35 hover:bg-white/10"
              data-cta="email"
              data-cta-location={`service-area-${area.slug}-final`}
            >
              Email CFL Wash Co.
            </Button>
          )
        }
      </Fragment>
    </CTASection>
  </main>
</Layout>
