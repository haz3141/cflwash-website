---
import Button from '../../components/ui/Button.astro'
import Card from '../../components/ui/Card.astro'
import Section from '../../components/ui/Section.astro'
import Layout from '../../layouts/Layout.astro'
import { site } from '../../data/site'
import { serviceAreas } from '../../data/serviceAreas'
import { services } from '../../data/services'
import {
  ClipboardCheck,
  Droplets,
  FileText,
  MapPinned,
  Phone,
  ShieldQuestion,
} from '@lucide/astro'

const area = serviceAreas.find((item) => item.slug === 'deltona')!
const nearbyAreas = serviceAreas.filter((item) =>
  ['orange-city', 'debary'].includes(item.slug),
)
const hasPhone = Boolean(site.phoneDisplay && site.phoneHref)

const seoTitle =
  'Pressure Washing in Deltona for Driveways and Concrete | CFL Wash Co.'
const seoDescription =
  'Deltona residential pressure washing quotes for driveways, sidewalks, walkways, curbs, aprons, entry concrete, and HOA-notice cleanup support.'

const serviceLinks = services.map((service) => ({
  ...service,
  href: `/${service.slug}`,
}))

const deltonaContexts = [
  {
    title: 'Driveway-first lot layouts',
    description:
      'Deltona grew from a large planned-lot residential pattern, so many quote requests start with the driveway, apron, front walk, and the concrete seen from the street.',
  },
  {
    title: 'Sidewalks vary by street',
    description:
      'Some homes have public sidewalk panels near the frontage while others mainly have a driveway and entry walk. Tell us which surfaces are actually present.',
  },
  {
    title: 'Drainage details matter',
    description:
      'Swales, slopes, low spots, door-adjacent concrete, and nearby storm drains can change how a concrete cleaning quote should be reviewed.',
  },
]

const homeownerScenarios = [
  {
    title: 'HOA notice names a concrete surface',
    description:
      'Share the notice wording, deadline, and whether it names the driveway, sidewalk, curb, entry path, or another visible concrete area.',
  },
  {
    title: 'Driveway and front walk need to match',
    description:
      'If the driveway, apron, and entry walk read as one front-of-home view, describe them together so the quote can cover the connected scope.',
  },
  {
    title: 'Sidewalk panels are part of the request',
    description:
      'If your Deltona frontage includes sidewalk panels, note the number of panels, nearby curb areas, and whether vehicles or bins block access.',
  },
  {
    title: 'Listing, move-in, or curb-appeal cleanup',
    description:
      'For sale preparation or new-owner cleanup, include photos from the street and closeups of visible buildup, stains, and edges.',
  },
]

const quoteDetails = [
  'Surface type: poured concrete, pavers, exposed aggregate, painted, sealed, decorative, or previously coated.',
  'Approximate scope: driveway only, driveway plus front walk, sidewalk panels, curb, apron, entry, pad, or patio slab.',
  'Photos: one wide photo for context and closer photos of staining, buildup, edges, and any non-standard surface.',
  'Access: gates, locked areas, vehicles, trailers, planters, trash bins, furniture, or tight side yards.',
  'Condition: oil, rust or irrigation marks, leaf staining, tire marks, dark buildup, worn concrete, cracks, or prior coatings.',
  'Water movement: slope, swale, drainage, low spots, door thresholds, nearby storm drains, or runoff concerns.',
  'Notice details: HOA wording, deadline, named surface, and whether photos or reinspection are required.',
]

const faqs = [
  {
    question: 'Do all Deltona homes have sidewalk panels to clean?',
    answer:
      'No. Sidewalk availability can vary by street and side of street. If your home has sidewalk panels, include them in the quote request; if not, focus on the driveway, apron, front walk, entry concrete, or other surfaces present.',
  },
  {
    question:
      'Can I request driveway pressure washing and walkway cleaning together?',
    answer:
      'Yes. A Deltona quote can include connected concrete surfaces such as the driveway, apron, front walk, sidewalk panels, curb, and entry area when they fit the current launch scope.',
  },
  {
    question: 'Can CFL Wash Co. help with a Deltona HOA notice?',
    answer:
      'CFL Wash Co. can review concrete-focused HOA notice cleanup requests when the notice involves driveways, sidewalks, walkways, curbs, or entry concrete. This does not imply HOA affiliation, approval, or knowledge of private rules.',
  },
  {
    question: 'What if my driveway is paver, sealed, painted, or decorative?',
    answer:
      'Not every driveway is plain poured concrete. Include the surface type and photos so CFL Wash Co. can confirm whether the area fits the current service scope before quoting.',
  },
  {
    question: 'Is power washing the same request as pressure washing here?',
    answer:
      'Homeowners often use both terms. For this Deltona page, the active scope is residential pressure washing for appropriate driveway, sidewalk, walkway, and concrete surfaces.',
  },
  {
    question:
      'What if the property is near Orange City, DeBary, Enterprise, or Osteen?',
    answer:
      'Use the quote request to provide the service address or nearest cross streets. Nearby names and mailing addresses can be useful context, but the actual property location is what determines the service-area review.',
  },
]
---

<Layout
  title={seoTitle}
  description={seoDescription}
  canonicalPath="/service-areas/deltona"
>
  <main>
    <Section spacing="none" class="py-16 sm:py-20">
      <div
        class="grid gap-10 lg:grid-cols-[minmax(0,1.05fr)_minmax(320px,0.7fr)] lg:items-end"
      >
        <div>
          <p
            class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-primary)]"
          >
            Deltona service area
          </p>
          <h1
            class="mt-4 max-w-4xl text-4xl font-semibold leading-tight text-[var(--color-text)] sm:text-5xl"
          >
            Residential pressure washing in Deltona for driveways, sidewalks,
            walkways, and concrete
          </h1>
          <p
            class="mt-5 max-w-3xl text-base leading-8 text-[var(--color-text-muted)] sm:text-lg"
          >
            CFL Wash Co. serves Deltona homeowners with quote-first concrete
            cleaning for the surfaces that shape curb appeal: driveways,
            sidewalk panels, front walks, curbs, aprons, entry areas, and other
            appropriate residential concrete.
          </p>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <Button
              href="/request-quote"
              data-cta="quote"
              data-cta-location={`service-area-${area.slug}`}
            >
              Request a Quote
            </Button>
            {
              hasPhone ? (
                <Button
                  href={site.phoneHref!}
                  variant="secondary"
                  data-cta="call"
                  data-cta-location={`service-area-${area.slug}`}
                >
                  <Phone
                    slot="startIcon"
                    class="h-5 w-5"
                    aria-hidden="true"
                    stroke-width="1.8"
                  />
                  Call {site.phoneDisplay}
                </Button>
              ) : (
                <Button
                  href={`mailto:${site.email}`}
                  variant="secondary"
                  data-cta="email"
                  data-cta-location={`service-area-${area.slug}`}
                >
                  Email CFL Wash Co.
                </Button>
              )
            }
          </div>
        </div>

        <aside
          aria-label="Deltona quote priorities"
          class="rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6"
        >
          <div class="flex items-center gap-3">
            <span
              class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-[var(--color-primary)] text-white"
            >
              <MapPinned
                class="h-5 w-5"
                aria-hidden="true"
                stroke-width="1.8"
              />
            </span>
            <h2 class="text-lg font-semibold text-[var(--color-text)]">
              Best fit for Deltona requests
            </h2>
          </div>
          <p class="mt-4 text-sm leading-7 text-[var(--color-text-muted)]">
            Start with the concrete you can identify from the street or entry:
            driveway, apron, front walk, sidewalk panels, curb, and entry area.
            Add photos and any notice wording so the quote review starts with
            the actual surface, not a generic exterior-cleaning package.
          </p>
        </aside>
      </div>
    </Section>

    <Section
      eyebrow="Residential context"
      title="Deltona concrete cleaning starts with the surface layout"
      description="The home-market page is intentionally more specific than a swapped city page: it accounts for Deltona's residential lot pattern, variable sidewalk coverage, and drainage details homeowners should mention."
      class="border-t border-[var(--color-border)]"
    >
      <div class="grid gap-4 md:grid-cols-3">
        {
          deltonaContexts.map((item) => (
            <Card class="bg-white">
              <h3 class="text-base font-semibold text-[var(--color-text)]">
                {item.title}
              </h3>
              <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
                {item.description}
              </p>
            </Card>
          ))
        }
      </div>
    </Section>

    <section class="bg-[var(--color-surface)]">
      <div
        class="mx-auto grid w-full max-w-[var(--container-width)] gap-10 px-6 py-[var(--section-spacing)] lg:grid-cols-[minmax(0,0.82fr)_minmax(0,1.18fr)]"
      >
        <div>
          <p
            class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-primary)]"
          >
            Homeowner scenarios
          </p>
          <h2
            class="mt-3 text-2xl font-semibold text-[var(--color-text)] sm:text-3xl"
          >
            Useful Deltona requests are specific before they are large
          </h2>
          <p
            class="mt-4 text-sm leading-7 text-[var(--color-text-muted)] sm:text-base"
          >
            A strong quote request explains why the concrete matters: an HOA
            notice, a driveway and front-walk bundle, sidewalk panels along the
            frontage, or curb appeal before listing or moving in.
          </p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          {
            homeownerScenarios.map((item) => (
              <article class="border-l-4 border-[var(--color-primary)] bg-white p-5">
                <h3 class="text-base font-semibold text-[var(--color-text)]">
                  {item.title}
                </h3>
                <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
                  {item.description}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <Section
      eyebrow="Available services"
      title="Concrete-focused launch services in Deltona"
      description="CFL Wash Co. is not presenting a broad exterior-cleaning menu on this page. These are the active service pages for Deltona quote requests."
    >
      <div class="grid gap-4 lg:grid-cols-3">
        {
          serviceLinks.map((service) => (
            <a
              href={service.href}
              class="group rounded-[var(--radius-md)] border border-[var(--color-border)] bg-white p-5 transition-colors hover:border-[var(--color-primary)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring)] focus-visible:ring-offset-2"
            >
              <span class="block text-base font-semibold text-[var(--color-text)] group-hover:text-[var(--color-primary)]">
                {service.name}
              </span>
              <span class="mt-3 block text-sm leading-7 text-[var(--color-text-muted)]">
                {service.summary}
              </span>
            </a>
          ))
        }
      </div>
    </Section>

    <Section
      eyebrow="HOA notice support"
      title="When the notice points to driveway, sidewalk, curb, or entry concrete"
      description="CFL Wash Co. can review concrete-focused cleanup requests, but the homeowner remains the source for notice wording, deadlines, and private community requirements."
      tone="warm"
    >
      <div
        class="grid gap-6 lg:grid-cols-[minmax(0,0.72fr)_minmax(0,1fr)] lg:items-start"
      >
        <Card class="bg-white">
          <div class="flex items-center gap-3">
            <ClipboardCheck
              class="h-6 w-6 text-[var(--color-primary)]"
              aria-hidden="true"
              stroke-width="1.8"
            />
            <h3 class="text-lg font-semibold text-[var(--color-text)]">
              Include the notice details
            </h3>
          </div>
          <p class="mt-4 text-sm leading-7 text-[var(--color-text-muted)]">
            Send the wording, due date, named surface, and any photos the notice
            includes. That keeps the quote focused on the visible concrete issue
            without implying CFL Wash Co. knows or approves private HOA rules.
          </p>
        </Card>

        <div class="grid gap-3">
          <div class="rounded-[var(--radius-md)] bg-white p-4">
            <h3 class="text-sm font-semibold text-[var(--color-text)]">
              Good fit to ask about
            </h3>
            <p class="mt-2 text-sm leading-7 text-[var(--color-text-muted)]">
              Driveways, front walks, sidewalk panels, curbs, aprons, entry
              paths, and similar appropriate concrete surfaces.
            </p>
          </div>
          <div class="rounded-[var(--radius-md)] bg-white p-4">
            <h3 class="text-sm font-semibold text-[var(--color-text)]">
              Keep separate for review
            </h3>
            <p class="mt-2 text-sm leading-7 text-[var(--color-text-muted)]">
              Pavers, sealed surfaces, painted concrete, decorative finishes,
              exposed aggregate, and previously coated surfaces may require a
              different approach.
            </p>
          </div>
        </div>
      </div>
    </Section>

    <Section
      eyebrow="Quote preparation"
      title="What to send with a Deltona concrete cleaning request"
      description="Clear details help avoid overpromising and give CFL Wash Co. enough context to confirm whether the surface fits the current scope."
      class="border-y border-[var(--color-border)]"
    >
      <div class="grid gap-6 lg:grid-cols-[minmax(260px,0.55fr)_minmax(0,1fr)]">
        <div
          class="rounded-[var(--radius-lg)] bg-[var(--color-primary)] p-6 text-white"
        >
          <FileText class="h-7 w-7" aria-hidden="true" stroke-width="1.8" />
          <h3 class="mt-4 text-xl font-semibold">Photos matter most</h3>
          <p class="mt-3 text-sm leading-7 text-white/85">
            One wide photo shows the layout. Close photos show staining,
            coatings, edges, drainage, and surface type. Together, they make the
            quote request more useful than a short message that says "driveway
            cleaning."
          </p>
        </div>

        <ul class="grid gap-3 sm:grid-cols-2">
          {
            quoteDetails.map((item) => (
              <li class="rounded-[var(--radius-md)] border border-[var(--color-border)] bg-white p-4 text-sm leading-7 text-[var(--color-text-muted)]">
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </Section>

    <Section
      eyebrow="Non-standard surfaces"
      title="Pavers, coated concrete, and decorative finishes need confirmation"
      description="The current Deltona launch page stays centered on appropriate concrete cleaning and quote review."
    >
      <div
        class="grid gap-5 rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-white p-6 lg:grid-cols-[auto_minmax(0,1fr)]"
      >
        <ShieldQuestion
          class="h-8 w-8 text-[var(--color-primary)]"
          aria-hidden="true"
          stroke-width="1.8"
        />
        <p
          class="text-sm leading-7 text-[var(--color-text-muted)] sm:text-base"
        >
          Not every driveway is plain poured concrete. Pavers, sealed surfaces,
          painted concrete, decorative finishes, exposed aggregate, and
          previously coated surfaces may require a different approach. Include
          the surface type and photos with the quote request so CFL Wash Co. can
          confirm whether the area fits the current service scope.
        </p>
      </div>
    </Section>

    <Section
      eyebrow="Boundary notes"
      title="Near Deltona's edges, send the actual service address"
      description="Nearby names can be useful, but the quote review should start with where the work is and which surfaces need attention."
      tone="soft"
    >
      <div
        class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(280px,0.55fr)] lg:items-start"
      >
        <div class="prose prose-sm max-w-none text-[var(--color-text-muted)]">
          <p class="leading-7">
            Deltona sits near other West Volusia communities and municipalities,
            including Orange City and DeBary. If a property is near a boundary,
            or if nearby names such as Enterprise or Osteen appear in the
            address context, include the full service address or nearest cross
            streets in the quote request.
          </p>
          <p class="mt-4 leading-7">
            The goal is practical coverage review, not a giant city list. For
            active nearby pages, use the links here when the property is outside
            Deltona or the request belongs to another current service-area page.
          </p>
        </div>

        <div class="grid gap-3">
          {
            nearbyAreas.map((nearbyArea) => (
              <a
                href={`/service-areas/${nearbyArea.slug}`}
                class="rounded-[var(--radius-md)] border border-[var(--color-border)] bg-white p-4 text-sm font-semibold text-[var(--color-text)] transition-colors hover:border-[var(--color-primary)] hover:text-[var(--color-primary)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-focus-ring)] focus-visible:ring-offset-2"
              >
                {nearbyArea.name}
              </a>
            ))
          }
        </div>
      </div>
    </Section>

    <Section
      eyebrow="Project proof"
      title="Deltona project proof will be added only after real work is publishable"
      description="This page reserves room for local proof without inventing completed jobs, photos, reviews, or customer outcomes."
    >
      <div
        class="grid gap-5 rounded-[var(--radius-lg)] border border-dashed border-[var(--color-border)] bg-[var(--color-surface)] p-6 sm:grid-cols-[auto_minmax(0,1fr)]"
      >
        <Droplets
          class="h-8 w-8 text-[var(--color-primary)]"
          aria-hidden="true"
          stroke-width="1.8"
        />
        <div>
          <h3 class="text-lg font-semibold text-[var(--color-text)]">
            Future Deltona project examples
          </h3>
          <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
            Before-and-after photos, project notes, and customer-derived
            examples can be added after CFL Wash Co. has real Deltona work,
            permission to publish, and enough detail to describe the surface
            honestly.
          </p>
        </div>
      </div>
    </Section>

    <Section eyebrow="FAQ" title="Deltona pressure washing questions">
      <div class="grid gap-4 md:grid-cols-2">
        {
          faqs.map((faq) => (
            <Card class="bg-white">
              <h3 class="text-base font-semibold text-[var(--color-text)]">
                {faq.question}
              </h3>
              <p class="mt-3 text-sm leading-7 text-[var(--color-text-muted)]">
                {faq.answer}
              </p>
            </Card>
          ))
        }
      </div>
    </Section>

    <section class="px-6 py-[var(--section-spacing)]">
      <div
        class="mx-auto max-w-[var(--container-width)] rounded-[var(--radius-lg)] bg-[var(--color-primary)] px-6 py-12 text-center text-white sm:px-10"
      >
        <h2 class="mx-auto max-w-3xl text-3xl font-semibold sm:text-4xl">
          Request a Deltona driveway, sidewalk, or concrete cleaning quote.
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-base leading-8 text-white/85">
          Share the surface type, photos, access details, staining, drainage,
          prior coatings, and any HOA notice wording so CFL Wash Co. can review
          the scope.
        </p>
        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
          <Button
            href="/request-quote"
            variant="secondary"
            class="bg-white text-[var(--color-primary)] hover:bg-[var(--color-surface)]"
            data-cta="quote"
            data-cta-location={`service-area-${area.slug}-final`}
          >
            Request a Quote
          </Button>
          {
            hasPhone ? (
              <Button
                href={site.phoneHref!}
                variant="ghost"
                class="text-white ring-1 ring-inset ring-white/35 hover:bg-white/10"
                data-cta="call"
                data-cta-location={`service-area-${area.slug}-final`}
              >
                <Phone
                  slot="startIcon"
                  class="h-5 w-5"
                  aria-hidden="true"
                  stroke-width="1.8"
                />
                Call {site.phoneDisplay}
              </Button>
            ) : (
              <Button
                href={`mailto:${site.email}`}
                variant="ghost"
                class="text-white ring-1 ring-inset ring-white/35 hover:bg-white/10"
                data-cta="email"
                data-cta-location={`service-area-${area.slug}-final`}
              >
                Email CFL Wash Co.
              </Button>
            )
          }
        </div>
      </div>
    </section>
  </main>
</Layout>
