---
import '../styles/global.css'
import { site } from '../data/site'
import Analytics from '../components/site/Analytics.astro'
import Footer from '../components/site/Footer.astro'
import Header from '../components/site/Header.astro'
import MobileStickyCTA from '../components/site/MobileStickyCTA.astro'

type Props = {
  title?: string
  description?: string
  canonicalPath?: string
  noindex?: boolean
  ogImage?: string
  ogImageAlt?: string
}

const defaultOgImage = '/images/brand/og-default.png'
const defaultOgImageAlt = 'CFL Wash Co. logo'

const {
  title = site.title,
  description = site.description,
  canonicalPath = '/',
  noindex = false,
  ogImage = defaultOgImage,
  ogImageAlt = defaultOgImageAlt,
} = Astro.props

const cleanPath =
  canonicalPath === '/'
    ? ''
    : canonicalPath.startsWith('/')
      ? canonicalPath
      : '/' + canonicalPath

const canonicalUrl = site.url + cleanPath
const ogTitle = title
const ogDescription = description
const robotsContent = noindex ? 'noindex, follow' : 'index, follow'
const ogImageUrl = ogImage
  ? ogImage.startsWith('http://') || ogImage.startsWith('https://')
    ? ogImage
    : site.url + (ogImage.startsWith('/') ? ogImage : `/${ogImage}`)
  : undefined
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/images/brand/flow-crest.ico" sizes="any" />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/images/brand/flow-crest-adaptive.svg"
    />
    <link
      rel="icon"
      type="image/png"
      href="/images/brand/flow-crest-32.png"
      sizes="32x32"
    />
    <link
      rel="icon"
      type="image/png"
      href="/images/brand/flow-crest-16.png"
      sizes="16x16"
    />
    <link
      rel="apple-touch-icon"
      href="/images/brand/flow-crest-apple-touch.png"
      sizes="180x180"
    />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0a1b2e" />
    <meta name="format-detection" content="telephone=no" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:width" content="1200" />}
    {ogImageUrl && <meta property="og:image:height" content="630" />}
    {ogImageUrl && <meta property="og:image:alt" content={ogImageAlt} />}

    <meta
      name="twitter:card"
      content={ogImageUrl ? 'summary_large_image' : 'summary'}
    />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    {ogImageUrl && <meta name="twitter:image:alt" content={ogImageAlt} />}
    <slot name="head" />
  </head>

  <body class="bg-[var(--color-page)] text-[var(--color-text)] antialiased">
    <div class="min-h-screen pb-20 sm:pb-0">
      <Header />
      <slot />
      <Footer />
      <MobileStickyCTA />
    </div>
    <Analytics />
  </body>
</html>
